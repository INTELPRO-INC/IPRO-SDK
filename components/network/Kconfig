    bool "SDIO: keep DHCP+ARP on embedded side"
    depends on COMPONENTS_SDIOWIFI_ENABLE
    default y

config IPRO_DUAL_STACK
    bool "Patch lwIP to forward unmatched packets to USB host"
    depends on COMPONENTS_USBWIFI_ENABLE
    default n

endmenu
