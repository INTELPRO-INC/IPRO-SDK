#
# mbedTLS Integration
#
config COMPONENTS_MBEDTLS_ENABLE
    bool "Enable mbedTLS Library"
    default n
    help
      Enable the mbedTLS cryptographic and SSL/TLS library.
      This provides support for secure communication protocols and crypto functions.

config COMPONENTS_CIPHER_SUITE_ENABLE
    bool "Enable Custom Cipher Suite"
    default n
    help
      Enable custom configuration of supported cipher suites.
      Requires mbedTLS to be enabled.

config MBEDTLS_PSA_CRYPTO
    bool "Compile the mbedtls PSA Crypto core (psa_crypto*.c)"
    default n
    depends on COMPONENTS_MBEDTLS_ENABLE

config MBEDTLS_V3
    bool "mbedtls 3.6 instead of 2.28 (PSA apps only)"
    default n
    depends on PSA_SPE || PSA_CLIENT
    help
      The SPE builds components/crypto/mbedtls3 in place of
      components/crypto/mbedtls; the NSPE PSA client takes the 3.6
      headers. SPE and NSPE images must agree.

config TF_PSA_CRYPTO
    bool "TF-PSA-Crypto 1.2 instead of mbedtls (PSA apps only)"
    default n
    depends on (PSA_SPE || PSA_CLIENT) && !MBEDTLS_V3
    help
      The SPE builds components/crypto/tfpsa in place of
      components/crypto/mbedtls; the NSPE PSA client takes the
      TF-PSA-Crypto headers. SPE and NSPE images must agree.

source "components/crypto/nist_sp800_22/Kconfig"

#
# mbedTLS Advanced Configuration
#
if COMPONENTS_MBEDTLS_ENABLE

menu "mbedTLS Configuration"

# You can add additional options here, such as:
# config MBEDTLS_TLS_VERSION
# config MBEDTLS_ENABLE_DEBUG
# config MBEDTLS_MAX_CONTENT_LEN
# config MBEDTLS_CUSTOM_CONFIG_FILE

endmenu

endif  # COMPONENTS_MBEDTLS_ENABLE
