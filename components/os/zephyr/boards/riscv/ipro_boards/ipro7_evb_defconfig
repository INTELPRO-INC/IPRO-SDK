CONFIG_SOC_FAMILY_IPRO=y
CONFIG_SOC_IPRO7=y
CONFIG_BOARD_IPRO7_EVB=y

# Reset vector / entry point - must use __reset for RISC-V with INCLUDE_RESET_VECTOR
CONFIG_KERNEL_ENTRY="__reset"

# Enable FPU
CONFIG_FPU=y
CONFIG_FLOAT_HARD=y

CONFIG_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y
CONFIG_GPIO=y
CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=100000000
