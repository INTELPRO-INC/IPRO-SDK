# ============================================================================
# BLE Stack Configuration
# ============================================================================
# Configuration for ipro_ble_controller + ipro_bt_host (Zephyr 4.4).
# The btblecontroller/blestack stack was removed; see the git tag
# legacy-bt-stack-before-removal.
#
# Categories:
# 1. Controller Variant Selection
# 2. BLE Roles and Connections
# 3. BLE Features
# 4. Host Stack Options
# 5. BLE Mesh Configuration
# 6. Debug and Testing
# ============================================================================

# ============================================================================
# CONTROLLER VARIANT SELECTION
# ============================================================================

menu "Controller Configuration"

    config BT_CTLR_IPRO
        bool "Use ipro_ble_controller (pristine RivieraWaves v14.0.2 + byte-stream HCI)"
        default n
        help
          Build the BLE controller from components/wireless/bluetooth/ipro_ble_controller/
          instead of the removed btblecontroller/.

          ipro_ble_controller keeps the RivieraWaves v14.0.2 sources pristine (upstream/ is
          read-only) and confines all IPRO7-specific code to plf/ipro7/. The
          host/controller boundary is a true H4 byte stream over a shared ring
          buffer, so no RivieraWaves structures or Exchange Memory offsets cross
          it.

          Supported customer-library resource and feature profiles are selected
          below. LE Audio runs in the host; ISO/CIS/BIS capability is selected
          by the controller feature profile.

          When enabled, the Controller Variant choice below is ignored, and the
          host builds src/hci_ipro_ble_ctlr/hci_driver_ipro_ble_ctlr.c instead of
          src/hci_onchip/hci_driver.c.

    config BT_CTLR_BTCTRL2
        bool
        select BT_CTLR_IPRO
        help
          Deprecated compatibility selector. Use BT_CTLR_IPRO.

    choice IPRO_BLE_CTLR_VARIANT
        depends on BT_CTLR_IPRO
        prompt "ipro_ble_controller Library Variant"
        default IPRO_BLE_CTLR_LINK1_PERIPH

        config IPRO_BLE_CTLR_LINK1_PERIPH
            bool "1 Link (Peripheral Only, validated)"

        config IPRO_BLE_CTLR_LINK1
            bool "1 Link (All Roles)"

        config IPRO_BLE_CTLR_LINK2
            bool "2 Links (All Roles)"

        config IPRO_BLE_CTLR_LINK4
            bool "4 Links (All Roles)"
    endchoice

    config IPRO_BLE_CTLR_LIB
        string
        default "link1_periph" if IPRO_BLE_CTLR_LINK1_PERIPH
        default "link1" if IPRO_BLE_CTLR_LINK1
        default "link2" if IPRO_BLE_CTLR_LINK2
        default "link4" if IPRO_BLE_CTLR_LINK4

    choice IPRO_BLE_CTLR_FEATURE_PROFILE
        depends on BT_CTLR_IPRO
        prompt "ipro_ble_controller Feature Profile"
        default IPRO_BLE_CTLR_FEATURE_BT52

        config IPRO_BLE_CTLR_FEATURE_BT52
            bool "Bluetooth 5.2 base (validated low power)"

        config IPRO_BLE_CTLR_FEATURE_BT54_ISO2
            bool "Bluetooth 5.4 + Extended/Periodic Adv + PAwR + 2 ISO streams"
            help
              Enables the controller sources for Bluetooth 5.3 connection
              subrating/channel classification, Bluetooth 5.4 PAwR, PAST,
              CIS, BIS, ISOAL and ISO data over HCI. This profile has separate
              prebuilt archives and must be RF-qualified before production use.
    endchoice

    config IPRO_BLE_CTLR_FEATURE
        string
        default "bt52" if IPRO_BLE_CTLR_FEATURE_BT52
        default "bt54_iso2" if IPRO_BLE_CTLR_FEATURE_BT54_ISO2

    config IPRO_BLE_CTLR_SUBRATING
        bool "Enable IPRO7 Connection Subrating controller implementation"
        depends on BT_CTLR_IPRO && IPRO_BLE_CTLR_FEATURE_BT54_ISO2
        default n
        help
          Build CFG_LE_SUBRATING for the Bluetooth 5.3+ link layer. This
          opt-in implementation is validated separately from the base profile.
          Source build is required; existing prebuilt archives lack this flag.

    config IPRO_BLE_CTLR_CSSA
        bool "Enable IPRO7 BLE 5.4 advertising coding selection"
        depends on BT_CTLR_IPRO && IPRO_BLE_CTLR_FEATURE_BT54_ISO2
        default n
        help
          Build CFG_CSSA in a separate experimental _cssa controller archive.
          Source build is forced until S=2/S=8 radio qualification completes.
          Enable BT_EXT_ADV_CODING_SELECTION separately in the Host.

    config IPRO_BLE_CTLR_FORCE_SOURCE_BUILD
        bool "Force ipro_ble_controller source build"
        depends on BT_CTLR_IPRO
        default n
        help
          Ignore a matching prebuilt archive and compile the controller source.

    config IPRO_BLE_CTLR_CFG_DBG
        bool "Build ipro_ble_controller with RivieraWaves CFG_DBG"
        depends on BT_CTLR_IPRO
        default n
        help
          Keep this disabled for customer-release controller builds unless a
          debug-only workaround or trace run explicitly requires CFG_DBG.
          CFG_DBG maps to RivieraWaves RW_DEBUG/RW_SWDIAG/KE_PROFILING and
          IPRO PLF_DEBUG, so it is a controller behavior/profile selector, not
          just extra log text. Debug applications and diagnostic library
          variants must opt in explicitly.

    config IPRO_BLE_CTLR_TRACE_BUFFERS
        bool "Keep large ipro_ble_controller post-PDS trace buffers"
        depends on BT_CTLR_IPRO
        default n
        help
          Allocate the large in-RAM CCI/VCD diagnostic buffers used while
          debugging post-PDS connection timing. Keep this disabled for normal
          host/profile work and customer-release builds; UART counters remain
          available without these buffers.

    config IPRO_BLE_CTLR_TRACE_DEPTH
        int "Controller diagnostic trace depth"
        depends on IPRO_BLE_CTLR_TRACE_BUFFERS
        range 256 32768
        default 256
        help
          Number of controller trace records retained in PSRAM. Increase this
          only in a dedicated diagnostic application that needs a longer
          CIS/PDS capture; normal customer builds do not allocate the buffer.

    config IPRO_BLE_CTLR_CIS_RXWIN_DIAG_EXTRA_US
        int "Extra CIS RX sync-window margin for diagnostics (us)"
        depends on BT_CTLR_IPRO && IPRO_BLE_CTLR_FEATURE_BT54_ISO2
        default 0
        help
          Adds a fixed diagnostic-only margin to CIS peripheral RX windows.
          Keep this at 0 for functional qualification and customer-release
          builds. Non-zero values are allowed only for RF/timing isolation runs
          where the report explicitly records that RXWIN was widened.

    config IPRO_BLE_CTLR_CIS_DIAG
        bool "Enable ipro_ble_controller CIS UART/PSRAM diagnostics"
        depends on BT_CTLR_IPRO && IPRO_BLE_CTLR_FEATURE_BT54_ISO2
        default n
        help
          Enable verbose CIS RX/ISO counters, UART dumps and retained trace
          buffers used during LE Audio bring-up. Keep disabled for normal
          controller/host qualification and customer-release builds; these
          diagnostics add hot-path work in CIS RX handling and can perturb
          timing-sensitive media tests.

    config IPRO_BLE_CTLR_NATIVE_SLEEP_DEFAULT
        bool "Enable RivieraWaves native BLE-IP deep sleep by default"
        depends on BT_CTLR_IPRO
        default n
        help
          Controls the reset-time PARAM_ID_SLEEP_ENABLE value passed to RWIP
          and the controller runtime native-sleep gate default.

          Leave disabled for the current customer/function baseline: IPRO7
          keeps connections on the active XTAL32M timing domain when the
          application/FreeRTOS policy has not granted low power, and the native
          BLE-IP deep sleep path still requires separate platform validation.
          Bring-up applications may enable this explicitly to qualify the
          sleep-clock and DEEPSL counter path.

    config IPRO_BLE_CTLR_32K_FORCE_RC32K
        bool "Force ipro_ble_controller low-power clock to calibrated RC32K"
        depends on BT_CTLR_IPRO
        default n
        help
          Keep disabled for the default controller policy: the controller first
          qualifies XTAL32K against XTAL32M and falls back to calibrated RC32K
          only when the crystal is absent or outside the allowed 500 ppm limit.

          Enable this in board/application configurations that are known to
          have no XTAL32K populated. The controller then skips the XTAL probe
          and directly selects/calibrates RC32K, reducing long-interval PDS
          validation noise without changing other applications.

    config IPRO_BLE_CTLR_32K_CORRECTED_DRIFT_PPM
        int "Published LPCLK drift after RC32K residual compensation (ppm)"
        depends on BT_CTLR_IPRO
        default 0
        range 0 500
        help
          APP-selected override for PARAM_ID_LPCLK_DRIFT after the platform has
          calibrated RC32K and compensates the signed residual in the BLE
          timebase conversion path.

          Keep 0 for the controller default: publish the measured 32 kHz
          accuracy bound.  RC32K-only products that use platform PDS and have
          verified the compensated wake timing may set a smaller post-
          compensation uncertainty, for example 100 ppm.  This prevents RW from
          opening multi-millisecond RX windows at long connection intervals and
          creating false-sync/CRC failures.

    choice BTBLECONTROLLER_VARIANT
        depends on !BT_CTLR_IPRO && !BTDM_ENABLE
        prompt "Controller Variant"
        default BTBLECONTROLLER_LINK1
        help
          Select the BLE controller variant based on connection requirements.

          All variants use a unified connection pool architecture that supports
          any combination of central and peripheral roles (up to the link limit).
          Higher connection counts use more memory.

          DEPRECATED naming (m0s1/m1s1/m2s1/m4s1/m8s1) has been replaced with
          linkN naming to better reflect the unified architecture.

        config BTBLECONTROLLER_LINK1_PERIPH
            bool "1 Link (Peripheral Only)"
            help
              Minimal configuration: peripheral role only, 1 connection.
              Smallest memory footprint. Suitable for simple beacons,
              sensors, or peripheral-only devices.

              Legacy name: m0s1

        config BTBLECONTROLLER_LINK1
            bool "1 Link (All Roles)"
            help
              Full featured: central + peripheral + observer + broadcaster.
              Single connection with all roles enabled.
              Balanced memory usage for most single-connection applications.

              Legacy name: m1s1

        config BTBLECONTROLLER_LINK2
            bool "2 Links (All Roles)"
            help
              Full featured with 2 simultaneous connections.
              Unified pool supports any role combination (2 central, 2 peripheral,
              or 1 central + 1 peripheral).

              Legacy name: m2s1

        config BTBLECONTROLLER_LINK4
            bool "4 Links (All Roles)"
            help
              Full featured with 4 simultaneous connections.
              Unified pool supports any role combination up to 4 total connections.
              Suitable for gateway or multi-device hub applications.

              Legacy name: m4s1

        config BTBLECONTROLLER_LINK8
            bool "8 Links (All Roles)"
            help
              High connection count: 8 simultaneous connections.
              Unified pool supports any role combination up to 8 total connections.
              Largest memory footprint (64KB EM). Suitable for complex gateway
              or mesh applications with many concurrent devices.

              Legacy name: m8s1

        config BTBLECONTROLLER_UARTHCI
            bool "HCI Controller Only (UART/USB CDC)"
            select BLE_HOST_DISABLE
            help
              Controller-only mode for HCI transport via UART or USB CDC.
              No host stack included. Use with external host (PC, Linux, etc).
              Supports 2 connections, all roles, extended advertising.

    endchoice

    config BTBLECONTROLLER_LIB
        string
        # New linkN naming (maps to actual library names)
        default "link1_periph" if BTBLECONTROLLER_LINK1_PERIPH
        default "link1" if BTBLECONTROLLER_LINK1
        default "link2" if BTBLECONTROLLER_LINK2
        default "link4" if BTBLECONTROLLER_LINK4
        default "link8" if BTBLECONTROLLER_LINK8
        default "uarthci" if BTBLECONTROLLER_UARTHCI
        # Legacy m*s* naming removed - use linkN variants above

    config BTBLECONTROLLER_LE_AUDIO
        bool "LE Audio Support (GAF/CIS/BIS)"
        default n
        depends on !BTBLECONTROLLER_LINK1_PERIPH
        help
          Select prebuilt controller with LE Audio (GAF) support.
          Enables CIS, BIS, and GAF optimizations in the controller.
          Not available for link1_periph (peripheral-only) variant.

    config BTBLECONTROLLER_BT_53
        bool "BLE 5.3 Support"
        default n
        depends on !BTBLECONTROLLER_LINK1_PERIPH
        help
          Select prebuilt controller with BLE 5.3 features.
          Not available for link1_periph (peripheral-only) variant.

    config BTBLECONTROLLER_BT_54
        bool "BLE 5.4 Support"
        default n
        depends on !BTBLECONTROLLER_LINK1_PERIPH
        select BTBLECONTROLLER_BT_53
        help
          Select prebuilt controller with BLE 5.4 features.
          Implies BLE 5.3 support.
          Not available for link1_periph (peripheral-only) variant.

    config BLE_FORCE_SOURCE_BUILD
        bool "Force Controller Source Build (Development)"
        default n
        help
          Force building the BLE controller from source instead of using
          prebuilt libraries. Use this during development when you need to
          modify controller source code (e.g., hci_onchip.c, isoohci, lld).

          When disabled (default), the build system uses prebuilt .a files
          from the variant directory if available, which is faster.

          When enabled, the full controller is compiled from source,
          allowing code changes to take effect.

    config EM_SIZE
        int "Exchange Memory Size (KB)"
        range 16 128
        default 64 if BTBLECONTROLLER_LINK8 || BTBLECONTROLLER_UARTHCI
        default 32
        help
          Size of Exchange Memory for BLE controller data buffering.
          Higher connection counts typically require more EM.

endmenu

# ============================================================================
# BLE ROLES AND CONNECTIONS
# ============================================================================

menu "BLE Roles and Connections"

    config BT_CONN
        int "Maximum Connections"
        range 1 8
        default 1 if BTBLECONTROLLER_LINK1_PERIPH || BTBLECONTROLLER_LINK1
        default 2 if BTBLECONTROLLER_LINK2
        default 4 if BTBLECONTROLLER_LINK4
        default 8 if BTBLECONTROLLER_LINK8
        help
          Maximum number of simultaneous BLE connections.
          Should match the selected controller variant's link capacity.

    config BT_CENTRAL
        bool "Central Role"
        default n if BTBLECONTROLLER_LINK1_PERIPH
        default y
        help
          Enable central (master/scanner) role for initiating connections.
          Not available in link1_periph (peripheral-only) variant.

    config BT_PERIPHERAL
        bool "Peripheral Role"
        default y
        help
          Enable peripheral (slave/advertiser) role.
          Always available in all variants.

    config BT_OBSERVER
        bool "Observer Role"
        default n if BTBLECONTROLLER_LINK1_PERIPH
        default y
        help
          Enable observer role for passive scanning.
          Not available in link1_periph (peripheral-only) variant.

    config BT_BROADCASTER
        bool "Broadcaster Role"
        default y
        help
          Enable broadcaster role for advertising.
          Always available in all variants.

endmenu

