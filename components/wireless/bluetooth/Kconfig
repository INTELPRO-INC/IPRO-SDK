            config BT_TBS_CLIENT_TBS
                bool "Telephone Bearer Service client"
                default n
                help
                  Enable discovery of individual TBS bearer instances.

            config BT_TBS_CLIENT
                bool
                default y if BT_TBS_CLIENT_GTBS || BT_TBS_CLIENT_TBS

            config BT_CCP_CALL_CONTROL_SERVER
                bool "Call Control Profile server"
                default n
                select BT_TBS

            config BT_CCP_CALL_CONTROL_CLIENT
                bool "Call Control Profile client"
                default n
                select BT_TBS_CLIENT_GTBS

        endmenu

        menu "Object Transfer Service (OTS)"

            config BT_OTS
                bool "Object Transfer Service server"
                default n
                help
                  Enable the OTS server and its L2CAP Object Transfer Channel.

            config BT_OTS_CLIENT
                bool "Object Transfer Service client"
                default n
                help
                  Enable the OTS client and GATT discovery support.

            config BT_OTS_DIR_LIST_OBJ
                bool "OTS Directory Listing Object"
                depends on BT_OTS
                default n

            config BT_OTS_MAX_INST_CNT
                int "Maximum OTS server instances"
                depends on BT_OTS
                range 1 1
                default 1

            config BT_OTS_MAX_OBJ_CNT
                hex "Maximum objects per OTS instance"
                depends on BT_OTS || BT_OTS_CLIENT
                range 0x01 0x7fffffff
                default 0x05

            config BT_OTS_L2CAP_CHAN_TX_MTU
                int "OTS Object Transfer Channel TX MTU"
                depends on BT_OTS || BT_OTS_CLIENT
                range 21 65533
                default 256

            config BT_OTS_L2CAP_CHAN_RX_MTU
                int "OTS Object Transfer Channel RX MTU"
                depends on BT_OTS || BT_OTS_CLIENT
                range 21 1021
                default 251

            config BT_OTS_OBJ_MAX_NAME_LEN
                int "Maximum OTS object name length"
                depends on BT_OTS || BT_OTS_CLIENT
                range 1 120
                default 120

        endmenu

        menu "Hearing Access (HAS)"

            config BT_HAS
                bool "Hearing Access Server"
                default n
                help
                  Enable Hearing Access Service Server.

            config BT_HAS_CLIENT
                bool "Hearing Access Client"
                default n
                help
                  Enable Hearing Access Service Client.

        endmenu

        menu "Telephony and Media Audio (TMAP)"

            config BT_TMAP
                bool "TMAP Profile"
                default n
                help
                  Enable Telephony and Media Audio Profile.

            config BT_GMAP
                bool "Gaming Audio Profile"
                default n

            config BT_PBP
                bool "Public Broadcast Profile"
                default n

        endmenu

    endif # BT_AUDIO

endmenu

