menu "BLE Features"

    config ADV_EXTENSION
        bool "Extended Advertising"
        default n if BTBLECONTROLLER_LINK1_PERIPH
        default y
        help
          Enable BLE 5.0 extended advertising features.
          Not available in link1_periph (peripheral-only) variant.

    config CIS
        bool "Connected Isochronous Streams (CIS)"
        default n if BTBLECONTROLLER_LINK1_PERIPH
        default y
        help
          Enable CIS for unicast audio (LE Audio foundation).
          Requires BLE 5.2+ controller support.

    config BIS
        bool "Broadcast Isochronous Streams (BIS)"
        default n if BTBLECONTROLLER_LINK1_PERIPH
        default y
        help
          Enable BIS for broadcast audio (Auracast foundation).
          Requires BLE 5.2+ controller support.

    config LE_PWR_CTRL
        bool "LE Power Control"
        default n if BTBLECONTROLLER_LINK1_PERIPH
        default y
        help
          Enable LE power control for range optimization.
          Not available in link1_periph (peripheral-only) variant.

    config CTE
        bool "Constant Tone Extension (Direction Finding)"
        default n
        help
          Enable CTE for AoA/AoD direction finding.

    config BT_DF
        bool "Host Direction Finding API"
        default n
        depends on BT_HOST_IPRO_V44 && CTE
        help
          Compile the Bluetooth 5.1 Host APIs for CTE configuration and IQ
          reports. Select the connectionless and/or connected roles below.

    if BT_DF

    config BT_DF_CONNECTIONLESS_CTE_RX
        bool "Connectionless CTE receiver"
        default n
        depends on BT_PER_ADV_SYNC

    config BT_DF_CONNECTIONLESS_CTE_TX
        bool "Connectionless CTE transmitter"
        default n
        depends on BT_PER_ADV

    config BT_DF_CONNECTION_CTE_RX
        bool "Connected CTE receiver"
        default n
        depends on BT_CONN

    config BT_DF_CONNECTION_CTE_TX
        bool "Connected CTE transmitter"
        default n
        depends on BT_CONN

    config BT_DF_CONNECTION_CTE_REQ
        bool "Connected CTE request procedure"
        default n
        depends on BT_DF_CONNECTION_CTE_RX

    config BT_DF_CONNECTION_CTE_RSP
        bool "Connected CTE response procedure"
        default n
        depends on BT_DF_CONNECTION_CTE_TX

    config BT_DF_CTE_RX_AOA
        bool "AoA antenna switching during CTE reception"
        default y
        depends on BT_DF_CONNECTIONLESS_CTE_RX || BT_DF_CONNECTION_CTE_RX

    config BT_DF_CTE_TX_AOD
        bool "AoD antenna switching during CTE transmission"
        default y
        depends on BT_DF_CONNECTIONLESS_CTE_TX || BT_DF_CONNECTION_CTE_TX

    endif # BT_DF

    config PHY_UPDATE
        bool "PHY Update"
        default y
        help
          Enable PHY update procedure (1M/2M/Coded PHY).

    config BT_DATA_LEN_UPDATE
        bool "Data Length Extension"
        default n
        help
          Enable BLE 4.2 Data Length Extension.

    config BT_AUTO_DATA_LEN_UPDATE
        bool "Automatically request maximum data length"
        default n
        depends on BT_DATA_LEN_UPDATE

    config BT_HOST_CCM
        bool
        default n

    config BT_EAD
        bool "BLE 5.4 Encrypted Advertising Data library"
        default n
        select BT_HOST_CCM
        help
          Host encryption/authentication of advertising data. Applications
          must provision session keys and IVs securely. This does not enable
          PAwR or distribute keys automatically.

    config BT_SUBRATING
        bool "BLE 5.3 connection subrating Host procedures"
        default n
        depends on BT_CENTRAL || BT_PERIPHERAL
        help
          Enable subrate requests, central defaults and Subrate Change events.
          This enables Host support; the local controller and peer must also
          support Connection Subrating. It does not enable platform PDS.

    config BT_PER_ADV
        bool "Periodic advertiser"
        default n
        depends on BT_EXT_ADV && BT_BROADCASTER

    config BT_PER_ADV_SYNC
        bool "Periodic advertising synchronization"
        default n
        depends on BT_EXT_ADV && BT_OBSERVER

    config BT_PER_ADV_SYNC_MAX
        int "Maximum periodic advertising synchronizations"
        range 1 8
        default 1
        depends on BT_PER_ADV_SYNC

    config BT_PER_ADV_SYNC_BUF_SIZE
        int "Periodic report reassembly buffer size"
        range 0 1650
        default 0
        depends on BT_PER_ADV_SYNC

    config BT_BUF_EVT_DISCARDABLE_SIZE
        int "Discardable HCI event parameter capacity"
        range 43 255
        default 255 if BT_EXT_ADV
        default 43
        help
          Extended advertising reports may use the full 255-byte HCI event
          parameter length. Smaller buffers drop oversized reports safely,
          but cannot provide complete extended-advertising reception.

    config BT_PER_ADV_SYNC_TRANSFER_SENDER
        bool "Periodic Advertising Sync Transfer sender"
        default n
        depends on BT_PER_ADV_SYNC && BT_CENTRAL

    config BT_PER_ADV_SYNC_TRANSFER_RECEIVER
        bool "Periodic Advertising Sync Transfer receiver"
        default n
        depends on BT_PER_ADV_SYNC && BT_PERIPHERAL

    config BT_EATT
        bool "Enhanced ATT bearers"
        default n
        depends on BT_SMP && BT_L2CAP_DYNAMIC_CHANNEL
        help
          Enable parallel ATT transactions over encrypted LE credit-based
          L2CAP channels. The peer must support EATT.

    config BT_EATT_MAX
        int "Maximum EATT bearers per connection"
        range 1 8
        default 3
        depends on BT_EATT

    config BT_EATT_AUTO_CONNECT
        bool "Automatically establish EATT bearers"
        default n
        depends on BT_EATT

endmenu

# ============================================================================
# HOST STACK OPTIONS
# ============================================================================

menu "Host Stack Options"

    config BT_HOST_IPRO_V44
        bool "IPRO unified Zephyr 4.4 Bluetooth host (migration)"
        default n
        depends on !BLE_HOST_DISABLE
        help
          Select the pinned Zephyr v4.4.0 based unified BT + BLE host. The
          legacy hosts remain the default until board qualification completes.

    config BT_EXT_ADV
        bool "Zephyr host extended advertising/scanning API"
        default n
        depends on BT_HOST_IPRO_V44
        help
          Compile Zephyr host support for LE extended advertising and extended
          scanning commands. Keep this separate from the controller
          ADV_EXTENSION capability so an app can use a controller that supports
          extended advertising while still forcing legacy scan/advertise during
          interoperability bring-up.

    config BT_EXT_ADV_CODING_SELECTION
        bool "BLE 5.4 advertising coding selection Host API"
        default n
        depends on BT_HOST_IPRO_V44
        select BT_EXT_ADV
        help
          Enable coded advertising S=2/S=8 selection through the extended
          advertising v2 HCI command when the controller advertises support.
          This enables Host machinery, not controller or RF qualification.

    choice BT_AUTO_PHY_CENTRAL
        prompt "Zephyr host automatic PHY preference for central role"
        default BT_AUTO_PHY_CENTRAL_NONE
        depends on BT_HOST_IPRO_V44 && BT_CENTRAL && PHY_UPDATE
        help
          Select whether the host should automatically initiate a PHY update
          after a central-role connection is established. Keep the default at
          none so baseline connection validation is not coupled to a PHY LLCP;
          apps can still call bt_conn_le_phy_update() or use their own shell
          command when PHY validation is intended.

        config BT_AUTO_PHY_CENTRAL_NONE
            bool "No automatic central PHY update"

        config BT_AUTO_PHY_CENTRAL_1M
            bool "Prefer 1M PHY automatically"

        config BT_AUTO_PHY_CENTRAL_2M
            bool "Prefer 2M PHY automatically"

        config BT_AUTO_PHY_CENTRAL_CODED
            bool "Prefer coded PHY automatically"
    endchoice

    choice BT_AUTO_PHY_PERIPHERAL
        prompt "Zephyr host automatic PHY preference for peripheral role"
        default BT_AUTO_PHY_PERIPHERAL_NONE
        depends on BT_HOST_IPRO_V44 && BT_PERIPHERAL && PHY_UPDATE
        help
          Select whether the host should automatically initiate a PHY update
          after a peripheral-role connection is established. The default is
          none; explicit app policy or shell commands should own PHY changes.

        config BT_AUTO_PHY_PERIPHERAL_NONE
            bool "No automatic peripheral PHY update"

        config BT_AUTO_PHY_PERIPHERAL_1M
            bool "Prefer 1M PHY automatically"

        config BT_AUTO_PHY_PERIPHERAL_2M
            bool "Prefer 2M PHY automatically"

        config BT_AUTO_PHY_PERIPHERAL_CODED
            bool "Prefer coded PHY automatically"
    endchoice

    config IPRO_BT_HOST_HCI_TRACE
        bool "Enable IPRO Zephyr-host HCI trace"
        default n
        depends on BT_HOST_IPRO_V44
        help
          Print selected HCI command, event, ACL/SMP and ISO packet summaries
          at the IPRO H4 adapter boundary. Keep disabled for customer-release,
          performance and power measurements because the UART output can
          perturb timing-sensitive LE Audio and low-power tests.

    config IPRO_BT_HOST_SMP_TRACE
        bool "Enable IPRO Zephyr-host SMP/settings trace"
        default n
        depends on BT_HOST_IPRO_V44 && BT_SMP
        help
          Print pairing, key-storage and address-resolution breadcrumbs used
          while validating bonding with Android. Keep disabled for normal
          release builds.

    config IPRO_BT_HOST_SKIP_SET_PRIVACY_MODE
        bool "Skip LE Set Privacy Mode in IPRO Zephyr host"
        default n
        depends on BT_HOST_IPRO_V44 && BT_SMP
        help
          Work around controllers that expose resolving-list privacy support
          but do not implement HCI LE Set Privacy Mode correctly. This affects
          Android bonding/reconnect behavior and must be recorded in validation
          reports when enabled.

    config BLE_HOST_DISABLE
        bool "Disable Host Stack (Controller-only mode)"
        default n
        help
          Disable the BLE host stack for controller-only mode.
          Use this for HCI transport applications where an external
          host is connected via UART/USB.

    config BT_SMP
        bool "Security Manager Protocol"
        default y
        depends on !BLE_HOST_DISABLE
        help
          Enable SMP for pairing and encryption.

    config BT_BONDABLE
        bool "Allow bonding"
        default y
        depends on BT_SMP

    config BT_FIXED_PASSKEY
        bool "Allow application fixed passkey"
        default n
        depends on BT_SMP

    config BT_SMP_ENFORCE_MITM
        bool "Enforce MITM when local I/O permits authenticated pairing"
        default y
        depends on BT_SMP
        help
          Match the upstream Zephyr Host default. When an application
          registers suitable authentication callbacks, include MITM in the
          local SMP Authentication Requirements instead of silently reducing
          a peer's Level 3/4 request to Just Works.

    config BT_SIGNING
        bool "ATT data signing"
        default y
        depends on BT_SMP

    config BT_ECC
        bool "Secure Connections ECC"
        default y
        depends on BT_SMP
        help
          Enable the IPRO TRNG/TinyCrypt P-256 host implementation used by LE
          Secure Connections and BR/EDR Secure Simple Pairing.

    config BT_PRIVACY
        bool "Host privacy and resolvable private addresses"
        default n
        depends on BT_SMP

    config BT_HOST_RESOLVING
        bool "Resolve private addresses in the Host"
        default y if BT_PRIVACY
        depends on BT_PRIVACY

    config BT_KEYS_OVERWRITE_OLDEST
        bool "Overwrite oldest bond when key storage is full"
        default n
        depends on BT_SMP

    config BT_MAX_PAIRED
        int "Maximum paired devices"
        range 1 16
        default 1
        depends on BT_SMP

