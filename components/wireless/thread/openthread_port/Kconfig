menu "MAC Features"

config OPENTHREAD_MAC_FILTER_ENABLE
    bool "Enable MAC Filter"
    default n
    help
        Enable MAC address filtering

config OPENTHREAD_MAC_HW_RETRANSMIT
    bool "MAC frame retries in the lmac154 hardware (legacy)"
    default n
    help
      By default OpenThread retransmits unacknowledged frames itself, with
      a random delay before each retry, and the lmac154 gets a retry count
      of 0. The hardware retry loop keeps the MAC in its ACK-wait state,
      which drops every frame the peer sends meanwhile; under two-way
      traffic both nodes then lose each other's frames (bench 2026-09-24:
      256 B two-way pings 83-86 % -> 100 %). Set this to go back to
      hardware retries.

config OPENTHREAD_MAC_RETRY_SUCCESS_HISTOGRAM_ENABLE
    bool "Enable MAC Retry Histogram"
    default n
    help
        Enable MAC retry success histogram statistics

config OPENTHREAD_CLI_TCP_ENABLE
    bool "Enable TCP CLI"
    default n
    help
        Enable TCP commands in CLI (requires compatible mbedTLS)

endmenu # MAC Features

endmenu # OpenThread Configuration
