menu "OpenThread Configuration"
    depends on COMPONENTS_THREAD_ENABLE

config OPENTHREAD_LOG_LEVEL
    int "OpenThread Log Level"
    range 0 5
    default 1
    help
        0 = None, 1 = Critical, 2 = Warning, 3 = Note, 4 = Info, 5 = Debug
        Set to 1 (Critical) for production to save ~8-10KB

config OPENTHREAD_NUM_MESSAGE_BUFFERS
    int "Number of message buffers"
    range 16 128
    default 44
    help
        Number of message buffers for OpenThread

config OPENTHREAD_MESSAGE_BUFFER_SIZE
    int "Message buffer size"
    range 64 256
    default 128
    help
        Size of each message buffer in bytes

config OPENTHREAD_6LOWPAN_REASSEMBLY_TIMEOUT
    int "6LoWPAN reassembly timeout between fragments (s)"
    range 1 3
    default 2
    help
        Time a partly reassembled 6LoWPAN datagram waits for its next
        fragment. OpenThread drops it at its 1 s time tick, so the delay a
        datagram survives is this value to this value + 1 s. Thread 1.4.1
        3.3 (Table 3-6 row 5.3) requires 2-4 s for a fragment-to-fragment
        timeout: 2 or 3. The embedding video stream apps use 1 to free a
        stalled reassembly sooner; that is not conformant.

config OPENTHREAD_IP6_MAX_DATAGRAM_LENGTH
    int "Largest IPv6 datagram (bytes)"
    range 1280 2000
    default 1280
    help
        Thread's IPv6 MTU is 1280 (Thread 1.4.1 3.3, Table 3-6 row 4): an
        end device keeps 1280, so it never puts a larger datagram on the
        mesh. Unset, a Wi-Fi border router gets 1700 (room for the MPL
        tunnel around a 1280 B backbone multicast). The embedding video
        stream apps send 1648 B datagrams and set 1700.

config OPENTHREAD_CLI_MAX_LINE_LENGTH
    int "CLI maximum line length"
    range 128 512
    default 256
    help
        Maximum command line length for OpenThread CLI

menu "Network Features"

config OPENTHREAD_MLR_ENABLE
    bool "Multicast Listener Registration client"
    default n
    help
      Register subscribed multicast groups with the Primary Backbone Router.

config OPENTHREAD_IP6_SLAAC_ENABLE
    bool "Enable IPv6 SLAAC"
    default n
    help
        Enable IPv6 Stateless Address Auto-Configuration
        Disable to save ~5-8KB

config OPENTHREAD_TMF_NETDATA_SERVICE_ENABLE
    bool "Enable TMF Network Data Service"
    default y
    help
        Enable Thread Management Framework Network Data Service

endmenu # Network Features

menu "Security Features"

