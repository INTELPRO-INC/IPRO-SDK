config UART_IPRO
	bool "IPRO7 UART driver"
	default y
	depends on DT_HAS_INTELPRO_IPRO_UART_ENABLED
	depends on SERIAL
	select SERIAL_HAS_DRIVER
	select SERIAL_SUPPORT_INTERRUPT
	select SERIAL_SUPPORT_ASYNC
	select DMA if UART_ASYNC_API
	select IPRO_HAL
	select PINCTRL
	help
	  Zephyr UART (polling, interrupt-driven, runtime configure) over the
	  SDK LL UART driver (bsp/drivers/ipro7_soc/std_drv/drv_uart.c).
