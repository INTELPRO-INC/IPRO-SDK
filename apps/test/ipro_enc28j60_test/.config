#
# ENC28J60 SPI Ethernet bring-up test (IPRO7 Arduino board)
#
# SPI0 on GPIO16(MOSI)/17(MISO)/19(SCLK), software CS on GPIO18,
# RST on GPIO14, INT on GPIO15 (polled). Console + shell on UART0
# (GPIO20/21). See README.md for wiring + commands.
#

#
# Hardware platform
#
CONFIG_IPRO7=y
# CONFIG_IPRO6 is not set
CONFIG_CHIP="IPRO7"
CONFIG_CPU_ID="intelpro_ipro7"
CONFIG_CROSS_COMPILE="/opt/toolchain/riscv_ipro7/bin/riscv64-unknown-elf-"
CONFIG_IPRO7_ARDUINO=y

#
# Build / link
#
CONFIG_LINK_FLASH=y
# Arduino board variant selects PSRAM; raw per-app builds must set it
# explicitly (Kconfig `select` is not resolved for a standalone .config).
CONFIG_USE_PSRAM=y

#
# RTOS
#
CONFIG_FREERTOS_SUPPORT=y
CONFIG_COMPONENTS_FREERTOS_ENABLE=y
CONFIG_FREERTOS=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=1024
CONFIG_FREERTOS_ISR_STACKSIZE=2048
CONFIG_FREERTOS_UNICORE=y
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y

#
# Interactive shell (the `enc ...` commands live here)
#
CONFIG_SHELL=y
CONFIG_SHELL_EXEC_THREAD=y
CONFIG_COMPONENTS_NEW_LIBC_ENABLE=y
CONFIG_COMPONENTS_UTILITY_API_ENABLE=y
CONFIG_COMPONENTS_SOFTCRC_ENABLE=y

#
# Logging — UART0 console
#
CONFIG_IPRO_LOG_ENABLE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=4
CONFIG_LOG_COLORS=y
CONFIG_LOG_TIMESTAMP=y
CONFIG_LOG_BUFFER_SIZE=256
CONFIG_LOG_USE_MUTEX=y
CONFIG_LOG_OUTPUT_UART=y

#
# Platform
#
CONFIG_PLATFORM_UART_BAUDRATE=115200
CONFIG_MAIN_TASK_STACK_SIZE=4096

#
# USB CDC console (IPRO7 Arduino board) — printf/log/shell over USB, so no
# UART adapter is needed. A 1200-baud host touch drops into the boot2 USB
# rescue downloader, so firmware can be flashed over the same USB port.
# See apps/turnkey/common/usb_console.c.
#
CONFIG_COMPONENTS_CHERRYUSB_ENABLE=y
CONFIG_CHERRYUSB_DEVICE=y
CONFIG_CHERRYUSB_DEVICE_CDC=y
CONFIG_BOOT_APP_HEADER_ENABLE=y
CONFIG_BOOT_UBOOT_TRIGGER_ENABLE=y
CONFIG_BOOT_UBOOT_TRIGGER_AUTO_CDC_HOOKS=y
