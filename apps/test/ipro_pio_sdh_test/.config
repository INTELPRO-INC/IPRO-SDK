CONFIG_IPRO7=y
CONFIG_CHIP="IPRO7"
CONFIG_CPU_ID="intelpro_ipro7"
CONFIG_EVB=y
CONFIG_BOARD="EVB"

CONFIG_FREERTOS_SUPPORT=y
CONFIG_COMPONENTS_FREERTOS_ENABLE=y
CONFIG_FREERTOS=y
CONFIG_COMPONENTS_FREERTOS_POSIX_ENABLE=y
CONFIG_IPRO_OSAL=y

CONFIG_LINK_FLASH=y
CONFIG_USE_PSRAM=y
CONFIG_EXCEPTION_DUMP=y

CONFIG_SHELL=y
CONFIG_SHELL_EXEC_THREAD=y
CONFIG_COMPONENTS_NEW_LIBC_ENABLE=y
CONFIG_COMPONENTS_UTILITY_API_ENABLE=y
CONFIG_COMPONENTS_SOFTCRC_ENABLE=y

CONFIG_EVFS=y
CONFIG_EVFS_USE_FATFS=y
CONFIG_EVFS_POSIX=y
CONFIG_COMPONENTS_FATFS_ENABLE=y
CONFIG_FATFS_CODE_PAGE_437=y
CONFIG_FATFS_CODE_PAGE_VALUE=437

CONFIG_HAL_PIO_SDH=y
CONFIG_HAL_PIO_SDH_DAT_GAP=0
# 轉板有外部上拉電阻:內部上拉關閉 + 最弱驅動(源端最緩邊緣)。
# 運行時可調:`pio_sdcard pad <drive 0-3> <pull 0|1>`(sticky)。
CONFIG_HAL_PIO_SDH_PAD_DRIVE=0
CONFIG_HAL_PIO_SDH_PULL_NONE=y

# USB CDC console — printf/log/shell over USB, no UART adapter needed.
# A 1200-baud host touch drops into the boot2 USB rescue downloader, so
# firmware can be flashed over the same USB port (uboot_boot2 required).
# (Flip this block off for a UART-console build — verified 2026-07-23 that
# USB runtime does NOT affect PIO SDH timing: rloop failure rates identical.)
CONFIG_COMPONENTS_CHERRYUSB_ENABLE=y
CONFIG_CHERRYUSB_DEVICE=y
CONFIG_CHERRYUSB_DEVICE_CDC=y
CONFIG_BOOT_APP_HEADER_ENABLE=y
CONFIG_BOOT_UBOOT_TRIGGER_ENABLE=y
CONFIG_BOOT_UBOOT_TRIGGER_AUTO_CDC_HOOKS=y

CONFIG_IPRO_LOG_ENABLE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_COLORS=y
CONFIG_LOG_TIMESTAMP=y
CONFIG_LOG_BUFFER_SIZE=256
CONFIG_LOG_USE_MUTEX=y
CONFIG_LOG_OUTPUT_UART=y
