# IPRO SDK Unit Test Project Configuration
# Comprehensive SDK validation framework

# =============================================================================
# Hardware Platform Settings
# =============================================================================
CONFIG_IPRO7=y
CONFIG_CHIP="IPRO7"
CONFIG_CPU_ID="intelpro_ipro7"
CONFIG_EVB=y
CONFIG_BOARD="EVB"

# =============================================================================
# Core System Configuration
# =============================================================================
CONFIG_FREERTOS_SUPPORT=y
CONFIG_COMPONENTS_FREERTOS_ENABLE=y
CONFIG_FREERTOS=y

# Memory Configuration:
# - OCRAM: 256KB on-chip (fast) - Primary heap for tasks/objects
# - PSRAM: 8MB external (slower) - Secondary heap for large buffers
CONFIG_LINK_FLASH=y
# CONFIG_USE_PSRAM is not set

# DMA channel allocator (runtime alloc + non-disruptive channel init)
CONFIG_DMA_CHANNEL_ALLOCATOR=y

# Shell for interactive test execution
CONFIG_SHELL=y

# New libc with platform utilities (provides debug_uart_id_set)
CONFIG_COMPONENTS_NEW_LIBC_ENABLE=y

# Utility API for SDK components
CONFIG_COMPONENTS_UTILITY_API_ENABLE=y

# Software CRC (required by drivers)
CONFIG_COMPONENTS_SOFTCRC_ENABLE=y

# mbedTLS crypto library (available but not required for DIRECT mode tests)
# CONFIG_COMPONENTS_MBEDTLS_ENABLE is not set

# Event system
CONFIG_IPRO_EVENT=y

# BLE controller (link1 = smallest footprint)
# Bluetooth: ipro_ble_controller + ipro_bt_host (Zephyr 4.4).
#
# test_ble_core.c only calls bt_enable, bt_set_name and bt_get_name - all
# standard Zephyr host API - so the move off btblecontroller/blestack is a
# config change, not a port. Mirrors ipro_ble_remote, which is the same shape:
# one connection, peripheral only.
# BLUETOOTH_LE_ENABLE is what pulls components/wireless/bluetooth into the
# build at all; BT_CTLR_IPRO then selects which controller inside it. They are
# not alternatives - both are needed.
CONFIG_BLUETOOTH_LE_ENABLE=y
CONFIG_BT_CTLR_IPRO=y
CONFIG_IPRO_BLE_CTLR_LIB="link1_periph"
CONFIG_IPRO_BLE_CTLR_FEATURE_BT52=y
CONFIG_IPRO_BLE_CTLR_FEATURE="bt52"
# Build the controller from source rather than linking the prebuilt archive.
# The prebuilt carries vendor relocations (R_RISCV_XL_ADDIBNE_BRANCH, type
# 0x3d) in its .debug_loclists/.debug_rnglists, which the binutils shipped
# with GCC 13 rejects outright - the CI toolchain. Every other app on this
# controller already builds from source; this was the only one that did not.
# CONFIG_IPRO_BLE_CTLR_FORCE_SOURCE_BUILD is not set
CONFIG_EM_SIZE=16
CONFIG_BT_HOST_IPRO_V44=y
CONFIG_BT_CONN=1
CONFIG_BT_PERIPHERAL=y
CONFIG_BT_BROADCASTER=y
CONFIG_BT_DEVICE_NAME_DYNAMIC=y
CONFIG_BT_DEVICE_NAME_MAX=28
CONFIG_CFG_NVDS=y
# The new controller logs through ipro_log; without this the link fails on
# ipro_log_write. The old btblecontroller did not use it.
CONFIG_IPRO_LOG_ENABLE=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_BUFFER_SIZE=256
CONFIG_LOG_USE_MUTEX=y
CONFIG_LOG_OUTPUT_UART=y
# NVDS is required by the link1 controller's RAM-mode backend: arch_main.c.o
# references __nvds_start/__nvds_end (provided only when ENABLE_NVDS=y emits the
# .nvds linker section) and bt_nvds_cli_link_anchor (defined in
# blestack/src/cli_cmds/nvds_cli_cmds.c, compiled only under CONFIG_CFG_NVDS).
# Flash-layout builds default ENABLE_NVDS off, so a BLE app must opt in here
# (same as apps/bluetooth/ble/ipro_ble_remote).
CONFIG_ENABLE_NVDS=y
CONFIG_CFG_NVDS=y

# =============================================================================
# Unit Test Framework Configuration
# =============================================================================
CONFIG_UNIT_TEST_FRAMEWORK=y

# =============================================================================
# Test Suites — Software (TEST_GROUP_SW)
# =============================================================================
CONFIG_TEST_UTILS=y
CONFIG_TEST_MEMORY=y
CONFIG_TEST_RTOS=y
CONFIG_TEST_RINGBUF=y
CONFIG_TEST_RBTREE=y
CONFIG_TEST_SOFTCRC=y
CONFIG_TEST_GETOPT=y
CONFIG_TEST_EVENT=y
CONFIG_TEST_BASE64=y
CONFIG_TEST_LIST=y
CONFIG_TEST_HEX=y
CONFIG_TEST_SHA256=y
CONFIG_TEST_RTOS_ADV=y
CONFIG_TEST_MEMP=y
# CONFIG_TEST_MD5 is not set
# CONFIG_TEST_SHA1 is not set
# CONFIG_TEST_HMAC is not set
CONFIG_TEST_DNS=y
CONFIG_TEST_NOTIFIER=y
CONFIG_TEST_BITMAP=y

# =============================================================================
# Test Suites — HAL Hardware (TEST_GROUP_HAL)
# Auto-skip when hardware not detected
# =============================================================================
CONFIG_TEST_HAL_GPIO=y
CONFIG_TEST_HAL_TIMER=y
CONFIG_TEST_HAL_FLASH=y
CONFIG_TEST_HAL_DMA=y
CONFIG_TEST_HAL_WDT=y
CONFIG_TEST_HAL_RTC=y
CONFIG_TEST_HAL_ADC=y

# =============================================================================
# Test Suites — HW Crypto Engine (TEST_GROUP_CRYPTO)
# =============================================================================
CONFIG_TEST_SEC_AES=y
CONFIG_TEST_SEC_HASH=y
CONFIG_TEST_SEC_TRNG=y
# CONFIG_TEST_SEC_GMAC is not set

# =============================================================================
# Test Suites — Bluetooth (TEST_GROUP_BLE)
# =============================================================================
CONFIG_TEST_BLE=y

# =============================================================================
# Test Runner Options
# =============================================================================
CONFIG_TEST_AUTO_RUN=y
CONFIG_TEST_VERBOSE=y
# CONFIG_TEST_STOP_ON_FAIL is not set
