CONFIG_IPRO7=y
CONFIG_CHIP="IPRO7"
CONFIG_CPU_ID="intelpro_ipro7"

# IPRO7AI EVK. Selected explicitly (a raw make does not resolve Kconfig
# `select`, so USE_PSRAM is spelled out rather than inherited).
CONFIG_IPRO7AI_EVK=y
CONFIG_BOARD="IPRO7AI_EVK"
CONFIG_USE_PSRAM=y

CONFIG_FREERTOS_SUPPORT=y
CONFIG_COMPONENTS_FREERTOS_ENABLE=y
CONFIG_FREERTOS=y

CONFIG_LINK_FLASH=y

# KW307 radar driver + PSRAM history ring + q15 analysis
CONFIG_COMPONENTS_RADAR_KW307_ENABLE=y
CONFIG_RADAR_KW307_HISTORY_SECONDS=900

# NMSIS-DSP supplies the q15 FFT the breathing estimate runs on. q15 rather
# than f32 is deliberate: this FreeRTOS port does not save the FPU context.
CONFIG_NMSIS_DSP=y

# USB CDC-ACM console: printf is mirrored to the USB-C port and the shell
# accepts input from it, so the board reports over one cable to a PC.
CONFIG_COMPONENTS_CHERRYUSB_ENABLE=y
CONFIG_CHERRYUSB_DEVICE=y
CONFIG_CHERRYUSB_DEVICE_CDC=y
CONFIG_DEBUG_CONSOLE_USB=y
# This app links no other usbd_event_handler, so usb_console provides it.
CONFIG_DEBUG_CONSOLE_USB_OWN_DISPATCHER=y

CONFIG_SHELL=y
CONFIG_COMPONENTS_NEW_LIBC_ENABLE=y
CONFIG_COMPONENTS_UTILITY_API_ENABLE=y
CONFIG_COMPONENTS_SOFTCRC_ENABLE=y

CONFIG_IPRO_LOG_ENABLE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_COLORS=y
CONFIG_LOG_TIMESTAMP=y
CONFIG_LOG_BUFFER_SIZE=256
CONFIG_LOG_USE_MUTEX=y
CONFIG_LOG_OUTPUT_UART=y
