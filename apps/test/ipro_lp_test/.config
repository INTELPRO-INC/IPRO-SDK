#
# IPRO Low Power Test — No PSRAM, No BLE
#
# Minimal project for testing PDS Level 31 on no-PSRAM boards.
# Shell enabled for interactive control.
#

#
# Hardware Platform Configuration
#
CONFIG_IPRO7=y
CONFIG_CHIP="IPRO7"
CONFIG_CPU_ID="intelpro_ipro7"
CONFIG_CROSS_COMPILE="/opt/toolchain/riscv_ipro7/bin/riscv64-unknown-elf-"
CONFIG_EVB=y

#
# Build Configuration
#
CONFIG_LINK_FLASH=y
CONFIG_PARTITION=y
CONFIG_EASYFLASH4=y

#
# RTOS Configuration
#
CONFIG_FREERTOS_SUPPORT=y
CONFIG_COMPONENTS_FREERTOS_ENABLE=y
CONFIG_FREERTOS=y

#
# System Services
#
CONFIG_SHELL=y
CONFIG_SHELL_EXEC_THREAD=y
CONFIG_IPRO_EVENT=y
CONFIG_COMPONENTS_SOFTCRC_ENABLE=y
CONFIG_COMPONENTS_UTILITY_API_ENABLE=y
CONFIG_COMPONENTS_NEW_LIBC_ENABLE=y

#
# Low Power
#
# IPRO7AI SiP has internal PSRAM die — must init and hybrid-sleep it
# in PDS31. AVDD14 + bgSys MUST stay on to keep PSRAM self-refresh alive;
# turning them off (deep-sleep) causes the chip to draw ~10 mA on wake.
# CONFIG_USE_PSRAM is not set
CONFIG_HAL_LP=y
CONFIG_FREERTOS_IDLE_HOOK=y

#
# IPRO Logging System
#
CONFIG_IPRO_LOG_ENABLE=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_BUFFER_SIZE=256
CONFIG_LOG_USE_MUTEX=y
CONFIG_LOG_OUTPUT_UART=y

#
# Platform UART Configuration
#
CONFIG_PLATFORM_UART_BAUDRATE=115200

#
# Compiler Optimization for Size
#
CONFIG_OPTIMIZATION_LEVEL_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_LEVEL_SIZE=y
