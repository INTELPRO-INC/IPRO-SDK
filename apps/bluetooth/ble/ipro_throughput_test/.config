#
# IPRO Throughput Test Configuration
#

#
# Hardware Platform Configuration
#
CONFIG_IPRO7=y
CONFIG_CHIP="IPRO7"
CONFIG_CPU_ID="intelpro_ipro7"
CONFIG_CROSS_COMPILE="/opt/toolchain/riscv_ipro7/bin/riscv64-unknown-elf-"
CONFIG_EVB=y

#
# Build Configuration
#
CONFIG_LINK_FLASH=y

#
# RTOS Configuration
#
CONFIG_FREERTOS_SUPPORT=y
CONFIG_COMPONENTS_FREERTOS_ENABLE=y
CONFIG_FREERTOS=y

#
# System Services
#
CONFIG_SHELL=y
CONFIG_SHELL_EXEC_THREAD=y
# CONFIG_COMPONENTS_YLOOP_ENABLE is not set
CONFIG_IPRO_EVENT=y

#
# Wireless Configuration
#
CONFIG_BLUETOOTH_LE_ENABLE=y
CONFIG_BT_CTLR_IPRO=y
CONFIG_IPRO_BLE_CTLR_LINK2=y
CONFIG_IPRO_BLE_CTLR_LIB="link2"
CONFIG_IPRO_BLE_CTLR_FEATURE_BT52=y
CONFIG_IPRO_BLE_CTLR_FEATURE="bt52"
CONFIG_BT_HOST_IPRO_V44=y
CONFIG_BT_CENTRAL=y
CONFIG_BT_AUTO_PHY_PERIPHERAL_NONE=y
CONFIG_BT_AUTO_DATA_LEN_UPDATE=y
CONFIG_BT_DATA_LEN_UPDATE=y
CONFIG_BT_GATT_CLIENT=y
CONFIG_BT_SMP=y
CONFIG_BT_OBSERVER=y
CONFIG_BT_BROADCASTER=y
CONFIG_BT_PERIPHERAL=y
CONFIG_BT_CONN=2


# Flash-layout builds default NVDS OFF, but the prebuilt BLE controller
# hard-references __nvds_start/__nvds_end/bt_nvds_cli_link_anchor.
# Without these two the app fails to LINK.
CONFIG_ENABLE_NVDS=y
CONFIG_CFG_NVDS=y

#
# Core System Configuration - Optimized for high throughput
#
CONFIG_EM_SIZE=32
CONFIG_CFG_DBG=y

#
# Basic Parameters - Optimized for throughput with lower RAM usage
#
CONFIG_CFG_CON=4
CONFIG_CFG_ACT=16
CONFIG_CFG_HL_ACT=6
CONFIG_CFG_RAL=3

#
# BLE Roles - Enable both Central and Peripheral
#
CONFIG_CFG_PERIPHERAL=y
CONFIG_CFG_CENTRAL=y
CONFIG_CFG_BROADCASTER=y
CONFIG_CFG_OBSERVER=y

#
# Advertising Features
#
CONFIG_CFG_PER_ADV=y

#
# Bluetooth Version Support
#
CONFIG_CFG_BT_53=y
CONFIG_CFG_BT_54=y

#
# Stack Components
#
CONFIG_CFG_BLE_EMB=y
CONFIG_CFG_BLE_HOST=y
CONFIG_CFG_APP=y

#
# Transport Interfaces
#
# CONFIG_CFG_HCITL=y
# CONFIG_CFG_H4TL=y
CONFIG_CFG_AHITL=y
CONFIG_CFG_HL_MSG_API=y

#
# GATT Client Support (required for service discovery)
#
CONFIG_CFG_GATT_CLI=y
CONFIG_CFG_GATT_MTU_NEGO=y

#
# Security Features
#
CONFIG_CFG_ECC_P256_SUPPORT=y
CONFIG_CFG_SW_AES_CIPHER=y
CONFIG_CFG_SW_AES_DECIPHER=y

#
# Data Length Extension
#
CONFIG_CFG_DLE=y

#
# PHY 2M Support
#
CONFIG_CFG_LE_2M_PHY=y
CONFIG_CFG_LE_CODED_PHY=y

#
# Audio and Isochronous Features (DISABLED for throughput test to save ~24KB RAM)
#
CONFIG_CFG_BLE_GAF=n
CONFIG_CFG_CIS=n
CONFIG_CFG_BIS=n
CONFIG_CFG_ISO_CON=n
CONFIG_CFG_ISOGEN=n
CONFIG_CFG_ISOOHCI=n

#
# GAF Audio Profiles (DISABLED for throughput test)
#
CONFIG_CFG_BAP=n
CONFIG_CFG_BAP_UC_SRV=n
CONFIG_CFG_BAP_UC_CLI=n
CONFIG_CFG_BAP_CAPA_SRV=n
CONFIG_CFG_BAP_CAPA_CLI=n

#
# GAF Core (DISABLED)
#
CONFIG_CFG_GAF_ADV=n
CONFIG_CFG_GAF_SCAN=n
CONFIG_CFG_GAF_CLI=n

#
# RTOS Integration
#
CONFIG_CFG_RTOS=y
CONFIG_CFG_KE_MSG_CALLOC=y

#
# IPRO BLE Library (disabled - using native Zephyr blestack APIs)
#
# CONFIG_IPRO_BLE_LIB is not set

#
# BLE Host TX Buffer Configuration
#
CONFIG_BT_L2CAP_TX_BUF_COUNT=10
CONFIG_BT_CONN_TX_MAX=10

#
# IPRO Log System
#
CONFIG_IPRO_LOG_ENABLE=y
CONFIG_IPRO_LOG_LEVEL_DEBUG=y

#
# Additional Components
#
CONFIG_COMPONENTS_SOFTCRC_ENABLE=y
CONFIG_COMPONENTS_NEW_LIBC_ENABLE=y
CONFIG_COMPONENTS_UTILITY_API_ENABLE=y
CONFIG_EVFS=y
CONFIG_EVFS_POSIX=y
