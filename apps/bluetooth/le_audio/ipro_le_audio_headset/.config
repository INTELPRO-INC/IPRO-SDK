#
# LE Audio Headset - DAC output variant
#
# Decoded LC3 goes to the on-chip DAC and a speaker.  CMakeLists.txt picks
# src/app_dac.c from CONFIG_BSP_USING_DAC; the UAC variant picks src/app_uac.c
# from CONFIG_AUDIO_OUTPUT_UAC instead.  Exactly one of the two may be set -
# they are an if/elseif chain, and app_audio.c compiles a different output
# branch for each.
#
# Switch with:  cp DAC.config .config && make clean && make
#
# IPRO LE Audio Headset Configuration - Zephyr blestack
#

#
# Hardware Platform
#
CONFIG_IPRO7=y
CONFIG_CHIP="IPRO7"
CONFIG_CPU_ID="intelpro_ipro7"
CONFIG_CROSS_COMPILE="/opt/toolchain/riscv_ipro7/bin/riscv64-unknown-elf-"
CONFIG_EVB=y

#
# Build Configuration
#
CONFIG_LINK_FLASH=y
CONFIG_IPRO7_FLASH_2M=y
CONFIG_USE_PSRAM=y
CONFIG_PARTITION=y
CONFIG_EASYFLASH4=y

# DSP for Audio Resampling
CONFIG_NMSIS_DSP=y

#
# RTOS
#
CONFIG_FREERTOS_SUPPORT=y
CONFIG_COMPONENTS_FREERTOS_ENABLE=y
CONFIG_FREERTOS=y

#
# System Services
#
CONFIG_SHELL=y
CONFIG_SHELL_EXEC_THREAD=y
# 921600 confirmed working through the CMSIS-DAP probe's UART bridge.
# The pcmcap dump paces itself from this value (PCMCAP_LINE_MS), so a
# 10 s capture goes from ~90 s on the wire to ~12 s.
CONFIG_PLATFORM_UART_BAUDRATE=115200
CONFIG_MAIN_STACK_SIZE_KB=4
CONFIG_IPRO_BOOT2_PARAM_DIAG=y
CONFIG_IPRO_EVENT=y
CONFIG_COMPONENTS_SOFTCRC_ENABLE=y
CONFIG_COMPONENTS_UTILITY_API_ENABLE=y
CONFIG_COMPONENTS_NEW_LIBC_ENABLE=y

#
# File System
#
CONFIG_EVFS=y
CONFIG_EVFS_POSIX=y

#
# Bluetooth - Zephyr Stack
#
CONFIG_BLUETOOTH_LE_ENABLE=y

# New controller: peripheral ACL + two ISO streams, Bluetooth 5.4 feature set
CONFIG_BT_CTLR_IPRO=y
CONFIG_IPRO_BLE_CTLR_LIB="link1_periph"
CONFIG_IPRO_BLE_CTLR_FEATURE="bt54_iso2"
CONFIG_IPRO_BLE_CTLR_CFG_DBG=y
# CIS diagnostics off while gathering training captures: they print with raw
# printf, outside ipro_log, so they cannot be silenced for the duration of a
# dump and they land in the middle of base64 lines.  Turn back on when
# chasing the ISO deafness.
# CONFIG_IPRO_BLE_CTLR_CIS_DIAG is not set
# Big CIS/connection trace rings OFF.  With this on the ring is 8192 entries
# instead of 256, which is 1,130,496 bytes of ipro_ble_ctlr_cis_trace_entries
# - and because it lands in an orphan .psram_noinit section that the linker
# gives a load address, every one of those bytes is written into the image.
# That alone took the binary from ~700 KB to 1.9 MB, past the 1.15 MB FW
# partition on the board.  256 entries is what the CIS dumps we have been
# reading actually used.
# CONFIG_IPRO_BLE_CTLR_TRACE_BUFFERS is not set

# CIS trace ring depth.  This has to be set explicitly: the component's
# CMakeLists forces IPRO_CIS_TRACE_DEPTH=4096 whenever the symbol is undefined
# (line 66), which bypasses the patch's own "256 unless TRACE_BUFFERS" fallback
# entirely - so turning TRACE_BUFFERS off does not shrink the ring at all.
#
# At 4096 the ring is 4096 x 276 = 1,130,496 bytes, and it lives in an orphan
# .psram_noinit section that the linker gives a load address to, so every byte
# is stored in flash: the image was 1.92 MB against a 1.15 MB FW partition.
# 256 entries is what the CIS dumps we have been reading actually used.
CONFIG_IPRO_BLE_CTLR_TRACE_DEPTH=256
CONFIG_IPRO_LE_AUDIO_CCI_ANALYSIS=y

# Task stacks.  The LE Audio RX path plus GATT/VCP callbacks run on the host RX
# threads, and on RISC-V an ISR borrows whatever task stack it interrupts.  The
# stock 2 KB / 2 KB / 1 KB are the smallest in the system and sit under the
# 4 KB that FreeRTOSConfig.h already calls the LE Audio floor.  These land in
# PSRAM, so the headroom is free.
CONFIG_IPRO_BT_HOST_RX_STACK_SIZE=8192
CONFIG_BT_RX_STACK_SIZE=4096
CONFIG_BT_TX_PROCESSOR_STACK_SIZE=2048
CONFIG_BT_HOST_IPRO_V44=y
# CONFIG_IPRO_LE_AUDIO_NEW_HOST_SMOKE is not set
CONFIG_IPRO_LE_AUDIO_SMOKE_REQUIRE_SECURITY=y
CONFIG_IPRO_LE_AUDIO_SMOKE_INTERACTIVE_PAIRING=y
CONFIG_IPRO_LE_AUDIO_SMOKE_USE_IDENTITY_ADV=y
# CONFIG_IPRO_BT_HOST_HCI_TRACE is not set
CONFIG_IPRO_BT_HOST_SMP_TRACE=y
CONFIG_IPRO_BT_HOST_SKIP_SET_PRIVACY_MODE=y
CONFIG_BT_EXT_ADV=y
CONFIG_EM_SIZE=32

# BLE Roles
CONFIG_BT_CONN=1
CONFIG_BT_PERIPHERAL=y
CONFIG_BT_MAX_CONN=1

# Security Manager Protocol (required for LE Audio pairing)
CONFIG_BT_SMP=y
CONFIG_BT_SETTINGS=y
CONFIG_BT_BONDABLE=y
CONFIG_BT_PRIVACY=y
CONFIG_BT_HOST_RESOLVING=y
CONFIG_BT_MAX_PAIRED=2
CONFIG_BT_KEYS_OVERWRITE_OLDEST=y

# LE Audio Profiles (Phase 2: ENABLED)
# LE Audio profile compile gate: services enabled, physical audio output
# remains disabled until ASCS/PACS/VCP/BAP registration is stable.
CONFIG_BT_AUDIO=y
CONFIG_BT_AUDIO_RX=y
CONFIG_BT_AUDIO_CODEC_CFG_MAX_METADATA_SIZE=16
CONFIG_BT_AUDIO_CODEC_CAP_MAX_METADATA_SIZE=16
# CONFIG_BT_AUDIO_DEBUG_ISO is not set
CONFIG_BT_BAP_UNICAST_SERVER=y
CONFIG_BT_BAP_UNICAST=y
CONFIG_BT_BAP_STREAM=y
CONFIG_BT_VCP_VOL_REND=y
CONFIG_BT_CAP_ACCEPTOR=y
CONFIG_BT_CAP_ACCEPTOR_SET_MEMBER=y
CONFIG_BT_CSIP_SET_MEMBER=y
CONFIG_BT_PAC_SNK=y
CONFIG_BT_PAC_SNK_LOC=y
# CONFIG_BT_PAC_SRC is not set
CONFIG_BT_PACS=y
CONFIG_BT_ASCS=y
CONFIG_BT_ASCS_MAX_ASE_SNK_COUNT=2
CONFIG_BT_ASCS_MAX_ASE_SRC_COUNT=0
CONFIG_BT_ASCS_MAX_ACTIVE_ASES=2

# ISO Channels (Phase 2: ENABLED)
CONFIG_BT_ISO=y
CONFIG_BT_ISO_RX=y
CONFIG_BT_ISO_PERIPHERAL=y
CONFIG_BT_ISO_UNICAST=y
# CONFIG_CIS is not set
CONFIG_BT_ISO_TX_BUF_COUNT=5
CONFIG_BT_ISO_RX_BUF_COUNT=8

# LC3 Codec (will be needed in Phase 3-4)
CONFIG_COMPONENTS_LC3_ENABLE=y

# CONFIG_AUDIO_OUTPUT is not set

#
# Audio Output: UAC (USB Audio Class) for USB capture device
#
# CONFIG_AUDIO_OUTPUT_UAC is not set
# CONFIG_COMPONENTS_CHERRYUSB_ENABLE is not set
# CONFIG_CHERRYUSB_DEVICE is not set
# CONFIG_CHERRYUSB_DEVICE_AUDIO is not set

# IPRO Log System
CONFIG_IPRO_LOG_ENABLE=y

#
# Drivers
#
CONFIG_BSP_USING_GPIO=y
CONFIG_BSP_USING_UART=y
CONFIG_BSP_USING_DMA=y
CONFIG_BSP_USING_DAC=y
# CONFIG_BSP_USING_USB is not set

# NVDS — injected by build_all_prebuilts.sh; reserves a 4 KB
# RAM mirror (.nvds) and compiles nvds.c + btnvds_flash.c
# into the controller so NVDS_SUPPORT=1 is baked into the .a.
CONFIG_ENABLE_NVDS=y
CONFIG_CFG_NVDS=y

# BLE 5.3 / 5.4 PAwR controller paths — injected by
# build_all_prebuilts.sh so the prebuilt accepts the
# LE Set Periodic Advertising Subevent Data HCI command.
CONFIG_CFG_BT_53=y
CONFIG_CFG_BT_54=y
CONFIG_CFG_PER_ADV=y
CONFIG_CFG_PAWR=y
