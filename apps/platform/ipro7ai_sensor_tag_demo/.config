#
# ipro7ai_sensor_tag_demo: the sensors of the IPRO7AI Sensor Tag board over its own USB.
#
CONFIG_IPRO7=y
CONFIG_CHIP="IPRO7"
CONFIG_CPU_ID="intelpro_ipro7"

# The Sensor Tag board uses the IPRO7AI QFN56 pin set of the Arduino-style boards.
CONFIG_IPRO7_ARDUINO=y

CONFIG_FREERTOS_SUPPORT=y
CONFIG_COMPONENTS_FREERTOS_ENABLE=y
CONFIG_FREERTOS=y
CONFIG_COMPONENTS_FREERTOS_POSIX_ENABLE=y
CONFIG_IPRO_OSAL=y

CONFIG_LINK_FLASH=y
CONFIG_USE_PSRAM=y
CONFIG_EXCEPTION_DUMP=y

CONFIG_SHELL=y
CONFIG_SHELL_EXEC_THREAD=y

CONFIG_COMPONENTS_NEW_LIBC_ENABLE=y
CONFIG_COMPONENTS_UTILITY_API_ENABLE=y
CONFIG_COMPONENTS_SOFTCRC_ENABLE=y

#
# USB CDC console: printf, log and shell go over the board's own USB.
# Opening the port at 1200 baud drops into the boot2 USB downloader, so the
# board is flashed again without a probe.
#
CONFIG_COMPONENTS_CHERRYUSB_ENABLE=y
CONFIG_CHERRYUSB_DEVICE=y
CONFIG_CHERRYUSB_DEVICE_CDC=y
CONFIG_BOOT_APP_HEADER_ENABLE=y
CONFIG_BOOT_UBOOT_TRIGGER_ENABLE=y
CONFIG_BOOT_UBOOT_TRIGGER_AUTO_CDC_HOOKS=y

CONFIG_IPRO_LOG_ENABLE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_COLORS=y
CONFIG_LOG_TIMESTAMP=y
CONFIG_LOG_BUFFER_SIZE=256
CONFIG_LOG_USE_MUTEX=y
CONFIG_LOG_OUTPUT_UART=y
