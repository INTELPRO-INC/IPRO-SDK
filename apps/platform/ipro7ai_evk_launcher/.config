# IPRO7AI EVK launcher: camera + LCD + microphone + speaker in one image,
# navigated by hand gestures classified on the NPU (M5Stack-style board demo).
#
# Derived from apps/ai/ipro7ai_evk_rps/.config (AI + camera on the 64 KB
# OCRAM layout) plus the audio output sink the speaker needs. No Bluetooth:
# with AI on, the OCRAM region is 64 KB and the BLE stack alone needs ~67.
CONFIG_IPRO7=y
CONFIG_CHIP="IPRO7"
CONFIG_CPU_ID="intelpro_ipro7"
CONFIG_CROSS_COMPILE="/opt/toolchain/riscv_ipro7/bin/riscv64-unknown-elf-"
CONFIG_IPRO7AI_EVK=y
CONFIG_BOARD="IPRO7AI_EVK"
CONFIG_LINK_FLASH=y
CONFIG_ENABLE_FRAME_POINTER=y
# The NPU activation buffer, the ISP frames, the model's decoded layer tables
# and the voice recording all live in the PSRAM heap. AI_SUPPORT `select`s
# USE_PSRAM in Kconfig, but a raw per-app .config does not resolve `select`.
CONFIG_USE_PSRAM=y
# AI/NPU. CONFIG_AI_CPU_NN_OPS deliberately NOT set (pulls forward_YOLO, which
# needs CONFIG_AI_LEGACY_YOLO symbols); the gesture classifier is all-NPU.
CONFIG_AI_SUPPORT=y
# AI + MM puts the linker on the 64 KB OCRAM layout (ipro7_flash.cmake Case 1).
CONFIG_DISABLE_EM_TCM_RET=y
CONFIG_PLATFORM_UART_BAUDRATE=921600
CONFIG_FREERTOS_SUPPORT=y
CONFIG_COMPONENTS_FREERTOS_ENABLE=y
CONFIG_FREERTOS=y
CONFIG_IPRO_OSAL=y
CONFIG_SHELL=y
CONFIG_SHELL_EXEC_THREAD=y
CONFIG_COMPONENTS_SOFTCRC_ENABLE=y
CONFIG_COMPONENTS_UTILITY_API_ENABLE=y
CONFIG_COMPONENTS_NEW_LIBC_ENABLE=y
CONFIG_IPRO_LOG_ENABLE=y
CONFIG_LOG_BUFFER_SIZE=256
CONFIG_LOG_COLORS=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_OUTPUT_UART=y
CONFIG_LOG_TIMESTAMP=y
CONFIG_LOG_USE_MUTEX=y
CONFIG_FREERTOS_HZ=1000
CONFIG_MAIN_TASK_STACK_SIZE=4096
# Timer service task: 1024 words matches configMINIMAL_STACK_SIZE; the 4096
# default is OCRAM this layout cannot afford.
CONFIG_FREERTOS_TIMER_TASK_STACK_WORDS=1024
# Camera: ISP/DVP (MM domain) + the SC101IOT sensor descriptor and its IQ table.
CONFIG_MM_SUPPORT=y
CONFIG_COMPONENTS_SENSOR_ENABLE=y
# Speaker: components/audio DAC sink. The DMA channel allocator keeps the
# AUADC (mic) and DAC DMAs off the same channel.
CONFIG_AUDIO_OUTPUT=y
CONFIG_DMA_CHANNEL_ALLOCATOR=y
# micro-SD: models load from sd:/models/ when a card is in, the flash mfg
# partition otherwise. FatFS's port layer includes vfs_inode.h, so EVFS has
# to come with it - CONFIG_COMPONENTS_FATFS_ENABLE alone does not build.
CONFIG_EVFS=y
CONFIG_EVFS_USE_FATFS=y
CONFIG_EVFS_POSIX=y
CONFIG_COMPONENTS_FATFS_ENABLE=y
CONFIG_FATFS_CODE_PAGE_437=y
CONFIG_FATFS_CODE_PAGE_VALUE=437
CONFIG_AI_MODEL_FROM_FILE=y
# Board library: panel + gfx, camera pipeline, mic + speaker, SD, bench commands.
CONFIG_COMPONENTS_IPRO7AI_EVK_ENABLE=y
CONFIG_EVK_CAMERA=y
CONFIG_EVK_AUDIO=y
CONFIG_EVK_SDCARD=y
CONFIG_EVK_SHELL=y
