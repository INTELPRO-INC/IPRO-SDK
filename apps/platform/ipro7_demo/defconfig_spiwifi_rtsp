CONFIG_COMPONENTS_CLI_CMD_ENABLE=y
CONFIG_LITTLEFS_CLI=y

# BLE Memory Leak Detection (for debugging buffer overflow)
CONFIG_CFG_MEM_LEAK_DETECT=y
# CONFIG_DEMO_I2S_DMIC is not set
# CONFIG_ESP32_WIFI_AT is not set
CONFIG_DISABLE_SDC_PINMUX=y
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_SPI_INSTANCE=1
CONFIG_ESP_HOSTED_SPI_CLK_HZ=40000000
CONFIG_ESP_HOSTED_SPI_CS_PIN=30
CONFIG_ESP_HOSTED_SPI_CLK_PIN=31
CONFIG_ESP_HOSTED_SPI_MOSI_PIN=28
CONFIG_ESP_HOSTED_SPI_MISO_PIN=29
CONFIG_ESP_HOSTED_HS_PIN=32
CONFIG_ESP_HOSTED_DR_PIN=33
CONFIG_ESP_HOSTED_RESET_PIN=14
CONFIG_ESP_HOSTED_SHELL=y
CONFIG_ESP_HOSTED_NETIF=y
CONFIG_ESP_HOSTED_TX_BUF_SIZE=2048
CONFIG_ESP_HOSTED_NETIF_MTU=1500
CONFIG_ESP_HOSTED_NETIF_NAME="eh"
# CONFIG_DEMO_ESP32_AT is not set
CONFIG_COMPONENTS_PROTOBUF_C_ENABLE=y

# Phase 4: RTSP server (bl_iot_sdk port, Apache 2.0)
CONFIG_RTSP_SERVER=y
CONFIG_RTSP_LISTEN_PORT=8554
CONFIG_RTSP_DEFAULT_VIDEO_FPS=30
CONFIG_RTSP_TASK_STACK_SIZE=4096
CONFIG_RTSP_TEST_SOURCE=y
CONFIG_RTSP_ISP_SOURCE=y
CONFIG_RTSP_SHELL=y
# CONFIG_RTSP_AUTOSTART is not set
