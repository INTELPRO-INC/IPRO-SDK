# Variant A: AI/NPU + camera + display + audio + SD. No Bluetooth.
# Switch with:  cp config_ai .config && make clean && make
# See README - AI and the BLE controller cannot share this SoC's OCRAM.
CONFIG_IPRO7=y
CONFIG_CHIP="IPRO7"
CONFIG_CPU_ID="intelpro_ipro7"
CONFIG_CROSS_COMPILE="/opt/toolchain/riscv_ipro7/bin/riscv64-unknown-elf-"
CONFIG_IPRO7AI_EVK=y
CONFIG_BOARD="IPRO7AI_EVK"
CONFIG_LINK_FLASH=y
CONFIG_ENABLE_FRAME_POINTER=y
CONFIG_USE_PSRAM=y
# AI/NPU. Deliberately NOT setting CONFIG_AI_CPU_NN_OPS: it pulls in
# forward_YOLO, which references symbols that only exist under
# CONFIG_AI_LEGACY_YOLO, and the two have no depends-on. Pure-NPU models
# do not need it and it costs ~24 KB.
CONFIG_AI_SUPPORT=y
CONFIG_DISABLE_EM_TCM_RET=y
CONFIG_PLATFORM_UART_BAUDRATE=115200
CONFIG_FREERTOS_SUPPORT=y
CONFIG_COMPONENTS_FREERTOS_ENABLE=y
CONFIG_FREERTOS=y
CONFIG_IPRO_OSAL=y
CONFIG_SHELL=y
CONFIG_SHELL_EXEC_THREAD=y
CONFIG_COMPONENTS_SOFTCRC_ENABLE=y
CONFIG_COMPONENTS_UTILITY_API_ENABLE=y
CONFIG_COMPONENTS_NEW_LIBC_ENABLE=y
CONFIG_IPRO_LOG_ENABLE=y
CONFIG_LOG_BUFFER_SIZE=256
CONFIG_LOG_COLORS=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_OUTPUT_UART=y
CONFIG_LOG_TIMESTAMP=y
CONFIG_LOG_USE_MUTEX=y
CONFIG_FREERTOS_HZ=1000
CONFIG_MAIN_TASK_STACK_SIZE=4096
CONFIG_MM_SUPPORT=y
CONFIG_COMPONENTS_SENSOR_ENABLE=y
CONFIG_AUDIO_OUTPUT=y
CONFIG_DMA_CHANNEL_ALLOCATOR=y
# SD card. FatFS's port layer includes vfs_inode.h, so EVFS has to come
# with it - CONFIG_COMPONENTS_FATFS_ENABLE alone does not build.
CONFIG_EVFS=y
CONFIG_EVFS_USE_FATFS=y
CONFIG_EVFS_POSIX=y
CONFIG_COMPONENTS_FATFS_ENABLE=y
CONFIG_FATFS_CODE_PAGE_437=y
CONFIG_FATFS_CODE_PAGE_VALUE=437

