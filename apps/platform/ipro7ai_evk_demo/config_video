# Variant C: SD-card video kiosk. No Bluetooth, autoplay one clip, muted.
#
# Derived from config_autoplay by deleting the whole BLE block - controller,
# Zephyr host, LE Audio and the LC3 decoder that only the BAP sink used - plus
# the NVDS/EM/EasyFlash keys that exist solely to serve the controller and the
# host's settings backend. Nothing else moves, so the display, camera, audio
# and SD paths are the ones already proven on config_autoplay.
#
# What this build does at power-on: bring up the panel, then play the pinned
# clip off the card on repeat with the amplifier off.
CONFIG_IPRO7=y
CONFIG_CHIP="IPRO7"
CONFIG_CPU_ID="intelpro_ipro7"
CONFIG_CROSS_COMPILE="/opt/toolchain/riscv_ipro7/bin/riscv64-unknown-elf-"
CONFIG_IPRO7AI_EVK=y
CONFIG_BOARD="IPRO7AI_EVK"
CONFIG_LINK_FLASH=y
CONFIG_ENABLE_FRAME_POINTER=y
CONFIG_USE_PSRAM=y
# AI/NPU off. Nothing in this build reaches the NPU, and leaving it on is not
# free: ipro7_flash.cmake puts an AI+MM build on the 64 KB OCRAM layout
# (Case 1), while AI=n gives the linker the whole 256 KB (Case 3). PSRAM is
# kept - the clip buffer lives there - which is why CONFIG_USE_PSRAM is set
# explicitly above rather than left to AI_SUPPORT's `select`.
# CONFIG_AI_SUPPORT is not set
# CONFIG_DISABLE_EM_TCM_RET is only read on the AI+MM layout, so it is gone too.
CONFIG_PLATFORM_UART_BAUDRATE=115200
CONFIG_FREERTOS_SUPPORT=y
CONFIG_COMPONENTS_FREERTOS_ENABLE=y
CONFIG_FREERTOS=y
CONFIG_IPRO_OSAL=y
CONFIG_SHELL=y
CONFIG_SHELL_EXEC_THREAD=y
CONFIG_COMPONENTS_SOFTCRC_ENABLE=y
CONFIG_COMPONENTS_UTILITY_API_ENABLE=y
CONFIG_COMPONENTS_NEW_LIBC_ENABLE=y
CONFIG_IPRO_LOG_ENABLE=y
CONFIG_LOG_BUFFER_SIZE=256
CONFIG_LOG_COLORS=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_OUTPUT_UART=y
CONFIG_LOG_TIMESTAMP=y
CONFIG_LOG_USE_MUTEX=y
CONFIG_FREERTOS_HZ=1000
CONFIG_MAIN_TASK_STACK_SIZE=4096
CONFIG_MM_SUPPORT=y
CONFIG_COMPONENTS_SENSOR_ENABLE=y
CONFIG_AUDIO_OUTPUT=y
CONFIG_DMA_CHANNEL_ALLOCATOR=y
# SD card. FatFS's port layer includes vfs_inode.h, so EVFS has to come
# with it - CONFIG_COMPONENTS_FATFS_ENABLE alone does not build.
CONFIG_EVFS=y
CONFIG_EVFS_USE_FATFS=y
CONFIG_EVFS_POSIX=y
CONFIG_COMPONENTS_FATFS_ENABLE=y
CONFIG_FATFS_CODE_PAGE_437=y
CONFIG_FATFS_CODE_PAGE_VALUE=437

# --- OCRAM budget: AI + BLE together leave only a 48 KB OCRAM region
# (ipro7_flash.cmake Case 2), so two large consumers are trimmed.
# Timer service task: 4096 words (16 KB) is 4x the IDLE task's size and far
# more than it needs; 1024 words matches configMINIMAL_STACK_SIZE.
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=1024

# Start the SD card watcher at boot: insert a card and it mounts and plays.
# A card already seated at power-on is seen the same way, so this is what
# makes the board play on its own.
CONFIG_EVK_VIDEO_AUTOPLAY=y
# Which clip: unset, so autoplay walks 3,0,1,2,4 and repeats, largest first so
# the one-time PSRAM buffer is claimed at full size. `vid clip <n>` pins it to
# a single clip at runtime, `vid clip all` goes back.
# CONFIG_EVK_VIDEO_CLIP is not set
# Silent playback: the amplifier stays off and the DAC is fed silence rather
# than skipped, because the DAC ring is what paces the frame loop - a player
# that dropped the audio would run the clip at the SPI bus's speed instead of
# its own frame rate. `vid mute off` restores sound.
CONFIG_EVK_VIDEO_MUTE=y
# Do not gate the demo on USB-C being live: this build is meant to come up
# playing on whatever power it is given.
# CONFIG_EVK_WAIT_VBUS is not set
