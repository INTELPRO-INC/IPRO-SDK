# USB-WiFi device (CherryUSB CDC transport) — bridge to RPi ipronet host.
CONFIG_COMPONENTS_CHERRYUSB_ENABLE=y
CONFIG_CHERRYUSB_DEVICE=y
CONFIG_USB_HS=y
CONFIG_CHERRYUSB_DEVICE_CDC=y
# CONFIG_CHERRYUSB_DEVICE_HID is not set
# CONFIG_CHERRYUSB_DEVICE_MSC is not set
CONFIG_COMPONENTS_USBWIFI_ENABLE=y
CONFIG_COMPONENTS_REMOTE_NET_MANAGER_ENABLE=y
CONFIG_COMPONENTS_NET_PKT_FILTER_ENABLE=y
CONFIG_USBWIFI_DHCP_IN_EMB=y

# Run the bring-up the host interface cannot work without (WiFi firmware task,
# then the transport bridge) at boot instead of from the console. Must be stated
# here, not left to the Kconfig default: project.build copies this file verbatim
# to .config, so a symbol absent here never reaches autoconf.h.
CONFIG_IF_WIFI_AUTO_START=y
