CONFIG_IPRO7=y
CONFIG_CHIP="IPRO7"
CONFIG_CPU_ID="intelpro_ipro7"
CONFIG_EVB=y
CONFIG_BOARD="EVB"

CONFIG_FREERTOS_SUPPORT=y
CONFIG_COMPONENTS_FREERTOS_ENABLE=y
CONFIG_FREERTOS=y

CONFIG_LINK_FLASH=y
CONFIG_USE_PSRAM=y

CONFIG_SHELL=y
CONFIG_COMPONENTS_NEW_LIBC_ENABLE=y
CONFIG_COMPONENTS_UTILITY_API_ENABLE=y
CONFIG_COMPONENTS_SOFTCRC_ENABLE=y

# lwIP + ethernet for the ipronet SDIO netif (Phase E). Throughput testing uses
# the SDK's esp_iperf component (standard `iperf` shell cmd over BSD sockets,
# reliable interval report) — the hand-rolled lwiperf/raw-UDP harness was
# removed (PM13d). lwipopts: app override (lwipopts_app.h).
CONFIG_COMPONENTS_LWIP_ENABLE=y
CONFIG_COMPONENTS_LWIP_APP_ENABLE=y
CONFIG_ETHERNET=y

# ipronet_host component (the host flow this app is the example for). Written
# here literally: project.build copies this file verbatim into the build.
CONFIG_COMPONENTS_IPRONET_HOST_ENABLE=y

CONFIG_IPRO_LOG_ENABLE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_COLORS=y
CONFIG_LOG_TIMESTAMP=y
CONFIG_LOG_BUFFER_SIZE=256
CONFIG_LOG_USE_MUTEX=y
CONFIG_LOG_OUTPUT_UART=y
