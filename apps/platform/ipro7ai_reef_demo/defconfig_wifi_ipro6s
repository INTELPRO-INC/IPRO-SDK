# IPRO7AI Reef carrier board demo.
#
# Board support is bsp/board/ipro7/ipro7ai_reef_board_config.h
# (CONFIG_IPRO7AI_REEF). The demo drives every block on the carrier from
# the shell: RGB LED, keys, speaker/headphone, PDM + headset + AUX-IN
# capture, SD slot, camera bus probe and the Wi-Fi fin supply gate.
CONFIG_IPRO7=y
CONFIG_CHIP="IPRO7"
CONFIG_CPU_ID="intelpro_ipro7"
CONFIG_CROSS_COMPILE="/opt/toolchain/riscv_ipro7/bin/riscv64-unknown-elf-"
CONFIG_IPRO7AI_REEF=y
CONFIG_BOARD="IPRO7AI_REEF"

#
# Build Configuration
#
CONFIG_LINK_FLASH=y
CONFIG_PARTITION=y
CONFIG_ENABLE_FRAME_POINTER=y
CONFIG_EXCEPTION_DUMP=y
# Flash region defaults to the 1 MB layout, which fits either in-package part.
# If the fitted IPRO7AI reports JEDEC 0xEF4015 (W25Q16, 2 MB) at boot, add
# CONFIG_IPRO7_FLASH_2M=y to hand the linker the whole part.

#
# Memory Configuration
#
# CONFIG_IPRO7AI_REEF selects USE_PSRAM in Kconfig, but a raw per-app build
# does not apply `select`, so it is set explicitly. No AI in this build: with
# AI off the linker gets the full 256 KB of OCRAM.
CONFIG_USE_PSRAM=y
# The ipronet/lwIP/FreeRTOS data path runs from PSRAM, not flash XIP.
CONFIG_IPRO7_WIFI_HOST_HOTCODE=y
# CONFIG_AI_SUPPORT is not set

#
# Debug UART Configuration
#
CONFIG_PLATFORM_UART_BAUDRATE=115200

#
# RTOS Configuration
#
CONFIG_FREERTOS_SUPPORT=y
CONFIG_COMPONENTS_FREERTOS_ENABLE=y
CONFIG_FREERTOS=y
CONFIG_IPRO_OSAL=y
CONFIG_FREERTOS_HZ=1000
CONFIG_MAIN_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_TIMER_TASK_STACK_WORDS=1024

#
# Shell + logging
#
CONFIG_SHELL=y
CONFIG_SHELL_EXEC_THREAD=y
CONFIG_COMPONENTS_SOFTCRC_ENABLE=y
CONFIG_COMPONENTS_UTILITY_API_ENABLE=y
CONFIG_COMPONENTS_NEW_LIBC_ENABLE=y
CONFIG_IPRO_LOG_ENABLE=y
CONFIG_LOG_BUFFER_SIZE=256
CONFIG_LOG_COLORS=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_OUTPUT_UART=y
CONFIG_LOG_TIMESTAMP=y
CONFIG_LOG_USE_MUTEX=y

#
# Audio: DAC output (speaker + headphone) and AUADC capture (PDM, headset
# mic, AUX-IN). The DMA channel allocator lets capture and playback run at
# the same time (mic loopback) without a hard-coded channel clash.
#
CONFIG_AUDIO_OUTPUT=y
CONFIG_AUDIO_CAPTURE=y
CONFIG_DMA_CHANNEL_ALLOCATOR=y

#
# Camera: the sensor framework with the two OmniVision FLEX-24 drivers, and
# the multimedia (ISP / DVP) blocks they stream into. MM_SUPPORT pulls in the
# ISP firmware components too; the demo does not start their 3A because the
# sensors run their own.
#
CONFIG_MM_SUPPORT=y
CONFIG_COMPONENTS_SENSOR_ENABLE=y
CONFIG_SENSOR_OV5640=y
CONFIG_SENSOR_OV2640=y

#
# SD card on the SDH controller. FatFS's port layer includes vfs_inode.h, so
# EVFS has to come with it - CONFIG_COMPONENTS_FATFS_ENABLE alone does not build.
#
CONFIG_EVFS=y
CONFIG_EVFS_USE_FATFS=y
CONFIG_EVFS_POSIX=y
CONFIG_COMPONENTS_FATFS_ENABLE=y
CONFIG_FATFS_CODE_PAGE_437=y
CONFIG_FATFS_CODE_PAGE_VALUE=437

# Wi-Fi through the IPRO6S_FIN (src/wifi_ipro6s.c) and its dependencies.
CONFIG_WIFI_USE_IPRO6S=y
CONFIG_COMPONENTS_LWIP_ENABLE=y
CONFIG_COMPONENTS_LWIP_APP_ENABLE=y
# CONFIG_COMPONENTS_IPERF_ENABLE is not set
CONFIG_ETHERNET=y
CONFIG_COMPONENTS_IPRONET_HOST_ENABLE=y
# RTSP MJPEG camera stream (src/wifi_rtsp.c, shell rtsp_cam).
CONFIG_RTSP_SERVER=y
CONFIG_RTSP_LISTEN_PORT=8554
CONFIG_RTSP_DEFAULT_VIDEO_FPS=15
CONFIG_RTSP_TASK_STACK_SIZE=4096
# CONFIG_RTSP_TEST_SOURCE is not set
# CONFIG_RTSP_ISP_SOURCE is not set
CONFIG_RTSP_SHELL=y
