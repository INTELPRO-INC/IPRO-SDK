
#
# Hardware Platform Configuration
#
# CONFIG_IPRO7 is not set
CONFIG_IPRO6=y
# CONFIG_IPRO6LE is not set
CONFIG_CHIP="IPRO6"
CONFIG_CPU_ID="intelpro_ipro7"
CONFIG_CROSS_COMPILE="/opt/toolchain/riscv_ipro7/bin/riscv64-unknown-elf-"
# CONFIG_NONE is not set
# CONFIG_FPGA is not set
CONFIG_EVB=y
CONFIG_BOARD="EVB"

#
# Build Configuration
#
CONFIG_LINK_FLASH=y
CONFIG_LINKER_SCRIPT=""
CONFIG_ENABLE_FRAME_POINTER=y
# CONFIG_EXCEPTION_AUTO_REBOOT is not set
# end of Build Configuration

#
# Memory Configuration
#
# CONFIG_USE_PSRAM is not set
# CONFIG_ENABLE_NVDS is not set
# end of Memory Configuration

#
# Hardware Features
#
# CONFIG_MM_SUPPORT is not set
# end of Hardware Features

#
# Debug UART Configuration
#
CONFIG_PLATFORM_UART_BAUDRATE=115200
# end of Debug UART Configuration
CONFIG_USE_ROM_DRIVERS=y
# end of Hardware Platform Configuration

#
# Component Modules
#

#
# RTOS Configuration
#
CONFIG_FREERTOS_SUPPORT=y
CONFIG_COMPONENTS_FREERTOS_ENABLE=y
CONFIG_FREERTOS=y
# CONFIG_ZEPHYR is not set
# CONFIG_NO_RTOS is not set

#
# FreeRTOS Configuration
#
# CONFIG_COMPONENTS_FREERTOS_POSIX_ENABLE is not set
# end of FreeRTOS Configuration

CONFIG_IPRO_OSAL=y
# end of RTOS Configuration

#
# System Services
#
CONFIG_SHELL=y
CONFIG_SHELL_EXEC_THREAD=y
CONFIG_CMD_SCHEDULER=y
# CONFIG_COMPONENTS_CLI_CMD_ENABLE is not set
# CONFIG_IPRO_EVENT is not set
# end of System Services

#
# Wireless Configuration
#
CONFIG_BLUETOOTH_LE_ENABLE=y
CONFIG_BT_CONN=2
CONFIG_BT_CENTRAL=y
CONFIG_BT_PERIPHERAL=y
CONFIG_BT_BROADCASTER=y
CONFIG_PHY_UPDATE=y
CONFIG_BT_AUTO_PHY_PERIPHERAL_NONE=y
CONFIG_BT_DATA_LEN_UPDATE=y
CONFIG_BT_AUTO_DATA_LEN_UPDATE=y
# CONFIG_BLE_HOST_DISABLE is not set
CONFIG_BT_HOST_IPRO_V44=y
# CONFIG_BT_CTLR_IPRO is not set
# CONFIG_BTBLECONTROLLER_IPRO6_DUALMODE is not set
CONFIG_BTBLECONTROLLER_LIB="link1"
CONFIG_BT_BREDR=y
CONFIG_BT_MAX_SCO_CONN=1
CONFIG_BT_L2CAP_DYNAMIC_CHANNEL=y
CONFIG_BT_L2CAP_CONN_RTX_TIMEOUT=40
CONFIG_BT_RFCOMM=y
CONFIG_BT_AVDTP=y
CONFIG_BT_A2DP=y
# CONFIG_BT_A2DP_SOURCE is not set
CONFIG_BT_A2DP_SINK=y
CONFIG_BT_A2DP_SBC_CODEC=y
CONFIG_LIBSBC=y
CONFIG_BT_AVRCP=y
CONFIG_BT_AVRCP_CONTROLLER=y
CONFIG_BT_AVRCP_TARGET=y
# CONFIG_BT_AVRCP_BROWSING is not set
CONFIG_BT_HFP=y
CONFIG_BT_HFP_HF=y
# CONFIG_BT_HFP_AG is not set
CONFIG_BT_STACK_CLI=0
CONFIG_BT_SMP=y
# CONFIG_DISABLE_BT_SMP is not set
CONFIG_BT_SIGNING=y
CONFIG_BT_BONDABLE=y
CONFIG_BT_SETTINGS=y
CONFIG_BT_MAX_PAIRED=4
CONFIG_BT_ECC=y
# CONFIG_WIFI6 is not set
CONFIG_PHY_CLI=y
CONFIG_BTDM_ENABLE=y
CONFIG_BTDM_BLE_ENABLE=y
CONFIG_BTDM_BT_ENABLE=y
# CONFIG_BTDM_EM_SIZE_64K is not set
# CONFIG_BTDM_CLOCK_320_80_TEST is not set
# CONFIG_BTDM_CLOCK_320_160_TEST is not set
# CONFIG_BTDM_CLOCK_240_120_TEST is not set
CONFIG_BTDM_MAX_BR_ACL_CONNECTIONS=1
CONFIG_BTDM_MAX_SCO_CONNECTIONS=1
CONFIG_BTDM_VOICE_OVER_HCI=y
CONFIG_DMA_CHANNEL_ALLOCATOR=y
CONFIG_BTDM_MAX_ACL_CONNECTIONS=4
CONFIG_BTDM_MAX_ADV_SETS=2
CONFIG_BTDM_MAX_SCAN_SETS=1
CONFIG_BTDM_TX_PWR_DBM=0
# CONFIG_BTDM_SLEEP_ENABLE is not set
# CONFIG_BTDM_HCI_UART is not set
CONFIG_BTDM_DEBUG=y
# CONFIG_BTDM_DEBUG_VERBOSE is not set
CONFIG_BTDM_CCI_DIAG=y
# CONFIG_BTDM_H4_SELFTEST is not set
CONFIG_BTDM_HOST_BRINGUP=y
CONFIG_BTDM_HOST_LE_ADV=y
# CONFIG_BTDM_HOST_LE_ADV_DEFAULT_ON is not set
CONFIG_BTDM_SINGLE_BR_LINK_RADIO_POLICY=y
CONFIG_BT_DEVICE_NAME="IPRO6S-BTDM"
CONFIG_BT_COD=0x240404
# CONFIG_IPRO6_CLASSIC_BRINGUP is not set
# CONFIG_BTDM_FPGA is not set
# CONFIG_LPAPP is not set
# CONFIG_ZIGBEE_STACK is not set
# CONFIG_LOWER_MAC_15P4_LIB is not set
# CONFIG_IEEE802154_ENABLE is not set
# CONFIG_OPENTHREAD_ENABLE is not set
# end of Wireless Configuration

#
# AI/NPU Configuration
#
# CONFIG_AI_SUPPORT is not set
# end of AI/NPU Configuration

#
# Third-Party Components
#
# CONFIG_COMPONENTS_OPUS_ENABLE is not set
# CONFIG_COMPONENTS_XZ_ENABLE is not set
CONFIG_COMPONENTS_ZMODEM_ENABLE=y
# CONFIG_COMPONENTS_IPERF_ENABLE is not set
# end of Third-Party Components

CONFIG_COMPONENTS_CHERRYUSB_ENABLE=y
CONFIG_CHERRYUSB_DEVICE=y
CONFIG_USB_HS=y
CONFIG_CHERRYUSB_DEVICE_CDC=y
CONFIG_DEBUG_CONSOLE_USB=y
# CONFIG_DEBUG_CONSOLE_USB_OWN_DISPATCHER is not set
# CONFIG_COMPONENTS_MBEDTLS_ENABLE is not set
# CONFIG_COMPONENTS_CIPHER_SUITE_ENABLE is not set
# CONFIG_COMPONENTS_NIST_SP800_22_ENABLE is not set

#
# File System Configuration
#
CONFIG_EASYFLASH4=y
# CONFIG_EASYFLASH4_CLI is not set
CONFIG_EASYFLASH4_FIXED_PARTITION=y
CONFIG_EASYFLASH4_FIXED_PARTITION_OFFSET=0x3E9000
CONFIG_EASYFLASH4_FIXED_PARTITION_SIZE=0x8000
# CONFIG_EVFS is not set
# CONFIG_COMPONENTS_FATFS_ENABLE is not set
# CONFIG_COMPONENTS_ROMFS_ENABLE is not set
# end of File System Configuration

CONFIG_COMPONENTS_NEW_LIBC_ENABLE=y

#
# Network Configuration
#
# CONFIG_COMPONENTS_LWIP_ENABLE is not set
# end of Network Configuration

# CONFIG_COMPONENTS_SENSOR_ENABLE is not set
CONFIG_COMPONENTS_SOFTCRC_ENABLE=y
CONFIG_COMPONENTS_UTILITY_API_ENABLE=y

#
# IPRO Logging System
#
CONFIG_IPRO_LOG_ENABLE=y
# CONFIG_LOG_DEFAULT_LEVEL_NONE is not set
# CONFIG_LOG_DEFAULT_LEVEL_ERROR is not set
# CONFIG_LOG_DEFAULT_LEVEL_WARN is not set
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# CONFIG_LOG_DEFAULT_LEVEL_DEBUG is not set
# CONFIG_LOG_DEFAULT_LEVEL_VERBOSE is not set
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_COLORS=y
CONFIG_LOG_TIMESTAMP=y
CONFIG_LOG_THREAD_ID=y
CONFIG_LOG_BUFFER_SIZE=512
CONFIG_LOG_USE_MUTEX=y
CONFIG_LOG_OUTPUT_UART=y
# CONFIG_LOG_OUTPUT_RTT is not set
# CONFIG_LOG_OUTPUT_FILE is not set
# end of IPRO Logging System
# end of Component Modules
