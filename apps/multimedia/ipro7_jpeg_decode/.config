# ipro7_jpeg_decode: JPEG -> RGB565 / RGB888 with the software decoder (IPRO7AI EVK, 8 MB PSRAM).
# Reef: make DEFCONFIG=defconfig_reef
CONFIG_IPRO7=y
CONFIG_CHIP="IPRO7"
CONFIG_CPU_ID="intelpro_ipro7"
CONFIG_IPRO7AI_EVK=y
CONFIG_BOARD="IPRO7AI_EVK"
CONFIG_LINK_FLASH=y
CONFIG_USE_PSRAM=y
CONFIG_FREERTOS_SUPPORT=y
CONFIG_COMPONENTS_FREERTOS_ENABLE=y
CONFIG_FREERTOS=y
CONFIG_SHELL=y
CONFIG_SHELL_EXEC_THREAD=y
CONFIG_PLATFORM_UART_BAUDRATE=921600
CONFIG_COMPONENTS_NEW_LIBC_ENABLE=y
CONFIG_COMPONENTS_UTILITY_API_ENABLE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPONENTS_SOFTCRC_ENABLE=y
