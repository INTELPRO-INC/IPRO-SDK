# IPRO7AI Reef + IPRO6S_FIN Wi-Fi (make BOARD=reef)
#
# Board support: bsp/board/ipro7/ipro7ai_reef_board_config.h (CONFIG_IPRO7AI_REEF).
# Network: the IPRO6S_FIN in the card slot, an SDIO slave on GPIO28-33 running
# apps/platform/ipro6_if_wifi (defconfig_ipro6_sdio); host side is
# components/network/ipronet_host (src/network_wifi_ipro6s.c). JP3 on 2-3 so
# GPIO14 can power-cycle the fin at every bring-up.
# Audio: MSM261 PDM mic GPIO16/17 (left slot), DAC GPIO23 -> PAM8302A with
# SPK_EN GPIO25 active high. No LCD on this board.

# Hardware Platform Configuration
CONFIG_AGENT_MONK=y
CONFIG_IPRO7=y
CONFIG_CHIP="IPRO7"
CONFIG_CPU_ID="intelpro_ipro7"
CONFIG_CROSS_COMPILE="/opt/toolchain/riscv_ipro7/bin/riscv64-unknown-elf-"
CONFIG_IPRO7AI_REEF=y
CONFIG_BOARD="IPRO7AI_REEF"
# CONFIG_FPGA is not set

# In-package 2 MB flash (W25Q16). Not CONFIG_DISABLE_SDC_PINMUX: that is the
# external-SF3 path and would take GPIO28-33 away from the fin.
CONFIG_IPRO7_FLASH_2M=y

# Memory Configuration
# CONFIG_IPRO7AI_REEF selects USE_PSRAM in Kconfig, but a raw per-app build
# does not apply `select`, so it is set explicitly.
CONFIG_USE_PSRAM=y
CONFIG_LINK_FLASH=y
# CONFIG_ENABLE_NVDS is not set

# RTOS Configuration
CONFIG_FREERTOS_SUPPORT=y
CONFIG_COMPONENTS_FREERTOS_ENABLE=y
CONFIG_FREERTOS=y
# CONFIG_ZEPHYR is not set
# CONFIG_NO_RTOS is not set

# POSIX / OSAL
CONFIG_COMPONENTS_FREERTOS_POSIX_ENABLE=y
CONFIG_IPRO_OSAL=y

# Network Configuration
CONFIG_COMPONENTS_LWIP_ENABLE=y
CONFIG_LWIP=y
CONFIG_LWIP_SUPPORT=y
CONFIG_LWIP_SOCKET=y
CONFIG_LWIP_POSIX_SOCKETS_IO_NAMES=y
CONFIG_LWIP_ALTCP=y

# Network: IPRO6S_FIN over SDIO. CONFIG_ETHERNET only selects the
# CFG_ETHERNET_ENABLE lwipopts branch (1600-byte pool pbufs for full frames);
# there is no EMAC on this board.
CONFIG_ETHERNET=y
CONFIG_COMPONENTS_IPRONET_HOST_ENABLE=y
CONFIG_NETWORK_USE_WIFI_IPRO6S=y
# Default STA credentials; `wifi_set <ssid> <psk>` on the shell stores others in EasyFlash.
# Wi-Fi comes from the phone app over BLE or the `wifi_set` shell command; no credentials in git
CONFIG_WIFI_STA_SSID=""
CONFIG_WIFI_STA_PSK=""
# CONFIG_LTE_MODEM is not set
# CONFIG_AT_CLIENT is not set

# BLE provisioning on the on-chip controller (peripheral + broadcaster only).
# Only the first boot uses it: once bound, app_ble_prov skips BLE entirely.
CONFIG_BLUETOOTH_LE_ENABLE=y
CONFIG_BT_CTLR_IPRO=y
CONFIG_IPRO_BLE_CTLR_LINK1_PERIPH=y
CONFIG_IPRO_BLE_CTLR_LIB="link1_periph"
CONFIG_IPRO_BLE_CTLR_FEATURE_BT52=y
CONFIG_IPRO_BLE_CTLR_FEATURE="bt52"
CONFIG_EM_SIZE=16
# CONFIG_IPRO_BLE_CTLR_FORCE_SOURCE_BUILD is not set
# CONFIG_IPRO_BLE_CTLR_CFG_DBG is not set
CONFIG_BT_HOST_IPRO_V44=y
CONFIG_BT_CONN=1
# CONFIG_BT_CENTRAL is not set
CONFIG_BT_PERIPHERAL=y
CONFIG_BT_BROADCASTER=y
CONFIG_BT_L2CAP_TX_BUF_COUNT=6
CONFIG_BT_CONN_TX_MAX=6
CONFIG_BT_DEVICE_NAME="RY"
# The provisioning protocol parses, logs and answers inside the GATT write
# callback, i.e. on the BT RX work queue. Its 2 KB default (a static stack:
# overflow corrupts .bss silently) hung the board on the phone's first write.
CONFIG_BT_RX_STACK_SIZE=4096
# CONFIG_BT_GATT_CLIENT is not set
# CONFIG_BT_STACK_CLI is not set
# CONFIG_BT_DIS_SERVER is not set
# CONFIG_BT_DEBUG is not set

# No panel on the Reef (BOARD_HAS_LCD 0).
# CONFIG_APP_LCD_ENABLE is not set
# CONFIG_COMPONENTS_LVGL_ENABLE is not set

# Persistent Storage (for bind state and Wi-Fi credentials)
CONFIG_PARTITION=y
CONFIG_EASYFLASH4=y

# Agora SDK
CONFIG_AOSL_ENABLE=y
CONFIG_COMPONENTS_AGORA_ENABLE=y

# Opus codec (used for manual encode/decode with Agora AUDIO_CODEC_DISABLED)
CONFIG_COMPONENTS_OPUS_ENABLE=y

# mbedTLS — minimal TLS 1.2 client for HTTPS API calls
CONFIG_COMPONENTS_MBEDTLS_ENABLE=y

# System Services
CONFIG_SHELL=y
CONFIG_IPRO_EVENT=y
CONFIG_COMPONENTS_SOFTCRC_ENABLE=y
CONFIG_COMPONENTS_UTILITY_API_ENABLE=y
CONFIG_COMPONENTS_NEW_LIBC_ENABLE=y

# Logging
CONFIG_IPRO_LOG_ENABLE=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_COLORS=y
CONFIG_LOG_TIMESTAMP=y
CONFIG_LOG_THREAD_ID=y
CONFIG_LOG_BUFFER_SIZE=512
CONFIG_PRINTF_ENABLE=y
CONFIG_CONSOLE_ENABLE=y

# Platform UART: 115200 like every other Reef image (the debug probe's
# UART bridge and the bench scripts assume it).
CONFIG_PLATFORM_UART_BAUDRATE=115200

# USB CDC ACM disabled (not needed for this app)
# CONFIG_COMPONENTS_CHERRYUSB_ENABLE is not set
