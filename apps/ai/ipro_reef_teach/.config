#
# IPRO7AI Reef Teach: image Teach (USB camera + classifier), voiceprints and
# Sensor Teach in one firmware, one at a time (main.c): the union of the three
# tools' configurations (image/, voice/, sensor/); CONFIG_SINGLE_PRECISION_FLOAT is left out so
# the sensor front end stays equal to IPRO AI Studio's (CMakeLists.txt gives
# -fsingle-precision-constant to the camera sources only). Flash with
# partition_reef_teach.toml (README.md).
#
CONFIG_AI_CPU_NN_OPS=y
CONFIG_AI_LEGACY_POSTPROCESS=y
CONFIG_AI_LEGACY_YOLO=y
CONFIG_AI_SPK_EMBEDDING_DIM=192
CONFIG_AI_SUPPORT=y
CONFIG_AUDIO_CAPTURE=y
CONFIG_BOARD="IPRO7AI_REEF"
CONFIG_CHERRYUSB_DEVICE=y
CONFIG_CHERRYUSB_DEVICE_CDC=y
CONFIG_CHERRYUSB_DEVICE_VIDEO=y
CONFIG_CHIP="IPRO7"
CONFIG_CMD_SCHEDULER=y
CONFIG_COMPONENTS_CHERRYUSB_ENABLE=y
CONFIG_COMPONENTS_FREERTOS_ENABLE=y
CONFIG_COMPONENTS_FREERTOS_POSIX_ENABLE=y
CONFIG_COMPONENTS_NEW_LIBC_ENABLE=y
CONFIG_COMPONENTS_SENSOR_ENABLE=y
CONFIG_COMPONENTS_SOFTCRC_ENABLE=y
CONFIG_COMPONENTS_UTILITY_API_ENABLE=y
CONFIG_CPU_ID="intelpro_ipro7"
CONFIG_CROSS_COMPILE="/opt/toolchain/riscv_ipro7/bin/riscv64-unknown-elf-"
CONFIG_DISABLE_EM_TCM_RET=y
CONFIG_ENABLE_FRAME_POINTER=y
CONFIG_EXCEPTION_DUMP=y
CONFIG_FREERTOS=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_SUPPORT=y
CONFIG_FREERTOS_TIMER_TASK_STACK_WORDS=1024
CONFIG_IPRO7=y
CONFIG_IPRO7AI_REEF=y
CONFIG_IPRO7_FLASH_2M=y
CONFIG_IPRO_EVENT=y
CONFIG_IPRO_EVENT_DEFAULT_QUEUE_SIZE=32
CONFIG_IPRO_EVENT_DEFAULT_TASK_PRIORITY=5
CONFIG_IPRO_EVENT_DEFAULT_TASK_STACK=2048
CONFIG_IPRO_EVENT_POST_FROM_ISR=y
CONFIG_IPRO_LOG_ENABLE=y
CONFIG_IPRO_OSAL=y
CONFIG_LINK_FLASH=y
CONFIG_LOG_BUFFER_SIZE=512
CONFIG_LOG_COLORS=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_OUTPUT_UART=y
CONFIG_LOG_THREAD_ID=y
CONFIG_LOG_TIMESTAMP=y
CONFIG_LOG_USE_MUTEX=y
CONFIG_MAIN_TASK_STACK_SIZE=4096
CONFIG_MM_SUPPORT=y
CONFIG_PARTITION=y
CONFIG_PLATFORM_UART_BAUDRATE=115200
CONFIG_SENSOR_OV5640=y
CONFIG_SHELL=y
# AON watchdog fed from a top-priority task: restarts the SoC if an NPU stall stops it
CONFIG_APP_WATCHDOG=y
CONFIG_APP_WATCHDOG_TIMEOUT_S=8
CONFIG_SHELL_EXEC_THREAD=y
CONFIG_USE_PSRAM=y
CONFIG_UVC_TEACH=y
