# IPRO7AI EVK person detection: SC101IOT camera -> ISP -> NPU (YOLOv8) with
# the live preview and bounding boxes on the ST7789P3 LCD.
#
# Derived from apps/platform/ipro7ai_evk_demo/config_ai with the audio, SD
# card and FatFS blocks removed - nothing here touches them, and every
# component left out is OCRAM the 64 KB AI+MM layout does not have to spare.
CONFIG_IPRO7=y
CONFIG_CHIP="IPRO7"
CONFIG_CPU_ID="intelpro_ipro7"
CONFIG_CROSS_COMPILE="/opt/toolchain/riscv_ipro7/bin/riscv64-unknown-elf-"
CONFIG_IPRO7AI_EVK=y
CONFIG_BOARD="IPRO7AI_EVK"
CONFIG_LINK_FLASH=y
CONFIG_ENABLE_FRAME_POINTER=y
# The NPU activation buffer, the ISP frames and the model's decoded layer
# tables all live in the PSRAM heap. AI_SUPPORT `select`s USE_PSRAM in Kconfig,
# but a raw per-app .config does not resolve `select`, so it is set explicitly.
CONFIG_USE_PSRAM=y
# AI/NPU. CONFIG_AI_CPU_NN_OPS is deliberately NOT set: it pulls in forward_YOLO,
# which references symbols that only exist under CONFIG_AI_LEGACY_YOLO, and the
# two have no depends-on. person_pet_detect runs entirely on the NPU.
CONFIG_AI_SUPPORT=y
# AI + MM puts the linker on the 64 KB OCRAM layout (ipro7_flash.cmake Case 1).
# Merging the TCM code into that region rather than a separate em_tcm_ret
# window is what config_ai proved fits.
CONFIG_DISABLE_EM_TCM_RET=y
CONFIG_PLATFORM_UART_BAUDRATE=115200
CONFIG_FREERTOS_SUPPORT=y
CONFIG_COMPONENTS_FREERTOS_ENABLE=y
CONFIG_FREERTOS=y
CONFIG_IPRO_OSAL=y
CONFIG_SHELL=y
CONFIG_SHELL_EXEC_THREAD=y
CONFIG_COMPONENTS_SOFTCRC_ENABLE=y
CONFIG_COMPONENTS_UTILITY_API_ENABLE=y
CONFIG_COMPONENTS_NEW_LIBC_ENABLE=y
CONFIG_IPRO_LOG_ENABLE=y
CONFIG_LOG_BUFFER_SIZE=256
CONFIG_LOG_COLORS=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_OUTPUT_UART=y
CONFIG_LOG_TIMESTAMP=y
CONFIG_LOG_USE_MUTEX=y
CONFIG_FREERTOS_HZ=1000
CONFIG_MAIN_TASK_STACK_SIZE=4096
# Timer service task: 1024 words matches configMINIMAL_STACK_SIZE; the 4096
# default is OCRAM this layout cannot afford.
CONFIG_FREERTOS_TIMER_TASK_STACK_WORDS=1024
# Camera: ISP/DVP (MM domain) + the SC101IOT sensor descriptor and its IQ table.
CONFIG_MM_SUPPORT=y
CONFIG_COMPONENTS_SENSOR_ENABLE=y
# Board library: ST7789P3 panel + gfx, and the camera -> ISP -> preview/NPU
# pipeline (evk_cam). The app keeps its own `cam`/`lcd` shell commands, so
# CONFIG_EVK_SHELL stays off.
CONFIG_COMPONENTS_IPRO7AI_EVK_ENABLE=y
CONFIG_EVK_CAMERA=y
