
#
# Hardware Platform Configuration
#
CONFIG_IPRO7=y
CONFIG_CHIP="IPRO7"
CONFIG_CPU_ID="intelpro_ipro7"
CONFIG_CROSS_COMPILE="/opt/toolchain/riscv_ipro7/bin/riscv64-unknown-elf-"
CONFIG_EVB=y
CONFIG_BOARD="EVB"

#
# Build Configuration
#
CONFIG_LINK_FLASH=y
# In-package (internal) 2M flash — NOT external SF3, so do NOT set
# CONFIG_DISABLE_SDC_PINMUX. Physical flash cfg comes from bootrom
# (FLASH_CFG_FROM_BOOTROM); this selects the 2MB linker/partition region.
CONFIG_IPRO7_FLASH_2M=y
CONFIG_PARTITION=y
CONFIG_ENABLE_FRAME_POINTER=y
CONFIG_EXCEPTION_DUMP=y

#
# Memory Configuration
#
CONFIG_USE_PSRAM=y

#
# Audio output — on-chip DAC sink for playback (src/dac_test.c):
# pdm_play replays a recording, pdm_loop is a live mic->speaker monitor.
#
CONFIG_AUDIO_OUTPUT=y

# REQUIRED whenever AUADC capture and DAC playback are live together
# (pdm_loop, or playing back while streaming). The legacy dma_init() does a
# controller-wide DMA_Disable/Enable on every call, which aborts the
# in-flight AUADC transfer — hal_dma.c calls this out as "the bug that
# blocks duplex audio". The allocator replaces it with a per-channel attach.
CONFIG_DMA_CHANNEL_ALLOCATOR=y
CONFIG_DISABLE_EM_TCM_RET=y

#
# Debug UART Configuration
#
CONFIG_PLATFORM_UART_BAUDRATE=921600

#
# RTOS Configuration
#
CONFIG_FREERTOS_SUPPORT=y
CONFIG_COMPONENTS_FREERTOS_ENABLE=y
CONFIG_FREERTOS=y
CONFIG_IPRO_OSAL=y

#
# System Services
#
CONFIG_SHELL=y
CONFIG_SHELL_EXEC_THREAD=y

#
# Wireless — BLE 5.4 Peripheral
#
CONFIG_BLUETOOTH_LE_ENABLE=y
CONFIG_BT_CTLR_IPRO=y
CONFIG_IPRO_BLE_CTLR_LINK1=y
CONFIG_IPRO_BLE_CTLR_LIB="link1"
CONFIG_IPRO_BLE_CTLR_FEATURE_BT52=y
CONFIG_IPRO_BLE_CTLR_FEATURE="bt52"
CONFIG_BT_HOST_IPRO_V44=y
CONFIG_BT_CENTRAL=y
CONFIG_BT_AUTO_PHY_PERIPHERAL_NONE=y
CONFIG_BT_AUTO_DATA_LEN_UPDATE=y
CONFIG_BT_DATA_LEN_UPDATE=y
CONFIG_BT_OBSERVER=y


# Controller: link1 (single connection, smallest footprint)
CONFIG_BTBLECONTROLLER_LINK1=y
CONFIG_EM_SIZE=32

# NVDS — required for flash BLE apps: the link1 controller references
# __nvds_start/__nvds_end (emitted only when ENABLE_NVDS=y) and
# bt_nvds_cli_link_anchor (compiled only under CFG_NVDS). Flash-layout
# builds default ENABLE_NVDS off, so a BLE flash app must opt in here.
CONFIG_ENABLE_NVDS=y
CONFIG_CFG_NVDS=y

#
# AI / NPU — on-device speaker ID (shares the DMIC with BLE streaming).
# PSRAM (already enabled) holds the NPU activation buffers + 1MB model.
#
CONFIG_AI_SUPPORT=y
CONFIG_AI_CPU_NN_OPS=y
CONFIG_AI_CYCLE_PROFILE=y
# CONFIG_MEETING_EMBED_MODEL is not set
CONFIG_MEETING_EMBED_MODEL_PATH="../../platform/ipro7_demo/demo/ai/ai_model/mbv2.inm"
CONFIG_AI_LEGACY_YOLO=y
CONFIG_AI_LEGACY_POSTPROCESS=y

# Roles: peripheral only
CONFIG_BT_CONN=1
CONFIG_BT_PERIPHERAL=y
CONFIG_BT_BROADCASTER=y

# Features
CONFIG_PHY_UPDATE=y

# Host stack
CONFIG_BT_SMP=y
CONFIG_BT_FIXED_PASSKEY=y
CONFIG_BT_GATT_CLIENT=y
CONFIG_BT_STACK_CLI=y
CONFIG_BLE_STACK_DBG_PRINT=y
CONFIG_BT_DIS_SERVER=y

# Event system (needed by BLE stack)
CONFIG_IPRO_EVENT=y

# LC3 codec (for compressed BLE audio streaming)
CONFIG_COMPONENTS_LC3_ENABLE=y

#
# Logging
#
CONFIG_IPRO_LOG_ENABLE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_COLORS=y
CONFIG_LOG_TIMESTAMP=y
CONFIG_LOG_BUFFER_SIZE=256
CONFIG_LOG_USE_MUTEX=y
CONFIG_LOG_OUTPUT_UART=y

#
# Console / libc
#
CONFIG_CONSOLE_ENABLE=y
CONFIG_COMPONENTS_NEW_LIBC_ENABLE=y
CONFIG_COMPONENTS_UTILITY_API_ENABLE=y
CONFIG_COMPONENTS_SOFTCRC_ENABLE=y

#
# Compiler Optimization
#
CONFIG_COMPILER_OPTIMIZATION_LEVEL_SIZE=y
