#
# IPRO6S Thread Border Router - IPRO6S EVK, standalone (console) profile
#
# Backbone: Wi-Fi station. Thread radio: an external RCP on UART1 at
# 1,000,000 baud, 8N1, no flow control - IPRO6S GPIO1 (TX) to the RCP RX,
# GPIO0 (RX) to the RCP TX, common ground. GPIO0/1 are on the EVK header H1.
# The reference RCP is apps/networking/thread/ipro7_uart_rcp (defconfig_reef).
# Console: UART0 (GPIO28 TX / GPIO29 RX) at 115200.
# Thread settings: EasyFlash at 0x1F8000 (24 KB), outside the firmware slot.
#
# CONFIG_IPRO7 is not set
CONFIG_IPRO6=y
CONFIG_CHIP="IPRO6"
CONFIG_CPU_ID="intelpro_ipro7"
CONFIG_EVB=y
CONFIG_BOARD="EVB"
CONFIG_LINK_FLASH=y
CONFIG_USE_ROM_DRIVERS=y

CONFIG_FREERTOS_SUPPORT=y
CONFIG_COMPONENTS_FREERTOS_ENABLE=y
CONFIG_FREERTOS=y
CONFIG_COMPONENTS_NEW_LIBC_ENABLE=y
CONFIG_COMPONENTS_UTILITY_API_ENABLE=y
CONFIG_COMPONENTS_SOFTCRC_ENABLE=y
CONFIG_SHELL=y
CONFIG_SHELL_EXEC_THREAD=y
CONFIG_IPRO_LOG_ENABLE=y
CONFIG_LOG_OUTPUT_UART=y

CONFIG_THREAD_ENABLE=y
CONFIG_OPENTHREAD_ENABLE=y
CONFIG_OPENTHREAD_FTD=y
CONFIG_THREAD_RADIO_SPINEL=y
CONFIG_THREAD_WIFI_BORDER_ROUTER=y
# Demo: routing/backbone services do not require a Matter accessory on the BR.
CONFIG_THREAD_BR_AUTOMATIC_BACKBONE=y
# CONFIG_MATTER_ENABLE is not set
CONFIG_OPENTHREAD_BORDER_ROUTER=y
CONFIG_OPENTHREAD_ECDSA_ENABLE=y
CONFIG_OPENTHREAD_BORDER_AGENT_ENABLE=y
CONFIG_OPENTHREAD_CLI=y
# `ot dataset ... -x <hex>` with a full operational dataset (~300 chars).
CONFIG_OPENTHREAD_CLI_MAX_LINE_LENGTH=384
CONFIG_OPENTHREAD_PING_SENDER=y
CONFIG_OPENTHREAD_IP6_SLAAC_ENABLE=y
# Host-size pool for concurrent mDNS, Border Agent DTLS and Thread traffic.
# Matches the vendored POSIX host baseline; 32-buffer probe budget exhausted
# during repeated Commissioner/BBR transitions (mdns.cpp AppendDomainName).
CONFIG_OPENTHREAD_NUM_MESSAGE_BUFFERS=256
CONFIG_OPENTHREAD_DUA_ENABLE=y
CONFIG_COMPONENTS_MBEDTLS_ENABLE=y
CONFIG_EASYFLASH4=y
CONFIG_EASYFLASH4_FIXED_PARTITION=y
CONFIG_EASYFLASH4_FIXED_PARTITION_OFFSET=2064384
CONFIG_EASYFLASH4_FIXED_PARTITION_SIZE=24576
CONFIG_THREAD_RCP_UART_PORT=1
CONFIG_THREAD_RCP_UART_TX_PIN=1
CONFIG_THREAD_RCP_UART_RX_PIN=0
CONFIG_THREAD_RCP_UART_BAUD=1000000
CONFIG_THREAD_RCP_BOOT_PLATFORM_RESET=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_WIFI6=y
# Wi-Fi memory profile: a Thread network carries at most 250 kbit/s, so the
# BR takes the BALANCED station profile (32 KB lwIP heap, 12 RX buffers).
# The PERF default does not fit the Wi-Fi RAM next to the BR's lwIP pools.
CONFIG_WIFI_MEM_PROFILE_BALANCED=y
CONFIG_USE_MACSW=y
CONFIG_PHY_CLI=y
CONFIG_DHCPD=y
CONFIG_COMPONENTS_LWIP_ENABLE=y
CONFIG_IPV6=y
CONFIG_IPRO_EVENT=y
CONFIG_IPRO_EVENT_DEFAULT_QUEUE_SIZE=32
CONFIG_IPRO_EVENT_DEFAULT_TASK_STACK=2048
CONFIG_IPRO_EVENT_DEFAULT_TASK_PRIORITY=5
CONFIG_IPRO_EVENT_POST_FROM_ISR=y

# Wi-Fi baseband/RF debug log off by default on the BR (WL_BB_LOG_EN=0)
CONFIG_WL_BB_LOG_DISABLE=y
CONFIG_WIRELESS_LIB_VARIANT="ipro6s_thread_border_router-evk"
