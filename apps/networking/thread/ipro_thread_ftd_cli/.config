
#
# IPRO SDK Configuration - Thread FTD CLI Application
#

# Hardware Platform Settings

#
# Hardware Platform Configuration
#
CONFIG_IPRO7=y
# CONFIG_IPRO6 is not set
CONFIG_CHIP="IPRO7"
CONFIG_CPU_ID="intelpro_ipro7"
CONFIG_CROSS_COMPILE="/opt/toolchain/riscv_ipro7/bin/riscv64-unknown-elf-"
# CONFIG_NONE is not set
# CONFIG_FPGA is not set
CONFIG_EVB=y

#
# Build Configuration
#
CONFIG_LINK_FLASH=y
# CONFIG_USE_PSRAM=y

# Component Modules

#
# RTOS Configuration
#
CONFIG_FREERTOS_SUPPORT=y
# CONFIG_ZEPHYR_SUPPORT is not set
CONFIG_COMPONENTS_FREERTOS_ENABLE=y
# CONFIG_COMPONENTS_ZEPHYR_ENABLE is not set
CONFIG_FREERTOS=y
# CONFIG_ZEPHYR is not set
# CONFIG_NO_RTOS is not set

#
# FreeRTOS Configuration
#
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TICKLESS_IDLE=0
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=1024
CONFIG_FREERTOS_ISR_STACKSIZE=2048
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=16

#
# FreeRTOS Kernel Configuration
#
CONFIG_FREERTOS_UNICORE=y
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=n
CONFIG_FREERTOS_USE_TICKLESS_IDLE=n
CONFIG_FREERTOS_CORETIMER_0=y
CONFIG_FREERTOS_CORETIMER_1=n
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_FREERTOS_CHECK_MUTEX_GIVEN_BY_OWNER=y

#
# System Components Configuration
#
CONFIG_SHELL=y
CONFIG_SHELL_EXEC_THREAD=y
# CONFIG_COMPONENTS_YLOOP_ENABLE is not set
CONFIG_IPRO_EVENT=y
CONFIG_COMPONENTS_SOFTCRC_ENABLE=y
CONFIG_COMPONENTS_UTILITY_API_ENABLE=y
CONFIG_COMPONENTS_NEW_LIBC_ENABLE=y

#
# File System Configuration
#
CONFIG_EASYFLASH4=y

#
# Crypto Components
# Use SDK's mbedTLS (required by other components)
#
CONFIG_COMPONENTS_MBEDTLS_ENABLE=y

#
# Hardware Crypto Acceleration
# NOTE: IPRO7 hw_acc port is not compatible with IPRO6's device driver framework
# The port/hw_acc/ directory requires ipro_device_s and ipro_sec_pka.h which don't exist in IPRO7
# IPRO7 uses direct Sec_Eng_* API instead (see drv_sec_eng.h)
# Solution: Created port/hw_acc_ipro7/ with IPRO7-compatible implementations
#
CONFIG_MBEDTLS_SELF_TEST=y
#CONFIG_MBEDTLS_AES_USE_HW=y
CONFIG_MBEDTLS_SHA1_USE_HW=y
CONFIG_MBEDTLS_SHA256_USE_HW=y
CONFIG_MBEDTLS_SHA512_USE_HW=y

#
# IEEE 802.15.4 Configuration
#
CONFIG_OPENTHREAD_ENABLE=y
CONFIG_IEEE802154_ENABLE=y
CONFIG_IEEE802154_DEFAULT_TXPOWER=20
#
# Thread/OpenThread Configuration
#
CONFIG_THREAD_ENABLE=y
CONFIG_OPENTHREAD_FTD=y
CONFIG_OT_FREERTOS_ENABLE=1
# CONFIG_OPENTHREAD_MTD is not set
CONFIG_OPENTHREAD_CLI=y

#
# App: auto-attach to a default Thread network on boot.
# Set CONFIG_THREAD_AUTO_START=y to call thread_ftd_app_start() from
# the OT init task. The compiled-in dataset below is applied if no
# dataset is committed (otDatasetIsCommissioned()==false).
#
CONFIG_THREAD_AUTO_START=y
CONFIG_THREAD_DEFAULT_NETWORK_NAME="IPRO-Thread"
CONFIG_THREAD_DEFAULT_CHANNEL=15
CONFIG_THREAD_DEFAULT_PAN_ID=0x1234
CONFIG_THREAD_DEFAULT_EXT_PAN_ID="dead00beef00cafe"
CONFIG_THREAD_DEFAULT_NETWORK_KEY="00112233445566778899aabbccddeeff"
CONFIG_THREAD_DEFAULT_MESH_LOCAL_PREFIX="fd11111122000000"

# Compiled-in defaults are applied only on a virgin device (no committed
# Active Dataset in NVDS). To wipe credentials and start fresh, use
# `ot factoryreset` from the CLI — it clears settings and POR-reboots,
# after which the values above are re-applied on the next boot.
# CONFIG_THREAD_DEFAULT_FORCE_OVERWRITE is not set

# Disable Commissioner/Joiner to save ~150 KB (mbedTLS DTLS/SSL)
# CONFIG_OPENTHREAD_JOINER is not set
# CONFIG_OPENTHREAD_COMMISSIONER is not set

# Disable optional DHCP6 features to save ~20-30 KB
# CONFIG_OPENTHREAD_DHCP6_CLIENT is not set
# CONFIG_OPENTHREAD_DHCP6_SERVER is not set
CONFIG_OPENTHREAD_DNS_CLIENT=y
CONFIG_OPENTHREAD_MLR_ENABLE=y
CONFIG_OPENTHREAD_DUA_ENABLE=y

# Disable Border Router features if not needed (~30 KB)
# CONFIG_OPENTHREAD_BORDER_ROUTER is not set

# Enable `ot ping <addr>` CLI command (~3 KB flash)
CONFIG_OPENTHREAD_PING_SENDER=y

# Disable OpenThread test executables (they require standalone -lmbedtls)
# CONFIG_OT_BUILD_EXECUTABLES=n

#
# Logging Configuration (optimized for size)
#
CONFIG_IPRO_LOG_ENABLE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# CONFIG_LOG_DEFAULT_LEVEL_DEBUG is not set
CONFIG_LOG_DEFAULT_LEVEL=4
CONFIG_LOG_COLORS=y
CONFIG_LOG_TIMESTAMP=y
# CONFIG_LOG_THREAD_ID is not set
CONFIG_LOG_BUFFER_SIZE=256
CONFIG_LOG_USE_MUTEX=y
CONFIG_LOG_OUTPUT_UART=y

#
# Network Configuration
#
CONFIG_LWIP_ENABLE=y
CONFIG_LWIP_IPV6=y

#
# Logging Configuration (duplicate - aligned with above)
#
CONFIG_IPRO_LOG_ENABLE=y
CONFIG_IPRO_LOG_LEVEL_DEBUG=y
CONFIG_IPRO_LOG_COLOR_ENABLE=y
CONFIG_IPRO_LOG_TIMESTAMP_ENABLE=y

#
# Platform UART Configuration
#
CONFIG_PLATFORM_UART_BAUDRATE=921600


#
# System Configuration
#
CONFIG_SYSTEM_TIME64=y
CONFIG_MAIN_TASK_STACK_SIZE=4096

#
# OpenThread Configuration
#

# Logging (0=NONE, 1=CRIT, 2=WARN, 3=NOTE, 4=INFO, 5=DEBG)
CONFIG_OPENTHREAD_LOG_LEVEL=4

# Memory Configuration
CONFIG_OPENTHREAD_NUM_MESSAGE_BUFFERS=44
CONFIG_OPENTHREAD_MESSAGE_BUFFER_SIZE=128

# CLI Configuration
CONFIG_OPENTHREAD_CLI_MAX_LINE_LENGTH=256

# Network Features (enable as needed)
CONFIG_OPENTHREAD_IP6_SLAAC_ENABLE=y
CONFIG_OPENTHREAD_TMF_NETDATA_SERVICE_ENABLE=y

# Security Features (disabled by default to save ~35KB)
CONFIG_OPENTHREAD_ECDSA_ENABLE=y
CONFIG_OPENTHREAD_SRP_CLIENT_ENABLE=y

# Radio Configuration
# CONFIG_OPENTHREAD_RADIO_COEX_ENABLE=y
# CONFIG_OPENTHREAD_MAC_CSL_RECEIVER_ENABLE=y

# MLE Configuration
CONFIG_OPENTHREAD_MLE_MAX_CHILDREN=16
CONFIG_OPENTHREAD_MLE_IP_ADDRS_PER_CHILD=4

# Application Features (disabled by default)
# CONFIG_OPENTHREAD_COAP_API_ENABLE=y
# CONFIG_OPENTHREAD_COAP_SECURE_API_ENABLE=y
# CONFIG_OPENTHREAD_BORDER_AGENT_ENABLE=y
# CONFIG_OPENTHREAD_SNTP_CLIENT_ENABLE=y
# CONFIG_OPENTHREAD_UDP_FORWARD_ENABLE=y
# CONFIG_OPENTHREAD_TIME_SYNC_ENABLE=y

# Commissioner and Joiner
#CONFIG_OPENTHREAD_COMMISSIONER=y
# CONFIG_OPENTHREAD_JOINER=y

# DHCP6 and DNS
# CONFIG_OPENTHREAD_DHCP6_CLIENT=y
# CONFIG_OPENTHREAD_DHCP6_SERVER=y
# CONFIG_OPENTHREAD_DNS_CLIENT=y

# MAC Features
# CONFIG_OPENTHREAD_MAC_FILTER_ENABLE=y
# CONFIG_OPENTHREAD_MAC_RETRY_SUCCESS_HISTOGRAM_ENABLE=y
CONFIG_EVFS=y
CONFIG_EVFS_POSIX=y
