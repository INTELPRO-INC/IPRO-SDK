#
# IPRO7 OpenThread RCP (spinel over UART) - IPRO7AI Reef V4
#
# UART1 at 1,000,000 baud, 8N1, no flow control, on the 40-pin header J_IO:
#   pin 13 = GPIO14 = RCP TX  -> Border Router RX
#   pin 15 = GPIO15 = RCP RX  <- Border Router TX
#   pin 14 = GND
# GPIO14 / GPIO15 are the microSD power switch and card detect on this
# board: leave the microSD slot empty while the RCP runs.
# Console: UART0 (GPIO20 / GPIO21) through the on-board probe, 115200.
#
CONFIG_IPRO7=y
CONFIG_CHIP="IPRO7"
CONFIG_CPU_ID="intelpro_ipro7"
CONFIG_IPRO7AI_REEF=y
CONFIG_BOARD="IPRO7AI_REEF"
CONFIG_IPRO7_FLASH_2M=y
CONFIG_LINK_FLASH=y

CONFIG_FREERTOS_SUPPORT=y
CONFIG_COMPONENTS_FREERTOS_ENABLE=y
CONFIG_FREERTOS=y
CONFIG_COMPONENTS_NEW_LIBC_ENABLE=y
CONFIG_COMPONENTS_UTILITY_API_ENABLE=y
CONFIG_COMPONENTS_SOFTCRC_ENABLE=y
CONFIG_EASYFLASH4=y

CONFIG_SHELL=y
CONFIG_IPRO_LOG_ENABLE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_OUTPUT_UART=y

CONFIG_COMPONENTS_MBEDTLS_ENABLE=y
CONFIG_OPENTHREAD_ENABLE=y
CONFIG_THREAD_ENABLE=y
CONFIG_IEEE802154_ENABLE=y
CONFIG_OPENTHREAD_RADIO=y
CONFIG_THREAD_RCP_SOFTWARE_TIMING=y
# CONFIG_OPENTHREAD_FTD is not set
# CONFIG_OPENTHREAD_MTD is not set
# CONFIG_OPENTHREAD_CLI is not set
CONFIG_OT_FREERTOS_ENABLE=1

CONFIG_THREAD_RCP_UART_PORT=1
CONFIG_THREAD_RCP_UART_TX_PIN=14
CONFIG_THREAD_RCP_UART_RX_PIN=15
CONFIG_THREAD_RCP_UART_BAUD=1000000
