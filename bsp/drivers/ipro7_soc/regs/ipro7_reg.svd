            <access>read-write</access>
            <resetValue>0x02000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>adpll_lo_unlock_intrpt_clear</name>
                <description>manually clear unlock interupt signal when 1'b1</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_lo_lock_sel</name>
                <description>select the lo lock signal, 1'b1 means state 5 or 9 is locked, 1'b0 means only state 5 is locked</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_timeout_cnt1_sel</name>
                <description>timeout value for internal reset control</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_timeout_cnt_sel</name>
                <description>The main timeout value for FCAL and loop lock</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_momhold_lmsenb_ext</name>
                <description>None</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_rst_coarse_det_ext</name>
                <description>None</description>
                <bitRange>[5:5]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_rst_spd_det_ext</name>
                <description>valid when adpll_lo_fsm_ext = 1, reset spd detection block</description>
                <bitRange>[6:6]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_loop_lock_ext</name>
                <description>valid when adpll_lo_fsm_ext = 1, loop locked signal</description>
                <bitRange>[7:7]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_fcal_done_ext</name>
                <description>valid when adpll_lo_fsm_ext = 1, fcal done signal</description>
                <bitRange>[8:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_fcal_start_ext</name>
                <description>valid when adpll_lo_fsm_ext = 1, start the FCAL</description>
                <bitRange>[9:9]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_lo_fsm_ext</name>
                <description>1'b1 enable the external FSM control</description>
                <bitRange>[11:11]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_fsm_en</name>
                <description>1'b1 Enable the ADPLL FSM</description>
                <bitRange>[12:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_fsm_bypass</name>
                <description>None</description>
                <bitRange>[13:13]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_lock_fail_en</name>
                <description>1'b1 enable the lock fail indicator to let the fsm go to state 10 (ADPLL_FAIL)</description>
                <bitRange>[14:14]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_abnormal_dealed</name>
                <description>1'b1 for adpll fsm turn around when FCAL is failed due to mom_code overflow or lock failed</description>
                <bitRange>[15:15]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_vctrl_det_start_ext</name>
                <description>start vctrl out of range detection, valid at adpll_vctrl_det_en_ext = 1'b1</description>
                <bitRange>[18:18]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_vctrl_det_en_ext</name>
                <description>Software incremental FCAL enable, enable vctrl out of range detection</description>
                <bitRange>[19:19]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_mom_update_en_ext</name>
                <description>Software incremental FCAL enable, mom_code should be from external register</description>
                <bitRange>[20:20]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_freqerr_det_start_ext</name>
                <description>start frequency error detection when be 1'b1, valid at adpll_mom_search_en_ext = 1'b1</description>
                <bitRange>[21:21]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_mom_search_en_ext</name>
                <description>software FCAL enable, fcal_mode should be set to 2 or 3 for external control momcap code</description>
                <bitRange>[22:22]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_lo_open</name>
                <description>enable lo open, vctrl and momcap code all come from digital registers</description>
                <bitRange>[23:23]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_sfreg_sel</name>
                <description>Turn on the extral sfreg units in the adpll_sfreg block</description>
                <bitRange>[24:24]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_lo_unlock_intrpt_clear_sel</name>
                <description>0: auto clear, 1: manual clear</description>
                <bitRange>[25:25]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_force_inc_fcal_en</name>
                <description>None</description>
                <bitRange>[26:26]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>adpll_lf_reg</name>
            <description>adpll_lf_reg</description>
