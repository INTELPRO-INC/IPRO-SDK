            <resetValue>0x00962000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>lo_fcw</name>
                <description>flo/fxtal*2^17, valid when lo_fcw_ctrl_hw=0</description>
                <bitRange>[24:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>lo_fcw_config2</name>
