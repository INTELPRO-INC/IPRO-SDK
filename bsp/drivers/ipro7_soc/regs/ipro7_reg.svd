                <access>read-only</access>
              </field>
              <field>
                <name>sts_setup_data_b2</name>
                <description>Setup Data Byte2 (wValue[7:0])</description>
                <bitRange>[23:16]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>sts_setup_data_b3</name>
                <description>Setup Data Byte3 (wValue[15:8])</description>
                <bitRange>[31:24]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>usb_setup_data_1</name>
            <description>usb_setup_data_1</description>
            <addressOffset>0x14</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>
              <field>
                <name>sts_setup_data_b4</name>
                <description>Setup Data Byte4 (wIndex[7:0])</description>
                <bitRange>[7:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>sts_setup_data_b5</name>
                <description>Setup Data Byte5 (wIndex[15:8])</description>
                <bitRange>[15:8]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>sts_setup_data_b6</name>
                <description>Setup Data Byte6 (wLength[7:0])</description>
                <bitRange>[23:16]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>sts_setup_data_b7</name>
                <description>Setup Data Byte7 (wLength[15:8])</description>
                <bitRange>[31:24]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>usb_frame_no</name>
            <description>usb_frame_no</description>
            <addressOffset>0x18</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFF00800</resetMask>
            <fields>
              <field>
                <name>sts_frame_no</name>
                <description>Current frame number</description>
                <bitRange>[10:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>sts_pid</name>
                <description>PID value of the current transaction</description>
                <bitRange>[15:12]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>sts_ep_no</name>
                <description>Endpoint number of the current transaction</description>
                <bitRange>[19:16]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>usb_error</name>
            <description>usb_error</description>
            <addressOffset>0x1C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFF80</resetMask>
