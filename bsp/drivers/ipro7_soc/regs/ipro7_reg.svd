              <field>
                <name>spi_fifo_wdata</name>
                <description>TX FIFO write data port
Note: Partial valid if cr_spi_frame_size is set to different value:
2'd0 (8-bit frame): Only [7:0] are valid and [31:8] are don't-care
2'd1 (16-bit frame): Only [15:0] are valid and [31:16] are don't-care
2'd2 (24-bit frame): Only [23:0] are valid and [31:24] are don't-care
2'd3 (32-bit frame): Entire [31:0] are valid</description>
                <bitRange>[31:0]</bitRange>
                <access>write-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>spi_fifo_rdata</name>
            <description>spi_fifo_rdata</description>
            <addressOffset>0x8C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>
              <field>
                <name>spi_fifo_rdata</name>
                <description>RX FIFO read data port
Note: Partial valid if cr_spi_frame_size is set to different value:
2'd0 (8-bit frame): Only [7:0] are valid and [31:8] are all 0s
2'd1 (16-bit frame): Only [15:0] are valid and [31:16] are all 0s
2'd2 (24-bit frame): Only [23:0] are valid and [31:24] are all 0s
2'd3 (32-bit frame): Entire [31:0] is valid</description>
                <bitRange>[31:0]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>backup_io_en</name>
            <description>backup_io_en</description>
            <addressOffset>0xFC</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>backup_io_en</name>
                <description>None</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </registers>
      </peripheral>
      <peripheral>
        <name>SPI1</name>
        <version>1.0</version>
        <description>SPI1</description>
        <groupName>SPI1</groupName>
        <baseAddress>0x3001E000</baseAddress>
        <size>32</size>
        <access>read-write</access>
        <addressBlock>
          <offset>0</offset>
          <size>0x1000</size>
          <usage>registers</usage>
        </addressBlock>
        <registers>
          <register>
            <name>spi_config</name>
            <description>spi_config</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_spi_m_en</name>
                <description>Enable signal of SPI Master function
Asserting this bit will trigger the transaction, and should be de-asserted after finish</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_s_en</name>
                <description>Enable signal of SPI Slave function, Master and Slave should not be both enabled at the same time
(This bit becomes don't-care if cr_spi_m_en is enabled)</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_frame_size</name>
                <description>SPI frame size (also the valid width for each FIFO entry)
2'd0: 8-bit
2'd1: 16-bit
2'd2: 24-bit
2'd3: 32-bit</description>
                <bitRange>[3:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_sclk_pol</name>
                <description>SCLK polarity
0: SCLK output LOW at IDLE state
1: SCLK output HIGH at IDLE state</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_sclk_ph</name>
                <description>SCLK clock phase inverse signal</description>
                <bitRange>[5:5]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_bit_inv</name>
                <description>Bit-inverse signal for each data byte
0: Each byte is sent out MSB-first
1: Each byte is sent out LSB-first</description>
                <bitRange>[6:6]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_byte_inv</name>
                <description>Byte-inverse signal for each FIFO entry data
0: Byte[0] is sent out first
1: Byte[3] is sent out first</description>
                <bitRange>[7:7]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_rxd_ignr_en</name>
                <description>Enable signal of RX data ignore function</description>
                <bitRange>[8:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_m_cont_en</name>
                <description>Enable signal of master continuous transfer mode
1'b0: Disabled, SS_n will de-assert between each data frame
1'b1: Enabled, SS_n will stay asserted between each consecutive data frame if the next data is valid in the FIFO</description>
                <bitRange>[9:9]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_s_3pin_mode</name>
                <description>SPI slave 3-pin mode
1'b0: 4-pin mode (SS_n is enabled)
1'b1: 3-pin mode (SS_n is disabled / don't care)</description>
                <bitRange>[10:10]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_deg_en</name>
                <description>Enable signal of all input de-glitch function</description>
                <bitRange>[11:11]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_deg_cnt</name>
                <description>De-glitch function cycle count</description>
                <bitRange>[15:12]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>spi_int_sts</name>
            <description>spi_int_sts</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x3F003F02</resetValue>
            <resetMask>0xFFFFFFC0</resetMask>
            <fields>
              <field>
                <name>spi_end_int</name>
                <description>SPI transfer end interrupt, shared by both master and slave mode
Master mode: Triggered when the final frame is transferred
Slave mode: Triggered when CS_n is de-asserted</description>
                <bitRange>[0:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>spi_txf_int</name>
                <description>SPI TX FIFO ready (tx_fifo_cnt &gt; tx_fifo_th) interrupt, auto-cleared when data is pushed</description>
                <bitRange>[1:1]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>spi_rxf_int</name>
                <description>SPI RX FIFO ready (rx_fifo_cnt &gt; rx_fifo_th) interrupt, auto-cleared when data is popped</description>
                <bitRange>[2:2]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>spi_sto_int</name>
                <description>SPI slave mode transfer time-out interrupt, triggered when SPI bus is idle for a given value</description>
                <bitRange>[3:3]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>spi_txu_int</name>
                <description>SPI slave mode TX underrun error flag, triggered when TXD is not ready during transfer in slave mode</description>
                <bitRange>[4:4]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>spi_fer_int</name>
                <description>SPI TX/RX FIFO error interrupt, auto-cleared when FIFO overflow/underflow error flag is cleared</description>
                <bitRange>[5:5]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>cr_spi_end_mask</name>
                <description>Interrupt mask of spi_end_int</description>
                <bitRange>[8:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_txf_mask</name>
                <description>Interrupt mask of spi_txe_int</description>
                <bitRange>[9:9]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_rxf_mask</name>
                <description>Interrupt mask of spi_rxv_int</description>
                <bitRange>[10:10]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_sto_mask</name>
                <description>Interrupt mask of spi_sto_int</description>
                <bitRange>[11:11]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_txu_mask</name>
                <description>Interrupt mask of spi_txu_int</description>
                <bitRange>[12:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_fer_mask</name>
                <description>Interrupt mask of spi_fer_int</description>
                <bitRange>[13:13]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_end_clr</name>
                <description>Interrupt clear of spi_end_int</description>
                <bitRange>[16:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_sto_clr</name>
                <description>Interrupt clear of spi_sto_int</description>
                <bitRange>[19:19]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_txu_clr</name>
                <description>Interrupt clear of spi_txu_int</description>
                <bitRange>[20:20]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_end_en</name>
                <description>Interrupt enable of spi_end_int</description>
                <bitRange>[24:24]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_txf_en</name>
                <description>Interrupt enable of spi_txe_int</description>
                <bitRange>[25:25]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_rxf_en</name>
                <description>Interrupt enable of spi_rxv_int</description>
                <bitRange>[26:26]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_sto_en</name>
                <description>Interrupt enable of spi_sto_int</description>
                <bitRange>[27:27]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_txu_en</name>
                <description>Interrupt enable of spi_txu_int</description>
                <bitRange>[28:28]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_fer_en</name>
                <description>Interrupt enable of spi_fer_int</description>
                <bitRange>[29:29]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>spi_bus_busy</name>
            <description>spi_bus_busy</description>
            <addressOffset>0x8</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFE</resetMask>
            <fields>
              <field>
                <name>sts_spi_bus_busy</name>
                <description>Indicator of SPI bus busy</description>
                <bitRange>[0:0]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>spi_prd_0</name>
            <description>spi_prd_0</description>
            <addressOffset>0x10</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0F0F0F0F</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_spi_prd_s</name>
                <description>Length of START condition (please refer to "Timing" tab)</description>
                <bitRange>[7:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_prd_p</name>
                <description>Length of STOP condition (please refer to "Timing" tab)</description>
                <bitRange>[15:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_prd_d_ph_0</name>
                <description>Length of DATA phase 0 (please refer to "Timing" tab)</description>
                <bitRange>[23:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_prd_d_ph_1</name>
                <description>Length of DATA phase 1 (please refer to "Timing" tab)</description>
                <bitRange>[31:24]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>spi_prd_1</name>
            <description>spi_prd_1</description>
            <addressOffset>0x14</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0000000F</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_spi_prd_i</name>
                <description>Length of INTERVAL between frame (please refer to "Timing" tab)</description>
                <bitRange>[7:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>spi_rxd_ignr</name>
            <description>spi_rxd_ignr</description>
            <addressOffset>0x18</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_spi_rxd_ignr_p</name>
                <description>Stopping point of RX data ignore function</description>
                <bitRange>[4:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_spi_rxd_ignr_s</name>
                <description>Starting point of RX data ignore function</description>
                <bitRange>[20:16]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>spi_sto_value</name>
            <description>spi_sto_value</description>
            <addressOffset>0x1C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000FFF</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_spi_sto_value</name>
                <description>Time-out value for spi_sto_int triggering</description>
                <bitRange>[11:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>spi_sync_0</name>
            <description>spi_sync_0</description>
            <addressOffset>0x20</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFD</resetMask>
            <fields>
              <field>
                <name>cr_spi_sync_hdr_set</name>
                <description>Set SPI sync header function. Note: This function only supports 4-byte header, using 8-bit frame mode</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>sts_spi_sync_mask</name>
                <description>Indicator of SPI sync header function mask is active</description>
                <bitRange>[1:1]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>spi_sync_1</name>
            <description>spi_sync_1</description>
            <addressOffset>0x24</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_spi_sync_hdr</name>
                <description>SPI sync header</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>spi_fifo_config_0</name>
            <description>spi_fifo_config_0</description>
            <addressOffset>0x80</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFF0F</resetMask>
            <fields>
              <field>
                <name>spi_dma_tx_en</name>
                <description>Enable signal of dma_tx_req/ack interface</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>spi_dma_rx_en</name>
                <description>Enable signal of dma_rx_req/ack interface</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>tx_fifo_clr</name>
                <description>Clear signal of TX FIFO</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>rx_fifo_clr</name>
                <description>Clear signal of RX FIFO</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>tx_fifo_overflow</name>
                <description>Overflow flag of TX FIFO, can be cleared by tx_fifo_clr</description>
                <bitRange>[4:4]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>tx_fifo_underflow</name>
                <description>Underflow flag of TX FIFO, can be cleared by tx_fifo_clr</description>
                <bitRange>[5:5]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>rx_fifo_overflow</name>
                <description>Overflow flag of RX FIFO, can be cleared by rx_fifo_clr</description>
                <bitRange>[6:6]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>rx_fifo_underflow</name>
                <description>Underflow flag of RX FIFO, can be cleared by rx_fifo_clr</description>
                <bitRange>[7:7]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>spi_fifo_config_1</name>
            <description>spi_fifo_config_1</description>
            <addressOffset>0x84</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000010</resetValue>
            <resetMask>0xFFFFE0E0</resetMask>
            <fields>
              <field>
                <name>tx_fifo_cnt</name>
                <description>TX FIFO available count (unit: byte)</description>
                <bitRange>[4:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>rx_fifo_cnt</name>
                <description>RX FIFO available count (unit: byte)</description>
                <bitRange>[12:8]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>tx_fifo_th</name>
                <description>TX FIFO threshold, dma_tx_req will not be asserted if tx_fifo_cnt is less than this value</description>
                <bitRange>[19:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>rx_fifo_th</name>
                <description>RX FIFO threshold, dma_rx_req will not be asserted if rx_fifo_cnt is less than this value</description>
                <bitRange>[27:24]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>spi_fifo_wdata</name>
            <description>spi_fifo_wdata</description>
            <addressOffset>0x88</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>spi_fifo_wdata</name>
                <description>TX FIFO write data port
Note: Partial valid if cr_spi_frame_size is set to different value:
2'd0 (8-bit frame): Only [7:0] are valid and [31:8] are don't-care
2'd1 (16-bit frame): Only [15:0] are valid and [31:16] are don't-care
2'd2 (24-bit frame): Only [23:0] are valid and [31:24] are don't-care
2'd3 (32-bit frame): Entire [31:0] are valid</description>
                <bitRange>[31:0]</bitRange>
                <access>write-only</access>
              </field>
            </fields>
