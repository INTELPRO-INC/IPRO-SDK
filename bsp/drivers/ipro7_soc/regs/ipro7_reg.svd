                <name>utmi_rx_err</name>
                <description>UTMI I/F RX error occurs, cleared by cr_usb_err_clr</description>
                <bitRange>[0:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>xfer_to_err</name>
                <description>Transfer time-out error occurs, cleared by cr_usb_err_clr</description>
                <bitRange>[1:1]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>ivld_ep_err</name>
                <description>Invalid endpoint error occurs, cleared by cr_usb_err_clr</description>
                <bitRange>[2:2]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>pid_seq_err</name>
                <description>PID sequence error occurs, cleared by cr_usb_err_clr</description>
