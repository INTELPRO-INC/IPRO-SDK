                <bitRange>[4:4]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>crc5_err</name>
                <description>Token CRC error occurs, cleared by cr_usb_err_clr</description>
                <bitRange>[5:5]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>crc16_err</name>
                <description>Data CRC error occurs, cleared by cr_usb_err_clr</description>
                <bitRange>[6:6]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
