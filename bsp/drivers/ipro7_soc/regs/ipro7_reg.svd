            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>keycode_int_en</name>
                <description>None</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>ks_done_int_en</name>
                <description>None</description>
                <bitRange>[7:7]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>keyfifo_int_en</name>
                <description>[11] FIFO&gt;=1
[10] FIFO&gt;=2
[9] FIFO&gt;=4
[8] FIFO Full</description>
                <bitRange>[11:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>ghost_int_en</name>
                <description>None</description>
                <bitRange>[12:12]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>ks_int_sts</name>
            <description>ks_int_sts</description>
            <addressOffset>0x14</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFE040</resetMask>
            <fields>
              <field>
                <name>keycode_valid</name>
                <description>None</description>
                <bitRange>[5:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>ks_done</name>
                <description>keycode scan done</description>
                <bitRange>[7:7]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>keyfifo_full</name>
                <description>keycode FIFO full detection</description>
                <bitRange>[8:8]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>keyfifo_half</name>
                <description>keycode FIFO half detection</description>
                <bitRange>[9:9]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>keyfifo_quarter</name>
                <description>keycode FIFO quarter detection</description>
                <bitRange>[10:10]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>keyfifo_nonempty</name>
                <description>keycode FIFO nonempty detection</description>
                <bitRange>[11:11]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>ghost_det</name>
                <description>ghost key event detection status (keycode MSB=1 is ghost key)</description>
                <bitRange>[12:12]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>keycode_clr</name>
            <description>keycode_clr</description>
            <addressOffset>0x18</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>keycode_clr</name>
                <description>None</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>ks_done_clr</name>
                <description>None</description>
                <bitRange>[7:7]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>keyfifo_clr</name>
                <description>keycode FIFO full clear</description>
                <bitRange>[8:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>ghost_clr</name>
                <description>ghost key event detection clear</description>
                <bitRange>[12:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>kidx_clr</name>
                <description>None</description>
                <bitRange>[16:16]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>keycode_value</name>
            <description>keycode_value</description>
            <addressOffset>0x1C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0xFFFFFFFF</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>
              <field>
                <name>keycode0</name>
                <description>Col = keycode / (row_num+1)
Row = keycode % (row_num+1)</description>
                <bitRange>[7:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>keycode1</name>
                <description>None</description>
                <bitRange>[15:8]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>keycode2</name>
                <description>None</description>
                <bitRange>[23:16]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>keycode3</name>
                <description>None</description>
                <bitRange>[31:24]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>keycode_value1</name>
            <description>keycode_value1</description>
            <addressOffset>0x20</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0000FFFF</resetValue>
            <resetMask>0xFFFF0000</resetMask>
            <fields>
              <field>
                <name>keycode4</name>
                <description>None</description>
                <bitRange>[7:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>keycode5</name>
                <description>None</description>
                <bitRange>[15:8]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>keyfifo_idx</name>
            <description>keyfifo_idx</description>
            <addressOffset>0x30</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFF0F8F8</resetMask>
            <fields>
              <field>
                <name>keyfifo_head</name>
                <description>keycode FIFO head (0~7)</description>
                <bitRange>[2:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>keyfifo_tail</name>
                <description>keycode FIFO tail (0~7)</description>
                <bitRange>[10:8]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>keyfifo_cnt</name>
                <description>keycode FIFO valid number</description>
                <bitRange>[19:16]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>keyfifo_value</name>
            <description>keyfifo_value</description>
            <addressOffset>0x34</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x000000FF</resetValue>
            <resetMask>0xFFFFFF00</resetMask>
            <fields>
              <field>
                <name>keyfifo_value</name>
                <description>keycode FIFO value (each read head+1 until tail)</description>
                <bitRange>[7:0]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>ks_ctrl2</name>
            <description>ks_ctrl2</description>
            <addressOffset>0x3C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000001</resetValue>
            <resetMask>0xFFFFF0FF</resetMask>
            <fields>
              <field>
                <name>col_start</name>
                <description>optional to skip col 0~7 (one-hot)</description>
                <bitRange>[7:0]</bitRange>
