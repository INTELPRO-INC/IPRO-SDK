            <addressOffset>0x34</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>CTRLDATA</name>
                <description>Control Data to be written to PHY</description>
                <bitRange>[15:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>MIIRX_DATA</name>
            <description>MIIRX_DATA</description>
            <addressOffset>0x38</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFF0000</resetMask>
            <fields>
              <field>
                <name>PRSD</name>
                <description>Received Data from PHY</description>
                <bitRange>[15:0]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>MIISTATUS</name>
            <description>MIISTATUS</description>
            <addressOffset>0x3C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFC</resetMask>
            <fields>
              <field>
                <name>MIIM_LINKFAIL</name>
                <description>MIIM I/F link fail signal</description>
                <bitRange>[0:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>MIIM_BUSY</name>
                <description>MIIM I/F busy signal
0: The MIIM I/F is ready.
1: The MIIM I/F is busy.</description>
                <bitRange>[1:1]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>MAC_ADDR0</name>
            <description>MAC_ADDR0</description>
            <addressOffset>0x40</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>MAC_B5</name>
                <description>Ethernet MAC address byte 5</description>
                <bitRange>[7:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>MAC_B4</name>
                <description>Ethernet MAC address byte 4</description>
                <bitRange>[15:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>MAC_B3</name>
                <description>Ethernet MAC address byte 3</description>
                <bitRange>[23:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>MAC_B2</name>
                <description>Ethernet MAC address byte 2</description>
                <bitRange>[31:24]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>MAC_ADDR1</name>
            <description>MAC_ADDR1</description>
            <addressOffset>0x44</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>MAC_B1</name>
                <description>Ethernet MAC address byte 1</description>
                <bitRange>[7:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>MAC_B0</name>
                <description>Ethernet MAC address byte 0</description>
                <bitRange>[15:8]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>HASH0_ADDR</name>
            <description>HASH0_ADDR</description>
            <addressOffset>0x48</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>HASH0</name>
                <description>Lower 32-bit of HASH register</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>HASH1_ADDR</name>
            <description>HASH1_ADDR</description>
            <addressOffset>0x4C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>HASH1</name>
                <description>Upper 32-bit of HASH register</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>TXCTRL</name>
            <description>TXCTRL</description>
            <addressOffset>0x50</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>TXPAUSETV</name>
                <description>TX Pause Timer Value
The value that is sent in the pause control frame.</description>
                <bitRange>[15:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>TXPAUSERQ</name>
                <description>TX Pause Request
Writing 1 to this bit starts sending control frame and is automatically cleared to zero.</description>
                <bitRange>[16:16]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </registers>
      </peripheral>
      <peripheral>
        <name>USB</name>
        <version>1.0</version>
        <description>USB</description>
        <groupName>USB</groupName>
        <baseAddress>0x30084000</baseAddress>
        <size>32</size>
        <access>read-write</access>
        <addressBlock>
          <offset>0</offset>
          <size>0x1000</size>
          <usage>registers</usage>
        </addressBlock>
        <registers>
          <register>
            <name>usb_config</name>
            <description>usb_config</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x02000010</resetValue>
            <resetMask>0xEFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_usb_en</name>
                <description>Enable signal of USB function</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_usb_rom_dct_en</name>
                <description>Enable signal of ROM-based descriptors (don't care if ep0_sw_ctrl is asserted)
1'b1: USB descriptors stored in ROM will be used
1'b0: SW should prepare the descriptors requested by HOST</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_usb_ep0_sw_ctrl</name>
                <description>EP0 software control enable
1'b1: EP0 IN/OUT transaction is fully contolled by SW
1'b0: EP0 IN/OUT transaction is controlled by HW</description>
                <bitRange>[8:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_usb_ep0_sw_addr</name>
                <description>EP0 address (SW control mode)</description>
                <bitRange>[15:9]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_usb_ep0_sw_size</name>
                <description>EP0 transfer size (SW control mode)</description>
                <bitRange>[23:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_usb_ep0_sw_stall</name>
                <description>EP0 stall response (SW control mode)
Note: Should NOT enable both ep0_sw_nack_in/out and ep0_sw_stall at the same time</description>
                <bitRange>[24:24]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_usb_ep0_sw_nack_in</name>
                <description>EP0 IN transaction nack response (SW control mode)
Note: Should NOT enable both ep0_sw_nack_in and ep0_sw_stall at the same time</description>
                <bitRange>[25:25]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_usb_ep0_sw_nack_out</name>
                <description>EP0 OUT/SETUP transaction nack response (SW control mode)
Note: Should NOT enable both ep0_sw_nack_out and ep0_sw_stall at the same time</description>
                <bitRange>[26:26]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_usb_ep0_sw_rdy</name>
                <description>EP0 transaction ready. When NACK is enabled, asserting this bit will allow one packet to be transferred even if NACK is asserted</description>
                <bitRange>[27:27]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>sts_usb_ep0_sw_rdy</name>
                <description>EP0 transaction ready status bit. Asserted with sw_rdy, and de-asserted when ACK is sent/received.</description>
                <bitRange>[28:28]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>usb_lpm_config</name>
            <description>usb_lpm_config</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000008</resetValue>
            <resetMask>0x000FFFFF</resetMask>
            <fields>
              <field>
                <name>cr_lpm_en</name>
                <description>LPM enable signal</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_lpm_resp_upd</name>
                <description>Response update signal (for async concern)
Assert this bit when cr_lpm_resp is updated</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_lpm_resp</name>
                <description>Response when LPM packet is received
2'd3: NYET
2'd2: STALL
2'd1: NACK
2'd0: ACK</description>
                <bitRange>[3:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>sts_lpm_attr</name>
                <description>LPM attributes received in LPM packet</description>
                <bitRange>[30:20]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>sts_lpm</name>
                <description>LPM status bit</description>
                <bitRange>[31:31]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>usb_resume_config</name>
            <description>usb_resume_config</description>
            <addressOffset>0x8</addressOffset>
