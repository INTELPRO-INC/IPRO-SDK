            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_utx_rs485_en</name>
                <description>Enable signal for RS-485 transceiver mode
1'b0: Disabled, normal UART
1'b1: Enabled, IO is connected to RS-485 transceiver and RTS_O becomes DE function</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_utx_rs485_pol</name>
                <description>DE pin polarity in RS-485 transceiver mode
1'b0: DE is active-low
1'b1: DE is active-high</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>uart_fifo_config_0</name>
