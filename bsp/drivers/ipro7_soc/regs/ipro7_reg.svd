              </field>
              <field>
                <name>i2c_txf_int</name>
                <description>I2C TX FIFO ready (tx_fifo_cnt &gt; tx_fifo_th) interrupt, auto-cleared when data is pushed</description>
                <bitRange>[1:1]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>i2c_rxf_int</name>
                <description>I2C RX FIFO ready (rx_fifo_cnt &gt; rx_fifo_th) interrupt, auto-cleared when data is popped</description>
                <bitRange>[2:2]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>i2c_nak_int</name>
                <description>I2C NACK-received interrupt</description>
                <bitRange>[3:3]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>i2c_arb_int</name>
                <description>I2C arbitration lost interrupt</description>
                <bitRange>[4:4]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>i2c_fer_int</name>
                <description>I2C TX/RX FIFO error interrupt, auto-cleared when FIFO overflow/underflow error flag is cleared</description>
                <bitRange>[5:5]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>cr_i2c_end_mask</name>
                <description>Interrupt mask of i2c_end_int</description>
                <bitRange>[8:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_txf_mask</name>
                <description>Interrupt mask of i2c_txf_int</description>
                <bitRange>[9:9]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_rxf_mask</name>
                <description>Interrupt mask of i2c_rxf_int</description>
                <bitRange>[10:10]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_nak_mask</name>
                <description>Interrupt mask of i2c_nak_int</description>
                <bitRange>[11:11]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_arb_mask</name>
                <description>Interrupt mask of i2c_arb_int</description>
                <bitRange>[12:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_fer_mask</name>
                <description>Interrupt mask of i2c_fer_int</description>
                <bitRange>[13:13]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_end_clr</name>
                <description>Interrupt clear of i2c_end_int</description>
                <bitRange>[16:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_nak_clr</name>
                <description>Interrupt clear of i2c_nak_int</description>
                <bitRange>[19:19]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_arb_clr</name>
                <description>Interrupt clear of i2c_arb_int</description>
                <bitRange>[20:20]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_end_en</name>
                <description>Interrupt enable of i2c_end_int</description>
                <bitRange>[24:24]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_txf_en</name>
                <description>Interrupt enable of i2c_txf_int</description>
                <bitRange>[25:25]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_rxf_en</name>
                <description>Interrupt enable of i2c_rxf_int</description>
                <bitRange>[26:26]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_nak_en</name>
                <description>Interrupt enable of i2c_nak_int</description>
                <bitRange>[27:27]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_arb_en</name>
                <description>Interrupt enable of i2c_arb_int</description>
                <bitRange>[28:28]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_fer_en</name>
                <description>Interrupt enable of i2c_fer_int</description>
                <bitRange>[29:29]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>i2c_sub_addr</name>
            <description>i2c_sub_addr</description>
            <addressOffset>0x8</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_i2c_sub_addr_b0</name>
                <description>I2C sub-address field - byte[0] (sub-address starts from this byte)</description>
                <bitRange>[7:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_sub_addr_b1</name>
                <description>I2C sub-address field - byte[1]</description>
                <bitRange>[15:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_sub_addr_b2</name>
                <description>I2C sub-address field - byte[2]</description>
                <bitRange>[23:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_sub_addr_b3</name>
                <description>I2C sub-address field - byte[3]</description>
                <bitRange>[31:24]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>i2c_bus_busy</name>
            <description>i2c_bus_busy</description>
            <addressOffset>0xC</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFE</resetMask>
            <fields>
              <field>
                <name>sts_i2c_bus_busy</name>
                <description>Indicator of I2C bus busy</description>
                <bitRange>[0:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>cr_i2c_bus_busy_clr</name>
                <description>Clear signal of bus_busy status, not for normal usage (in case I2C bus hangs)</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>i2c_prd_start</name>
            <description>i2c_prd_start</description>
            <addressOffset>0x10</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0F0F0F0F</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_i2c_prd_s_ph_0</name>
                <description>Length of START condition phase 0</description>
                <bitRange>[7:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_prd_s_ph_1</name>
                <description>Length of START condition phase 1</description>
                <bitRange>[15:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_prd_s_ph_2</name>
                <description>Length of START condition phase 2</description>
                <bitRange>[23:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_prd_s_ph_3</name>
                <description>Length of START condition phase 3</description>
                <bitRange>[31:24]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>i2c_prd_stop</name>
            <description>i2c_prd_stop</description>
            <addressOffset>0x14</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0F0F0F0F</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_i2c_prd_p_ph_0</name>
                <description>Length of STOP condition phase 0</description>
                <bitRange>[7:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_prd_p_ph_1</name>
                <description>Length of STOP condition phase 1</description>
                <bitRange>[15:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_prd_p_ph_2</name>
                <description>Length of STOP condition phase 2</description>
                <bitRange>[23:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_prd_p_ph_3</name>
                <description>Length of STOP condition phase 3</description>
                <bitRange>[31:24]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>i2c_prd_data</name>
            <description>i2c_prd_data</description>
            <addressOffset>0x18</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0F0F0F0F</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_i2c_prd_d_ph_0</name>
                <description>Length of DATA phase 0</description>
                <bitRange>[7:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_prd_d_ph_1</name>
                <description>Length of DATA phase 1
Note: This value should not be set to 8'd0, adjust source clock rate instead if higher I2C clock rate is required</description>
                <bitRange>[15:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_prd_d_ph_2</name>
                <description>Length of DATA phase 2</description>
                <bitRange>[23:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_prd_d_ph_3</name>
                <description>Length of DATA phase 3</description>
                <bitRange>[31:24]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>i2c_fifo_config_0</name>
            <description>i2c_fifo_config_0</description>
            <addressOffset>0x80</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFF0F</resetMask>
            <fields>
              <field>
                <name>i2c_dma_tx_en</name>
                <description>Enable signal of dma_tx_req/ack interface</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>i2c_dma_rx_en</name>
                <description>Enable signal of dma_rx_req/ack interface</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>tx_fifo_clr</name>
                <description>Clear signal of TX FIFO</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>rx_fifo_clr</name>
                <description>Clear signal of RX FIFO</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>tx_fifo_overflow</name>
                <description>Overflow flag of TX FIFO, can be cleared by tx_fifo_clr</description>
                <bitRange>[4:4]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>tx_fifo_underflow</name>
                <description>Underflow flag of TX FIFO, can be cleared by tx_fifo_clr</description>
                <bitRange>[5:5]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>rx_fifo_overflow</name>
                <description>Overflow flag of RX FIFO, can be cleared by rx_fifo_clr</description>
                <bitRange>[6:6]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>rx_fifo_underflow</name>
                <description>Underflow flag of RX FIFO, can be cleared by rx_fifo_clr</description>
                <bitRange>[7:7]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>i2c_fifo_config_1</name>
            <description>i2c_fifo_config_1</description>
            <addressOffset>0x84</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000002</resetValue>
            <resetMask>0xFFFFFCFC</resetMask>
            <fields>
              <field>
                <name>tx_fifo_cnt</name>
                <description>TX FIFO available count</description>
                <bitRange>[1:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>rx_fifo_cnt</name>
                <description>RX FIFO available count</description>
                <bitRange>[9:8]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>tx_fifo_th</name>
                <description>TX FIFO threshold, dma_tx_req will not be asserted if tx_fifo_cnt is less than this value</description>
                <bitRange>[16:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>rx_fifo_th</name>
                <description>RX FIFO threshold, dma_rx_req will not be asserted if rx_fifo_cnt is less than this value</description>
                <bitRange>[24:24]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>i2c_fifo_wdata</name>
            <description>i2c_fifo_wdata</description>
            <addressOffset>0x88</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>i2c_fifo_wdata</name>
