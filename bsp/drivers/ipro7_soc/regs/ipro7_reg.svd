                <description>Destination transfer width: 
2'b00 : byte
2'b01 : half-word
2'b10 : word
2'b11 : double-word</description>
                <bitRange>[22:21]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>fix_cnt</name>
                <description>Only effect when dst_min_mode = 1
Destination transfer cnt = (total src byte cnt - (fix_cnt&lt;&lt;DWidth))&lt;&lt;DWidth</description>
                <bitRange>[25:23]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>SI</name>
                <description>Source increment. When set, the source address is incremented after each transfer.</description>
                <bitRange>[26:26]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>DI</name>
                <description>Destination increment. When set, the Destination address is incremented after each transfer.</description>
                <bitRange>[27:27]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>Prot</name>
                <description>No use for currently</description>
                <bitRange>[30:28]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>I</name>
                <description>Terminal count interrupt enable bit. It controls whether the current LLI is expected to trigger the terminal count interrupt.</description>
                <bitRange>[31:31]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>DMA_C2Config</name>
            <description>DMA_C2Config</description>
            <addressOffset>0x310</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFDFFFF</resetMask>
            <fields>
              <field>
                <name>E</name>
                <description>None</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>SrcPeripheral</name>
                <description>None</description>
                <bitRange>[5:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>DstPeripheral</name>
                <description>None</description>
                <bitRange>[10:6]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>FlowCntrl</name>
                <description>None</description>
                <bitRange>[13:11]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>IE</name>
                <description>None</description>
                <bitRange>[14:14]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>ITC</name>
                <description>None</description>
                <bitRange>[15:15]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>L</name>
                <description>None</description>
                <bitRange>[16:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>A</name>
                <description>None</description>
                <bitRange>[17:17]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>H</name>
                <description>None</description>
                <bitRange>[18:18]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>DMA_C2RSVD</name>
            <description>DMA_C2RSVD</description>
            <addressOffset>0x31C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>DstRemnSgle</name>
                <description>Destination remain single issue mode</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>SrcRemnSgle</name>
                <description>Source remain single issue mode</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>DMA_C3SrcAddr</name>
            <description>DMA_C3SrcAddr</description>
            <addressOffset>0x400</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>SrcAddr</name>
                <description>None</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>DMA_C3DstAddr</name>
            <description>DMA_C3DstAddr</description>
            <addressOffset>0x404</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>DstAddr</name>
                <description>None</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>DMA_C3LLI</name>
            <description>DMA_C3LLI</description>
            <addressOffset>0x408</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>LLI</name>
                <description>None</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>DMA_C3Control</name>
            <description>DMA_C3Control</description>
            <addressOffset>0x40C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0C489000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>TransferSize</name>
                <description>Transfer size: 0~4095. Number of data transfers left to complete when the SMDMA is the flow controller.</description>
                <bitRange>[11:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>SBSize</name>
                <description>Source burst size: 
2'b00 : INCR1
2'b01 : INCR4
2'b10 : INCR8
2'b11 : INCR16
Note : SBSize*Swidth should &lt;= CH FIFO Size</description>
                <bitRange>[13:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>dst_min_mode</name>
                <description>Minus mode : Not issue all destination traffic</description>
                <bitRange>[14:14]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>DBSize</name>
                <description>Destination burst size
2'b00 : INCR1
2'b01 : INCR4
2'b10 : INCR8
2'b11 : INCR16
Note : SBSize*Swidth should &lt;= CH FIFO Size</description>
                <bitRange>[16:15]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>dst_add_mode</name>
                <description>Add mode : issue remain destination traffic</description>
                <bitRange>[17:17]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>SWidth</name>
                <description>Source transfer width
2'b00 : byte
2'b01 : half-word
2'b10 : word
2'b11 : double-word</description>
                <bitRange>[19:18]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>DWidth</name>
                <description>Destination transfer width: 
2'b00 : byte
2'b01 : half-word
2'b10 : word
2'b11 : double-word</description>
                <bitRange>[22:21]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>fix_cnt</name>
                <description>Only effect when dst_min_mode = 1
Destination transfer cnt = (total src byte cnt - (fix_cnt&lt;&lt;DWidth))&lt;&lt;DWidth</description>
                <bitRange>[25:23]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>SI</name>
                <description>Source increment. When set, the source address is incremented after each transfer.</description>
                <bitRange>[26:26]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>DI</name>
                <description>Destination increment. When set, the Destination address is incremented after each transfer.</description>
                <bitRange>[27:27]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>Prot</name>
                <description>No use for currently</description>
                <bitRange>[30:28]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>I</name>
                <description>Terminal count interrupt enable bit. It controls whether the current LLI is expected to trigger the terminal count interrupt.</description>
                <bitRange>[31:31]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>DMA_C3Config</name>
            <description>DMA_C3Config</description>
            <addressOffset>0x410</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFDFFFF</resetMask>
            <fields>
              <field>
                <name>E</name>
                <description>None</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>SrcPeripheral</name>
                <description>None</description>
                <bitRange>[5:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>DstPeripheral</name>
                <description>None</description>
                <bitRange>[10:6]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>FlowCntrl</name>
                <description>None</description>
                <bitRange>[13:11]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>IE</name>
                <description>None</description>
                <bitRange>[14:14]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>ITC</name>
                <description>None</description>
                <bitRange>[15:15]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>L</name>
                <description>None</description>
                <bitRange>[16:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>A</name>
                <description>None</description>
                <bitRange>[17:17]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>H</name>
                <description>None</description>
                <bitRange>[18:18]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>DMA_C3RSVD</name>
            <description>DMA_C3RSVD</description>
            <addressOffset>0x41C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>DstRemnSgle</name>
                <description>Destination remain single issue mode</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>SrcRemnSgle</name>
                <description>Source remain single issue mode</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </registers>
      </peripheral>
      <peripheral>
        <name>EMAC</name>
        <version>1.0</version>
        <description>EMAC</description>
        <groupName>EMAC</groupName>
        <baseAddress>0x30083000</baseAddress>
        <size>32</size>
        <access>read-write</access>
        <addressBlock>
          <offset>0</offset>
          <size>0x1000</size>
          <usage>registers</usage>
        </addressBlock>
        <registers>
          <register>
            <name>MODE</name>
            <description>MODE</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0000A008</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>RXEN</name>
                <description>Receiver enable
0: Receiver is disabled.
1: Receiver is enabled.
If TX_BD_NUM equals 0x80 (all buffer descriptors are used for TX), then the receiver is disabled regardless of RXEN.</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>TXEN</name>
                <description>Transmit enable
0: Transmitter is disabled.
1: Transmitter is enabled.
If TX_BD_NUM equals 0x0 (zero buffer descriptors are used), then the transmitter is disabled regardless of TXEN.</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>NOPRE</name>
                <description>No preamble mode
0: 7-byte preamble will be sent.
1: No preamble will be sent.</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>BRO</name>
                <description>Broadcast address enable
0: Reject all frames containing the broadcast address unless the PRO bit is asserted.
1: Receive all frames containing broadcast address.</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>PRO</name>
                <description>Promiscuous mode enable
0: The destination address is checked before receiving.
1: All frames received regardless of the address.</description>
                <bitRange>[5:5]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>IFG</name>
                <description>Inter frame gap check
0: IFG is verified before each frame be received.
1: All frames are received regardless to IFG requirement.</description>
                <bitRange>[6:6]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>FULLD</name>
                <description>Full duplex
0: Half duplex mode.
1: Full duplex mode.</description>
                <bitRange>[10:10]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>CRCEN</name>
                <description>CRC Enable
0: TX MAC does not append CRC field.
1: TX MAC will append CRC field to every frame.</description>
                <bitRange>[13:13]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>HUGEN</name>
                <description>Huge frames enable
0: The maximum frame length is MAXFL. All additional bytes are dropped.
1: Frame size is not limited by MAXFL and can be up to 64K bytes.</description>
                <bitRange>[14:14]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>PAD</name>
                <description>Padding enable
0: Do not add pads to frames shorter than MINFL.
1: Add pads to short frames, until the length equals MINFL.</description>
                <bitRange>[15:15]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>RECSMALL</name>
                <description>Receive small frame enable
0: Frames smaller than MINFL are ignored.
1: Frames smaller than MINFL are accepted.</description>
                <bitRange>[16:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>RMII_EN</name>
                <description>RMII mode enable
0: MII PHY I/F is used
1: RMII PHY I/F is used</description>
                <bitRange>[17:17]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>INT_SOURCE</name>
            <description>INT_SOURCE</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>TXB</name>
                <description>Transmit buffer
This bit indicates that a buffer has been transmitted. It is cleared by writing 1 to it.
This bit appears only when IRQ bit is set in the Transmit Buffer Descriptor.</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>TXE</name>
                <description>Transmit error
This bit indicates that a buffer was not transmitted due to a transmit error (underrun,
retransmission limit, late collision, bus error or defer timeout). It is cleared by writing 1 to it.
This bit appears only when IRQ bit is set in the Transmit Buffer Descriptor.</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>RXB</name>
                <description>Receive frame
This bit indicates that a frame was received. It is cleared by writing 1 to it.
This bit appears only when IRQ bit is set in the Receive Buffer Descriptor.</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>RXE</name>
                <description>Receive error
This bit indicates that an error occurred while receiving data (overrun, receiver error, dribble
nibble, too long, &gt;64K, CRC error, bus error or late collision. It is cleared by writing 1 to it.
This bit appears only when IRQ bit is set in the Receive Buffer Descriptor.</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>BUSY</name>
                <description>Busy
This bit indicates that RX packet is being received and there is no empty buffer descriptor to use. It iscleared by writing 1 to it.
This bit appears regardless to the IRQ bits in the Receive Buffer Descriptor.</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>TXC</name>
                <description>Transmit control frame
This bit indicates that a control frame was transmitted. It is cleared by writing 1 to it.
Bit TXFLOW in the CTRLMODE register must be set to 1 in order to get the TXC bit set.</description>
                <bitRange>[5:5]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>RXC</name>
                <description>Receive control frame
This bit indicates that the control frame was received. It is cleared by writing 1 to it.
Bit RXFLOW in the CTRLMODE register must be set to 1 in order to get the RXC bit set.</description>
                <bitRange>[6:6]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>INT_MASK</name>
            <description>INT_MASK</description>
            <addressOffset>0x8</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0000007F</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>TXB_M</name>
                <description>Transmit buffer mask ENABLE
0: Interrupt is un-masked
1: Interrupt is masked</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>TXE_M</name>
                <description>Transmit error mask ENABLE
0: Interrupt is un-masked
1: Interrupt is masked</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>RXB_M</name>
                <description>Receive frame mask ENABLE
0: Interrupt is un-masked
1: Interrupt is masked</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>RXE_M</name>
                <description>Receive error mask ENABLE
0: Interrupt is un-masked
1: Interrupt is masked</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>BUSY_M</name>
                <description>Busy mask ENABLE
0: Interrupt is un-masked
1: Interrupt is masked</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>TXC_M</name>
                <description>Transmit control frame mask ENABLE
0: Interrupt is un-masked
1: Interrupt is masked</description>
                <bitRange>[5:5]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>RXC_M</name>
                <description>Receive control frame mask ENABLE
0: Interrupt is un-masked
1: Interrupt is masked</description>
                <bitRange>[6:6]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>IPGT</name>
            <description>IPGT</description>
            <addressOffset>0xC</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000018</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>IPGT</name>
                <description>Inter packet gap
The recommended value is 0x18 (24 clock cycles),
which equals 9.6 us for 10 Mbps and 0.96 us for 100 Mbps mode</description>
                <bitRange>[6:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>PACKETLEN</name>
            <description>PACKETLEN</description>
            <addressOffset>0x18</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00400600</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>MAXFL</name>
                <description>Maximum frame length
The maximum Ethernet packet is 1518 bytes long. To support this and to have some additional
space for tags, a default maximum packet length equals to 1536 bytes (0x600).
For bigger packets, you can assert the HUGEN bit or increase the value of MAXFL field.</description>
                <bitRange>[15:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>MINFL</name>
                <description>Minimum frame length
The minimum Ethernet packet is 64 bytes long (0x40).
To receive small packets, assert the RECSMALL bit or change the MINFL value.
To transmit small packets, assert the PAD bit or change the MINFL value.</description>
                <bitRange>[31:16]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>COLLCONFIG</name>
            <description>COLLCONFIG</description>
            <addressOffset>0x1C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x000F003F</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>COLLVALID</name>
                <description>Collision valid
This field specifies a collision time window. A collision that occurs later than the time window
is reported as a "Late Collisions" and transmission of the current packet is aborted.</description>
                <bitRange>[5:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>MAXRET</name>
                <description>Maximum retry
This field specifies the maximum number of consequential retransmission attempts after the collision is detected.
When the maximum number has been reached, the TX MAC reports an error and stops transmitting the current packet.
According to the Ethernet standard, the MAXRET default value is set to 0xf (15).</description>
                <bitRange>[19:16]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>TX_BD_NUM</name>
            <description>TX_BD_NUM</description>
            <addressOffset>0x20</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000040</resetValue>
            <resetMask>0x8080FFFF</resetMask>
            <fields>
              <field>
                <name>TXBDNUM</name>
                <description>TX buffer descriptors (BD) number
Number of TX BD. TX and RX share 128 (0x80) descriptors, so the number of RX BD equals 0x80 - TXBDNUM.
The maximum number of TXBDNUM is 0x80. Values greater then 0x80 cannot be written into this register.</description>
                <bitRange>[7:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>TXBDPTR</name>
                <description>TX buffer descriptors (BD) pointer, pointing at the TXBD currently being used</description>
                <bitRange>[22:16]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>RXBDPTR</name>
                <description>RX buffer descriptors (BD) pointer, pointing at the RXBD currently being used</description>
                <bitRange>[30:24]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>MIIMODE</name>
            <description>MIIMODE</description>
            <addressOffset>0x28</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000064</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>CLKDIV</name>
                <description>Clock divider for Management Data Clock (MDC)
The source clock is bus clock and can be divided by any even number.</description>
                <bitRange>[7:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>MIINOPRE</name>
                <description>No preamble for Management Data (MD)
0: 32-bit preamble will be sent.
1: No preamble will be sent.</description>
                <bitRange>[8:8]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>MIICOMMAND</name>
            <description>MIICOMMAND</description>
            <addressOffset>0x2C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>SCANSTAT</name>
                <description>Scan status, setting this bit to 1 will trigger the command (auto cleared)
Note: [2]/[1]/[0] cannot be asserted at the same time, execute one command at a time</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>RSTAT</name>
                <description>Read status, setting this bit to 1 will trigger the command (auto cleared)
Note: [2]/[1]/[0] cannot be asserted at the same time, execute one command at a time</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>WCTRLDATA</name>
                <description>Write control data, setting this bit to 1 will trigger the command (auto cleared)
Note: [2]/[1]/[0] cannot be asserted at the same time, execute one command at a time</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>MIIADDRESS</name>
            <description>MIIADDRESS</description>
            <addressOffset>0x30</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>FIAD</name>
                <description>PHY Address</description>
                <bitRange>[4:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>RGAD</name>
                <description>Register Address</description>
                <bitRange>[12:8]</bitRange>
                <access>read-write</access>
