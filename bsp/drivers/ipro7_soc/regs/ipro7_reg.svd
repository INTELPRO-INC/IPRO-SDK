            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_i2s_txd_inv</name>
                <description>Inverse TXD signal
0: No inverse, 1: Inverse</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2s_rxd_inv</name>
                <description>Inverse RXD signal
0: No inverse, 1: Inverse</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2s_fs_inv</name>
                <description>Inverse FS signal
0: No inverse, 1: Inverse</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2s_bclk_inv</name>
                <description>Inverse BCLK signal
0: No inverse, 1: Inverse</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_deg_cnt</name>
                <description>Deglitch cycle count (unit: cycle of I2S kernel clock)
3'd0: 1 cycle
3'd1: 2 cycles
&#8230;</description>
                <bitRange>[6:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_deg_en</name>
                <description>Deglitch enable (for all th input pins)
1'b0: Disabled, 1'b1: Enabled</description>
                <bitRange>[7:7]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </registers>
      </peripheral>
