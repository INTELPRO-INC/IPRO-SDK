      </peripheral>
      <peripheral>
        <name>IR</name>
        <version>1.0</version>
        <description>IR</description>
        <groupName>IR</groupName>
        <baseAddress>0x30011000</baseAddress>
        <size>32</size>
        <access>read-write</access>
        <addressBlock>
          <offset>0</offset>
          <size>0x1000</size>
          <usage>registers</usage>
        </addressBlock>
        <registers>
          <register>
            <name>irtx_config</name>
            <description>irtx_config</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x001F0510</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_irtx_en</name>
                <description>Enable signal of IRTX function
Asserting this bit will trigger the transaction, and should be de-asserted after finish</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_irtx_out_inv</name>
                <description>Output inverse signal
1'b0: Output stays at Low during idle state
1'b1: Output stays at High during idle state</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_irtx_mod_en</name>
                <description>Enable signal of output modulation</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_irtx_swm_en</name>
                <description>Enable signal of IRTX Software Mode (SWM)</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_irtx_data_en</name>
                <description>Enable signal of data phase (Don't care if SWM or FRM is enabled)</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_irtx_logic0_hl_inv</name>
                <description>Logic 0 H/L inverse signal (Don't care if SWM is enabled)
0: Phase 0 is High (Active), phase 1 is Low (Idle) (H -&gt; L)
1: Phase 0 is Low (Idle), phase 1 is High (Active) (L -&gt; H)</description>
                <bitRange>[5:5]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_irtx_logic1_hl_inv</name>
                <description>Logic 1 H/L inverse signal (Don't care if SWM is enabled)
0: Phase 0 is High (Active), phase 1 is Low (Idle) (H -&gt; L)
1: Phase 0 is Low (Idle), phase 1 is High (Active) (L -&gt; H)</description>
                <bitRange>[6:6]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_irtx_head_en</name>
                <description>Enable signal of head pulse (Don't care if SWM or FRM is enabled)</description>
                <bitRange>[8:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_irtx_head_hl_inv</name>
                <description>Tail pulse H/L inverse signal (Don't care if SWM or FRM is enabled)
0: Phase 0 is High (Active), phase 1 is Low (Idle) (H -&gt; L)
1: Phase 0 is Low (Idle), phase 1 is High (Active) (L -&gt; H)</description>
                <bitRange>[9:9]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_irtx_tail_en</name>
                <description>Enable signal of tail pulse (Don't care if SWM or FRM is enabled)</description>
                <bitRange>[10:10]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_irtx_tail_hl_inv</name>
                <description>Tail pulse H/L inverse signal (Don't care if SWM or FRM is enabled)
0: Phase 0 is High (Active), phase 1 is Low (Idle) (H -&gt; L)
1: Phase 0 is Low (Idle), phase 1 is High (Active) (L -&gt; H)</description>
                <bitRange>[11:11]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_irtx_frm_en</name>
                <description>Enable signal of IRTX freerun mode (Don't care if SWM is enabled)
Note: HEAD/TAIL is disabled in freerun mode</description>
                <bitRange>[12:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_irtx_frm_cont_en</name>
                <description>Enable signal of IRTX freerun continuous mode
0: Disabled, each data frame is separated by an idle time (tail_ph0_w+1 + tail_ph1_w+1)*pw_unit
1: Enabled, data continuously sent without interval (if FIFO data is valid)</description>
                <bitRange>[13:13]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_irtx_frm_frame_size</name>
                <description>IRTX freerun mode frame size (also the valid width for each FIFO entry)
2'd0: 8-bit
2'd1: 16-bit
2'd2: 24-bit
2'd3: 32-bit</description>
                <bitRange>[15:14]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_irtx_data_num</name>
                <description>Bit count of Data phase (unit: bit / PW for normal / SWM)
(Don't-care if cr_irtx_frm_en is enabled)</description>
                <bitRange>[22:16]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>irtx_int_sts</name>
