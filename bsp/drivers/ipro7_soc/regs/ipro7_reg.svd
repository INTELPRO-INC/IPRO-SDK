                <bitRange>[3:3]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>nbr_result_fp_idx</name>
                <description>NBR table index if nbr_result_fp_valid is 1 </description>
                <bitRange>[10:4]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>nbr_search_done</name>
                <description>0: NBR search busy
1: NBR search done</description>
                <bitRange>[11:11]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>rx_tx_transition_time_cnt</name>
