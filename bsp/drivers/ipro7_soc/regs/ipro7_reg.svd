                <bitRange>[17:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>fbdv_stg_sel</name>
                <description>0: select sample clock from fbdv_ratio,&#160; 1: select sample clock from sel_sample_clk</description>
