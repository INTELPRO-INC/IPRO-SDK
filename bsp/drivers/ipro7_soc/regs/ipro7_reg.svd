          <register>
            <name>i2c_fifo_rdata</name>
            <description>i2c_fifo_rdata</description>
            <addressOffset>0x8C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>
              <field>
                <name>i2c_fifo_rdata</name>
                <description>None</description>
                <bitRange>[31:0]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
        </registers>
      </peripheral>
      <peripheral>
        <name>PWM</name>
        <version>1.0</version>
        <description>PWM</description>
        <groupName>PWM</groupName>
        <baseAddress>0x3000F000</baseAddress>
        <size>32</size>
        <access>read-write</access>
        <addressBlock>
          <offset>0</offset>
          <size>0x1000</size>
          <usage>registers</usage>
        </addressBlock>
        <registers>
          <register>
            <name>pwm_int_config</name>
            <description>pwm_int_config</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFC</resetMask>
            <fields>
              <field>
                <name>pwm_mc0_int_sts</name>
                <description>PWM_MC0 interrupt status (Check pwm_mc0_int_sts for detailed interrupt status)</description>
                <bitRange>[0:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>pwm_mc1_int_sts</name>
                <description>PWM_MC1 interrupt status (Check pwm_mc1_int_sts for detailed interrupt status)</description>
                <bitRange>[1:1]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>pwm_mc0_int_clr</name>
                <description>PWM_MC0 interrupt clear (clear pwm_mc0_int_sts[10:0] all)</description>
                <bitRange>[8:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>pwm_mc1_int_clr</name>
                <description>PWM_MC1 interrupt clear (clear pwm_mc1_int_sts[10:0] all)</description>
                <bitRange>[9:9]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>pwm_mc0_config0</name>
            <description>pwm_mc0_config0</description>
            <addressOffset>0x40</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x10F00000</resetValue>
            <resetMask>0xDFFFFFFF</resetMask>
            <fields>
              <field>
                <name>pwm_clk_div</name>
                <description>PWM clock division</description>
                <bitRange>[15:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>pwm_stop_on_rept</name>
                <description>PWM stopped when rept_int is asserted
1'b0: Disabled, PWM keeps running when rept_int is asserted
1'b1: Enabled, PWM stops when rept_int is asserted. Clear rept_int to restore operation</description>
                <bitRange>[19:19]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>pwm_adc_trg_src</name>
                <description>Select signal of ADC triggering source
4'd0: pwm_ch0l_int (Channel 0 ThresholdL reached)
4'd1: pwm_ch0h_int (Channel 0 ThresholdH reached)
4'd2: pwm_ch1l_int (Channel 1 ThresholdL reached)
4'd3: pwm_ch1h_int (Channel 1 ThresholdH reached)
4'd4: pwm_ch2l_int (Channel 2 ThresholdL reached)
4'd5: pwm_ch2h_int (Channel 2 ThresholdH reached)
4'd6: pwm_ch3l_int (Channel 3 ThresholdL reached)
4'd7: pwm_ch3h_int (Channel 3 ThresholdH reached)
4'd8: pwm_prde_int (Period End reached)
Others: Disabled</description>
                <bitRange>[23:20]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>pwm_sw_break_en</name>
                <description>PWM break enable
1'b0: Disabled, normal operation
1'b1: Enabled, PWM output will be determined by CxPBS/CxNBS</description>
                <bitRange>[24:24]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>pwm_ext_break_en</name>
                <description>PWM external break source enable
1'b0: Disabled, external break signal is masked
1'b1: Enabled, external break signal is effective</description>
                <bitRange>[25:25]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>pwm_ext_break_pl</name>
                <description>PWM external break source polarity
1'b0: Active-LOW
1'b1: Active-HIGH</description>
                <bitRange>[26:26]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>pwm_stop_en</name>
                <description>PWM stop enable</description>
                <bitRange>[27:27]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>pwm_stop_mode</name>
                <description>PWM stop mode, 1'b1 - graceful ; 1'b0 - abrupt</description>
                <bitRange>[28:28]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>pwm_sts_stop</name>
                <description>PWM stop status</description>
                <bitRange>[29:29]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>reg_clk_sel</name>
                <description>PWM clock source select, 2'b00-xclk ; 2'b01-bclk ; others-f32k_clk</description>
                <bitRange>[31:30]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>pwm_mc0_config1</name>
            <description>pwm_mc0_config1</description>
            <addressOffset>0x44</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00FF8888</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>pwm_ch0_pen</name>
                <description>PWM channel 0 positive enable pwm out</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
