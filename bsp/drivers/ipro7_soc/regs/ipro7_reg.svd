bit 1: PAN ID == 16'hFFFF  &amp;&amp;  rx_stack_1st_en == 1
bit 2: PAN ID == rx_pan_id_2nd  &amp;&amp;  rx_stack_2nd_en == 1
bit 3: PAN ID == 16'hFFFF  &amp;&amp;  rx_stack_2nd_en == 1</description>
                <bitRange>[15:12]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
