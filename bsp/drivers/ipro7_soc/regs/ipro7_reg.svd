      <peripheral>
        <name>TSRC</name>
        <version>1.0</version>
        <description>TSRC</description>
        <groupName>TSRC</groupName>
        <baseAddress>0x3004D000</baseAddress>
        <size>32</size>
        <access>read-write</access>
        <addressBlock>
          <offset>0</offset>
          <size>0x1000</size>
          <usage>registers</usage>
        </addressBlock>
        <registers>
          <register>
            <name>config</name>
            <description>config</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x02400000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_enable</name>
                <description>Enable signal</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_axi_en</name>
                <description>Enable signal of axi2dvp function (don't care if cr_snsr_en is enabled)
1'b1: pix_data is from AXI
1'b0: pix_data is fake gradient data</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_mode_cea_861</name>
                <description>Mode select
1'b1: EIA/CEA-861 mode
1'b0: Sensor DVP mode</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_axi_push_mode</name>
                <description>Enable AXI fetch memoy push mode
Effect only when cr_axi_en==1 &amp;&amp; cr_axi_swap_mode==0</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_axi_dvp_data_mode</name>
                <description>AXI2DVP pixel data mode
3'd0 : 16bit mode (YUV422 INTV)
3'd1 : 24bit mode(RGB888)
3'd2 : 16bit extend 24bit (RGB565)
3'd3 : 32bit compress 24bit (RGBA8888)
3'd4 : 8bit mode (YUV400)
3'd5 : 12bit mode</description>
                <bitRange>[18:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_axi_b0_sel</name>
                <description>AXI2DVP Byte0 Selection</description>
                <bitRange>[21:20]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_axi_b1_sel</name>
                <description>AXI2DVP Byte1 Selection</description>
                <bitRange>[23:22]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_axi_b2_sel</name>
                <description>AXI2DVP Byte2 Selection</description>
                <bitRange>[25:24]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>frame_size_h</name>
            <description>frame_size_h</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x01170897</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_total_h</name>
                <description>Horizontal total pixel count</description>
                <bitRange>[15:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_blank_h</name>
                <description>Horizontal blank stage pixel count</description>
                <bitRange>[31:16]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>frame_size_v</name>
            <description>frame_size_v</description>
            <addressOffset>0x8</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x002C0464</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_total_v</name>
                <description>Vertical total pixel count</description>
                <bitRange>[15:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_blank_v</name>
                <description>Vertical blank stage pixel count</description>
                <bitRange>[31:16]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>frame_size_cea_861</name>
            <description>frame_size_cea_861</description>
            <addressOffset>0xC</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x03085783</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_h_duration</name>
                <description>HSYNC end position, relative to blank start position (for CEA-861 mode only)</description>
                <bitRange>[7:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_h_placement</name>
                <description>HSYNC start position, relative to blank start position (for CEA-861 mode only)</description>
                <bitRange>[15:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_v_duration</name>
                <description>VSYNC end position, relative to blank start position (for CEA-861 mode only)</description>
                <bitRange>[23:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_v_placement</name>
                <description>VSYNC start position, relative to blank start position (for CEA-861 mode only)</description>
                <bitRange>[31:24]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>pix_data_range</name>
            <description>pix_data_range</description>
            <addressOffset>0x10</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0xFFFF0000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_data_min</name>
                <description>Mininum data value of fake gradient data (don't care if pix_data is not the fake gradient)</description>
                <bitRange>[15:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_data_max</name>
                <description>Maximum data value of fake gradient data (don't care if pix_data is not the fake gradient)</description>
                <bitRange>[31:16]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>pix_data_step</name>
            <description>pix_data_step</description>
            <addressOffset>0x14</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000001</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_data_step</name>
                <description>Data step value for each line of fake gradient data (don't care if pix_data is not the fake gradient)</description>
                <bitRange>[7:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>axi_push_mode</name>
            <description>axi_push_mode</description>
            <addressOffset>0x18</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFE0FF</resetMask>
            <fields>
              <field>
                <name>cr_sw_shd</name>
                <description>Soft force shadow (Must set once before enable)</description>
                <bitRange>[0:0]</bitRange>
                <access>write-only</access>
              </field>
              <field>
                <name>cr_axi_frame_push</name>
                <description>Frame push for axi frame push mode</description>
                <bitRange>[3:3]</bitRange>
                <access>write-only</access>
              </field>
              <field>
                <name>cr_axi_drain_err_clr</name>
                <description>axi2dvp drain_error clear signal</description>
                <bitRange>[4:4]</bitRange>
                <access>write-only</access>
              </field>
              <field>
                <name>st_axi_frame_remain_cnt</name>
                <description>Frame remain count for axi frame push mode</description>
                <bitRange>[12:8]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>axi2dvp_setting</name>
            <description>axi2dvp_setting</description>
            <addressOffset>0x20</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000003</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_axi_xlen</name>
                <description>burst length setting 
3'd0 - Single / 3'd1 - INCR4 / 3'd2 - INCR8
3'd3 - INCR16 / 3'd5 - INCR32 / 3'd6 - INCR64</description>
                <bitRange>[2:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_qos_sw_mode</name>
                <description>AXI QoS software mode enable</description>
                <bitRange>[10:10]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_qos_sw</name>
                <description>AXI Qos software mode value</description>
                <bitRange>[11:11]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>axi2dvp_start_addr_by</name>
            <description>axi2dvp_start_addr_by</description>
            <addressOffset>0x24</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_axi_start_addr_by</name>
                <description>axi2dvp start address for Bayer or Y-planar (also frame 0 of swap mode)</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>axi2dvp_frame_info1</name>
            <description>axi2dvp_frame_info1</description>
            <addressOffset>0x28</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x05100120</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_frame_width_x8</name>
                <description>Frame real write width / 8 (unit - byte)</description>
                <bitRange>[13:0]</bitRange>
                <access>read-write</access>
              </field>
