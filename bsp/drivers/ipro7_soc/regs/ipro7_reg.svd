                <bitRange>[13:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>obnd_order_bu</name>
                <description>Order blue or u of blend data. Range:0~3</description>
                <bitRange>[15:14]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>obnd_global_a_en</name>
                <description>Enable global alpha</description>
                <bitRange>[16:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>obnd_global_a</name>
                <description>Global alpha. Range:0~255</description>
                <bitRange>[31:24]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
