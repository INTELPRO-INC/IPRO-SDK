      <peripheral>
        <name>GPIP</name>
        <version>1.0</version>
        <description>GPIP</description>
        <groupName>GPIP</groupName>
        <baseAddress>0x30004000</baseAddress>
        <size>32</size>
        <access>read-write</access>
        <addressBlock>
          <offset>0</offset>
          <size>0x1000</size>
          <usage>registers</usage>
        </addressBlock>
        <registers>
          <register>
            <name>gpadc_config</name>
            <description>gpadc_config</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00008000</resetValue>
            <resetMask>0xFFC0FF03</resetMask>
            <fields>
              <field>
                <name>gpadc_dma_en</name>
                <description>GPADC DMA enbale</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_fifo_clr</name>
                <description>FIFO clear signal</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_fifo_ne</name>
                <description>FIFO not empty flag</description>
                <bitRange>[2:2]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>gpadc_fifo_full</name>
                <description>FIFO full flag</description>
                <bitRange>[3:3]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>gpadc_rdy</name>
                <description>Conversion data ready interrupt flag</description>
                <bitRange>[4:4]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>gpadc_fifo_overrun</name>
                <description>FIFO overrun interrupt flag</description>
                <bitRange>[5:5]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>gpadc_fifo_underrun</name>
                <description>FIFO underrun interrupt flag</description>
                <bitRange>[6:6]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>gpadc_fifo_rdy</name>
                <description>FIFO data ready interrupt flag (fifo_data_count &gt;= fifo_thl)</description>
                <bitRange>[7:7]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>gpadc_rdy_clr</name>
                <description>Write 1 to clear flag</description>
                <bitRange>[8:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_fifo_overrun_clr</name>
                <description>Write 1 to clear flag</description>
                <bitRange>[9:9]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_fifo_underrun_clr</name>
                <description>Write 1 to clear flag</description>
                <bitRange>[10:10]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_rdy_mask</name>
                <description>write 1 mask</description>
                <bitRange>[12:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_fifo_overrun_mask</name>
                <description>write 1 mask</description>
                <bitRange>[13:13]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_fifo_underrun_mask</name>
                <description>write 1 mask</description>
                <bitRange>[14:14]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_fifo_rdy_mask</name>
                <description>write 1 mask</description>
                <bitRange>[15:15]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_fifo_data_count</name>
                <description>fifo data number</description>
                <bitRange>[21:16]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>gpadc_fifo_thl</name>
                <description>fifo threshold
2'b00: 1 data 
2'b01: 4 data 
2'b10: 8 data
2'b11: 16 data</description>
                <bitRange>[23:22]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>gpadc_dma_rdata</name>
            <description>gpadc_dma_rdata</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFC000000</resetMask>
            <fields>
              <field>
                <name>gpadc_dma_rdata</name>
                <description>GPADC finial conversion result stored in the FIFO</description>
                <bitRange>[25:0]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>gpadc_pir_train</name>
            <description>gpadc_pir_train</description>
            <addressOffset>0x20</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0000000F</resetValue>
            <resetMask>0xFFFDE0FF</resetMask>
            <fields>
              <field>
                <name>pir_extend</name>
                <description>GPADC Record Extension after PIR interrupt</description>
                <bitRange>[4:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>pir_cnt_v</name>
                <description>GPADC Record Extension Counter Value</description>
                <bitRange>[12:8]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>pir_train</name>
                <description>PIR Training Mode</description>
                <bitRange>[16:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>pir_stop</name>
                <description>PIR Training End</description>
                <bitRange>[17:17]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>gpdac_config</name>
            <description>gpdac_config</description>
            <addressOffset>0x40</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0D000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>gpdac_en</name>
                <description>GPDAC enable</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpdac_mode</name>
                <description>0:32k, 1:16k, 3:8k,  4:512k(for DMA only)</description>
                <bitRange>[10:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpdac_ch_a_sel</name>
                <description>Channel A Source Select
0: Reg
1: DMA
2: DMA + Filter
3: Sin Gen</description>
                <bitRange>[19:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpdac_ch_b_sel</name>
                <description>Channel B Source Select
0: Reg
1: DMA
2: DMA + Filter
3: Sin Gen
4: A (The same as channel A)
5: ~A (Inverse of channel A)</description>
                <bitRange>[23:20]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>gpdac_dma_config</name>
            <description>gpdac_dma_config</description>
            <addressOffset>0x44</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>gpdac_dma_tx_en</name>
                <description>GPDAC DMA TX enable</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpdac_dma_inv_msb</name>
                <description>GPDAC DMA Data Inverse MSB</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpdac_dma_format</name>
                <description>DMA TX format (Data 10-bit)
0: ([9:0]) {A0}, {A1}, {A2}&#8230;
1: ([25:16][9:0]) {B0,A0}, {B1,A1}, {B2,A2}&#8230;
2: ([25:16][9:0]) {A1,A0}, {A3,A2}, {A5,A4}&#8230;
4: ([15:6]) {A0}, {A1}, {A2}&#8230;
5: ([31:22][15:6]) {B0,A0}, {B1,A1}, {B2,A2}&#8230;
6: ([31:22][15:6]) {A1,A0}, {A3,A2}, {A5,A4}&#8230;
8: ([31:24][23:16][15:8][7:0]) {A3,A2,A1,A0}, {A7,A6,A5,A4}&#8230;
9: ([31:24][23:16][15:8][7:0]) {B1,B0,A1,A0}, {B3,B2,A3,A2}&#8230;
10: ([31:24][23:16][15:8][7:0]) {B1,A1,B0,A0}, {B3,A3,B2,A2}&#8230;
11: ([15:8][7:0]) {B0,A0}, {B1,A1}, {B2,A2}&#8230;</description>
                <bitRange>[7:4]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>gpdac_dma_wdata</name>
            <description>gpdac_dma_wdata</description>
            <addressOffset>0x48</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>gpdac_dma_wdata</name>
                <description>GPDAC DMA TX data</description>
                <bitRange>[31:0]</bitRange>
                <access>write-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>gpdac_tx_fifo_status</name>
            <description>gpdac_tx_fifo_status</description>
            <addressOffset>0x4C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000080</resetValue>
            <resetMask>0xFFFFFC00</resetMask>
            <fields>
              <field>
                <name>tx_fifo_empty</name>
                <description>None</description>
                <bitRange>[0:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>tx_fifo_full</name>
                <description>None</description>
                <bitRange>[1:1]</bitRange>
                <access>read-only</access>
              </field>
