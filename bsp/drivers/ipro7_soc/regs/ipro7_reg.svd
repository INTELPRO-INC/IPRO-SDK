                <access>read-write</access>
              </field>
              <field>
                <name>fbdv_dco_dither_clk_sel</name>
                <description>0: co4,&#160;&#160; 1: co3</description>
                <bitRange>[8:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>fbdv_fb_clk_sel</name>
                <description>0: mod1,&#160;&#160; 1: mod1 with pulse width enlarged</description>
                <bitRange>[12:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>fbdv_sample_clk_sel</name>
