                <bitRange>[1:1]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>irtx_fer_int</name>
                <description>IRTX FIFO error interrupt, auto-cleared when FIFO overflow/underflow error flag is cleared</description>
                <bitRange>[2:2]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>cr_irtx_end_mask</name>
                <description>Interrupt mask of irtx_end_int</description>
