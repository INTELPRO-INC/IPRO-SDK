      <peripheral>
        <name>MJCOMBO</name>
        <version>1.0</version>
        <description>MJCOMBO</description>
        <groupName>MJCOMBO</groupName>
        <baseAddress>0x30049000</baseAddress>
        <size>32</size>
        <access>read-write</access>
        <addressBlock>
          <offset>0</offset>
          <size>0x1000</size>
          <usage>registers</usage>
        </addressBlock>
        <registers>
          <register>
            <name>share_csr_0</name>
            <description>share_csr_0</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000304</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>reg_mjcomb_mode</name>
                <description>MJPEG Mode
1'b0 - Encode mode
1'b1 - Decode mode</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>reg_mjcomb_enable</name>
                <description>MJPEG enable</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>reg_order_u_even</name>
                <description>1'b0 - U is odd byte of UV frame / V is even byte of UV frame
1'b1 - U is even byte of UV frame / V is odd byte of UV frame</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>reg_swap_mode</name>
                <description>ENC : Bitstream write swap mode
JDEC YUV Memory swap mode</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>reg_last_hf_wblk_dmy</name>
                <description>MJPEG last half horizational block with dummy data 8'h80</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>reg_last_hf_hblk_dmy</name>
                <description>MJPEG last half vertical block with dummy data 8'h80</description>
                <bitRange>[5:5]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>reg_w_xlen</name>
                <description>AXI burst length setting 
3'd0-Single / 3'd1-INCR4 / 3'd2-INCR8
3'd3 - INCR16 / Others - RSVD</description>
                <bitRange>[10:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>reg_yuv_mode</name>
                <description>YUV format setting
3'd0 : YUV420 Semi-Planar
3'd1 : YUV400 grey scale
3'd2 : YUV422 Semi-Planar
3'd3 : INTV422 (Only for JENC)
3'd4 : YUV420 Block mode (Only for JENC)
others : Reserved</description>
                <bitRange>[14:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>reg_frame_cnt_trgr_int</name>
                <description>Frame threshold to issue interrupt</description>
                <bitRange>[20:16]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>share_csr_1</name>
            <description>share_csr_1</description>
            <addressOffset>0x08</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x80000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>reg_yy_addr_start</name>
