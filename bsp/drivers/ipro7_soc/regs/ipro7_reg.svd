                <access>read-write</access>
              </field>
              <field>
                <name>spl_mode</name>
                <description>spl option  0: Stop sample if rpt_rdy  1: Continue sample</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>rpt_mode</name>
                <description>rpt option  0: Count time only if sample change  1: Continue time</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>input_swap</name>
                <description>input a/b swap</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>led_period</name>
                <description>Period in us the LED is switched on prior to sampling</description>
                <bitRange>[24:16]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>qdec2_value</name>
            <description>qdec2_value</description>
            <addressOffset>0x88</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xCFF00000</resetMask>
            <fields>
              <field>
                <name>acc1_val</name>
                <description>Sample accumulation (-1024~1023)</description>
                <bitRange>[15:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>acc2_val</name>
                <description>Double error accumulation (0~15)</description>
                <bitRange>[19:16]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>spl_val</name>
                <description>Sample value. Direction of last change
00: no change
01: clockwise
11: counter-clockwise
10: Error</description>
                <bitRange>[29:28]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>qdec2_int_en</name>
            <description>qdec2_int_en</description>
            <addressOffset>0x90</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000001</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>rpt_rdy_en</name>
                <description>None</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>spl_rdy_en</name>
                <description>None</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>dbl_rdy_en</name>
                <description>None</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>overflow_en</name>
                <description>None</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>qdec2_int_sts</name>
            <description>qdec2_int_sts</description>
            <addressOffset>0x94</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFF0</resetMask>
            <fields>
              <field>
                <name>rpt_rdy_sts</name>
                <description>Non-null report ready</description>
                <bitRange>[0:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>spl_rdy_sts</name>
                <description>Event being generated for every new sample value written to the SAMPLE register</description>
                <bitRange>[1:1]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>dbl_rdy_sts</name>
                <description>ACC2 double error</description>
                <bitRange>[2:2]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>overflow_sts</name>
                <description>ACC1 or ACC2 overflow</description>
                <bitRange>[3:3]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>qdec2_int_clr</name>
            <description>qdec2_int_clr</description>
            <addressOffset>0x98</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>rpt_rdy_clr</name>
                <description>None</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>spl_rdy_clr</name>
                <description>None</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>dbl_rdy_clr</name>
                <description>None</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>overflow_clr</name>
                <description>None</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </registers>
      </peripheral>
      <peripheral>
        <name>KYS</name>
