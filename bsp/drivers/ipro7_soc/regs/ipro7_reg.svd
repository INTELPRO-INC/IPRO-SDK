                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_scan_pos_3</name>
                <description>definition is the same as adc_reg_cmd.adc_pos_sel</description>
                <bitRange>[19:15]</bitRange>
                <access>read-write</access>
