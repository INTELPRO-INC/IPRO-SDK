              </field>
              <field>
                <name>cr_ep0_in_cmd_en</name>
                <description>Interrupt enable of ep0_in_cmd_int</description>
                <bitRange>[6:6]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_ep0_in_done_en</name>
                <description>Interrupt enable of ep0_in_done_int</description>
