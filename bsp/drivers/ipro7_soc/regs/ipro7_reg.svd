                <access>read-write</access>
              </field>
              <field>
                <name>cfg_cci1_pre_read</name>
                <description>Set 1 to let CCI1 issue AHB Read immediately after address phase
to save timing</description>
                <bitRange>[7:7]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>reg_scci_clk_inv</name>
