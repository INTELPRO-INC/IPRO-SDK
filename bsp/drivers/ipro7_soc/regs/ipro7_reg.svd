            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>lotpm_lfp_delay_sel</name>
                <description>default 1</description>
                <bitRange>[1:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>lotpm_hfp_delay_fmash</name>
                <description>default 2</description>
                <bitRange>[7:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>lotpm_hfp_delay_fref</name>
                <description>default 2</description>
                <bitRange>[9:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>lotpm_hfp_polarity</name>
                <description>1: default, 0: invert output bitwise</description>
                <bitRange>[12:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>lotpm_hfp_mash1_sel</name>
                <description>0: default, 1: use mash1 as hfp mash</description>
                <bitRange>[16:16]</bitRange>
