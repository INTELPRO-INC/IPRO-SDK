                <bitRange>[26:26]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>sram_slp</name>
                <description>SW polling until 0 (default 1'b1 @pwron)</description>
                <bitRange>[27:27]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>hbn_state</name>
                <description>SW polling until 0 (default 4'h3 @pwron)</description>
                <bitRange>[31:28]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
