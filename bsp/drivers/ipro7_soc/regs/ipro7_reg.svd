                <access>read-write</access>
              </field>
              <field>
                <name>lodist_nwell_bias</name>
                <description>0: nwell bias voltage=rvdd;&#160; 3: nwell bias voltage=rvdd-0.3</description>
                <bitRange>[13:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>lodist_75dc_sel</name>
                <description>0: tx clk single output; 1: tx clk differential output</description>
                <bitRange>[16:16]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>fbdv</name>
            <description>fbdv</description>
            <addressOffset>0x244</addressOffset>
            <size>32</size>
