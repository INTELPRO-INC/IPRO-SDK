            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>adpll_lf_vctrl_range_ext</name>
                <description>2'b00: 48~80, 2'b01: 32~96, 2'b10: 16~112, 2'b11: 1~126</description>
                <bitRange>[1:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_lf_lsb_ext</name>
                <description>xternal value of DVAR control word</description>
                <bitRange>[8:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_lf_avg_en</name>
                <description>'1' enable 0.5*(1-z^(-2)) at proportion path</description>
                <bitRange>[9:9]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_lf_f_p3</name>
                <description>can be 0,0.25,0.5,0.75, when it is 0, means turn off the IIR filter</description>
                <bitRange>[11:10]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_lf_beta_fast</name>
                <description>in fast lock state, beta can be enlarge by 2^(beta_fast_sel), could be 0, 1</description>
                <bitRange>[13:13]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_lf_beta_exp</name>
                <description>change the alpha by 2^beta_exp_sel, could be 0, 1, 2, 3, 4, 5</description>
                <bitRange>[16:14]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_lf_beta_base</name>
                <description>0,1,2,3 correspond to gain of 0.625, 0.75, 0.875, 1</description>
                <bitRange>[18:17]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_lf_alpha_fast</name>
                <description>in fast lock state, alpha can be enlarge by 2^(alpha_fast_sel), could be 0, 1, 2, 3</description>
                <bitRange>[21:20]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_lf_alpha_exp</name>
                <description>change the alpha by 2^(2*alpha_exp_sel),could be 0, 1, 2, 3, 4, 5</description>
                <bitRange>[26:24]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_lf_alpha_base</name>
                <description>change the alpha by 2^alpha_base_sel, could be 0, 1</description>
                <bitRange>[27:27]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_lf_ctrl_hw</name>
                <description>None</description>
                <bitRange>[28:28]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>adpll_lf_tx</name>
