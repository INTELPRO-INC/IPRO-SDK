                <access>read-write</access>
              </field>
              <field>
                <name>cr_res_force</name>
                <description>Force to output K-state</description>
                <bitRange>[31:31]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>usb_setup_data_0</name>
