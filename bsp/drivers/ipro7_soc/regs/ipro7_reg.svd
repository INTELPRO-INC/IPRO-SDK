                <bitRange>[9:9]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_irtx_fer_mask</name>
                <description>Interrupt mask of irtx_fer_int</description>
                <bitRange>[10:10]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_irtx_end_clr</name>
                <description>Interrupt clear of irtx_end_int</description>
                <bitRange>[16:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_irtx_end_en</name>
                <description>Interrupt enable of irtx_end_int</description>
                <bitRange>[24:24]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_irtx_frdy_en</name>
                <description>Interrupt enable of irtx_frdy_int</description>
                <bitRange>[25:25]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_irtx_fer_en</name>
                <description>Interrupt enable of irtx_fer_int</description>
                <bitRange>[26:26]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>irtx_pulse_width</name>
            <description>irtx_pulse_width</description>
            <addressOffset>0x10</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x22110464</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_irtx_pw_unit</name>
                <description>Pulse width unit</description>
                <bitRange>[11:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_irtx_mod_ph0_w</name>
                <description>Modulation phase 0 width</description>
                <bitRange>[23:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_irtx_mod_ph1_w</name>
                <description>Modulation phase 1 width</description>
                <bitRange>[31:24]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>irtx_pw_0</name>
            <description>irtx_pw_0</description>
            <addressOffset>0x14</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x02000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_irtx_logic0_ph0_w</name>
                <description>Pulse width of logic0 phase 0 (Don't care if SWM is enabled)</description>
                <bitRange>[7:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_irtx_logic0_ph1_w</name>
                <description>Pulse width of logic0 phase 1 (Don't care if SWM is enabled)</description>
                <bitRange>[15:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_irtx_logic1_ph0_w</name>
                <description>Pulse width of logic1 phase 0 (Don't care if SWM is enabled)</description>
                <bitRange>[23:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_irtx_logic1_ph1_w</name>
                <description>Pulse width of logic1 phase 1 (Don't care if SWM is enabled)</description>
                <bitRange>[31:24]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
