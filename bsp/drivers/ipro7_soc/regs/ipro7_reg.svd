                <bitRange>[24:24]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_adc_clk_inv</name>
                <description>1'b0: non_invert 1'b1: Invert</description>
                <bitRange>[28:28]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_adc_clk_en</name>
                <description>None</description>
                <bitRange>[29:29]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>adpll_dtc</name>
