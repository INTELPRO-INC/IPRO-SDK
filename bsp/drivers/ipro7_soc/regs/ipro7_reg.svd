              <field>
                <name>reg_dvp_enable</name>
                <description>module enable</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>reg_wrap_mode</name>
                <description>DVP2AXI memroy wrap mode enable</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>reg_fram_vld_pol</name>
                <description>Image sensor frame valid polarity, 1'b0 - Activel low, 1'b1 - Active high</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>reg_line_vld_pol</name>
                <description>Image sensor line valid polarity, 1'b0 - Activel low, 1'b1 - Active high</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>reg_xlen</name>
                <description>burst length setting 
3'd0 - Single / 3'd1 - INCR4 / 3'd2 - INCR8
3'd3 - INCR16 / 3'd5 - INCR32 / 3'd6 - INCR64</description>
                <bitRange>[6:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>reg_flip_mode</name>
                <description>DVP2AXI memroy flip mode enable</description>
                <bitRange>[7:7]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>reg_dvp_mode</name>
                <description>Image senosr mode selection: 
3'd0-Vsync&amp;Hsync
3'd1-Vsync|Hsync
3'd2-Vsync
3'd3-Hsync</description>
                <bitRange>[10:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>reg_wrap_addr_start</name>
                <description>1'b1 - Force frame start address to reg_addr_start(0x4)
1'b0 - Do not force&#65292;Frame start address will be calculated from last frame address end</description>
                <bitRange>[11:11]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>reg_drop_en</name>
                <description>Drop mode Enable</description>
                <bitRange>[12:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>reg_drop_even</name>
                <description>Only effect when reg_drop_en=1 : 
1'b1 : Drop all even bytes
1'b0 : Drop all odd bytes</description>
                <bitRange>[13:13]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>reg_qos_sw_mode</name>
                <description>AXI QoS software mode enable</description>
                <bitRange>[14:14]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>reg_qos_sw</name>
                <description>AXI Qos software mode value</description>
                <bitRange>[15:15]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>reg_dvp_data_mode</name>
                <description>DVP 8-bit mode enable
3'd0: DVP pix_data is 16-bit wide
3'd1: DVP pix_data is 24-bit mode
3'd2: DVP pix_data is 24-comp-16-bit mode
3'd3: DVP pix_data is 24-exp-32-bit mode
3'd4: DVP pix_data is 8-bit wide
3'd5: DVP pix_data is 12-bit wide
Others - Reserved</description>
                <bitRange>[18:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>reg_dvp_data_bsel</name>
                <description>Byte select signal for DVP 8-bit mode, don't care if reg_dvp_data_8bit is disabled
1'b0: Select the lower byte of pix_data
1'b1: Select the upper byte of pix_data</description>
                <bitRange>[19:19]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>reg_v_subsample_en</name>
