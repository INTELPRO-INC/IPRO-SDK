            <resetValue>0x00011111</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>fbdv_tpm_clk_sel</name>
                <description>select lotpm mash clock,&#160;&#160; 1: co3, 2: fvco/16, 4: dll output</description>
                <bitRange>[2:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>fbdv_adpll_clk_sel</name>
                <description>0: mod4,&#160;&#160; 1: mod3</description>
