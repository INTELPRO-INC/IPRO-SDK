            <resetValue>0x00110078</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>audadc_pga_chop_cksel</name>
                <description>PGA chopper clock source selection
0 = adc clock        1 = synchronized clock from SDM
not used</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>audadc_pga_chop_freq</name>
                <description>PGA chopper frequency control @Fs=2048k
000 = 8k            001 = 16k        
010 = 32k          011 = 64k
100 = 128k       101 = 256k      
110 = 512k       111 = 1024k</description>
                <bitRange>[3:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>audadc_pga_chop_en</name>
                <description>PGA chopper control
0 = disable        1 = enable  </description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>audadc_pga_chop_cfg</name>
                <description>control chopper for opmic&amp;opaaf
00 = opmic off &amp; opaaf off
01 = opmic off &amp; opaaf on
10 = opmic on &amp; opaaf off
11 = opmic on &amp; opaaf on</description>
                <bitRange>[6:5]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>audadc_pga_rhpas_sel</name>
                <description>PGA high pass filter R control when configured to AC-coupled mode
00 = 480k&#937;
01 = 320k&#937;
10 = 160k&#937;
11 =  4k&#937;, fast startup</description>
                <bitRange>[9:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>audadc_pga_nois_ctrl</name>
                <description>PGA noise control when configured to single-ended
not used</description>
                <bitRange>[13:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>audadc_ictrl_pga_aaf</name>
                <description>PGA_OPAAF bias current control
00 = 4uA          01 = 5uA
10 = 6uA          11 = 7uA</description>
                <bitRange>[17:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>audadc_ictrl_pga_mic</name>
                <description>PGA_OPMIC bias current control
00 = 4uA          01 = 5uA
10 = 6uA          11 = 7uA</description>
                <bitRange>[21:20]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>audadc_pga_lp_en</name>
                <description>PGA lowpower funciton
reversed, not realized in circuit</description>
                <bitRange>[24:24]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>audadc_ckb_en</name>
                <description>AUDADC clock phase control
0 = 0&#176;        1 = 180&#176; </description>
                <bitRange>[28:28]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>audadc_sel_edge</name>
                <description>ADC output data clock edge
0 = falling edge sent, rising edge recieve    
1 = rising edge sent, falling edge recieve </description>
                <bitRange>[29:29]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>audadc_ana_cfg2</name>
            <description>audadc_ana_cfg2</description>
            <addressOffset>0xC64</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0013111C</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>audadc_dither_order</name>
                <description>dither order control for SDM
0 = 0 order        1 = 1 order</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>audadc_dither_sel</name>
                <description>dither level control for SDM
00 = 0                      01 = LSB*1/15
10 =  LSB*2/15      11 =  LSB*3/15</description>
                <bitRange>[2:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>audadc_dither_ena</name>
                <description>dither control
0 = disable        1 = enable</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>audadc_quan_gain</name>
                <description>quantizer gain control for SDM
00 = Vref/14          01 = Vref/12
10 = Vref/10          11 = Vref/8</description>
                <bitRange>[5:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>audadc_dem_en</name>
                <description>dem function control
0 = disable        1 = enable</description>
                <bitRange>[8:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>audadc_nctrl_adc2</name>
