      <peripheral>
        <name>HBN</name>
        <version>1.0</version>
        <description>HBN</description>
        <groupName>HBN</groupName>
        <baseAddress>0x3008F000</baseAddress>
        <size>32</size>
        <access>read-write</access>
        <addressBlock>
          <offset>0</offset>
          <size>0x1000</size>
          <usage>registers</usage>
        </addressBlock>
        <registers>
          <register>
            <name>HBN_CTL</name>
            <description>HBN_CTL</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00D08000</resetValue>
            <resetMask>0x07FFFEFF</resetMask>
            <fields>
              <field>
                <name>rtc_ctl</name>
                <description>[6:4] Slow LED, x/0.25/0.5/1/2/4/8/16 seconds
[3] rtc write mode
[2] rtc short time 0~488s (bit 23~0 compare)
[1] rtc time 0~353days*32 (bit 44~0 compare)
[0] rtc enable</description>
                <bitRange>[3:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>rtc_time_wr</name>
                <description>RTC value writen by hbn_time (hbn_ctl[3]=1)</description>
                <bitRange>[4:4]</bitRange>
                <access>write-only</access>
              </field>
              <field>
                <name>rtc_reset</name>
                <description>RTC value reset</description>
                <bitRange>[5:5]</bitRange>
                <access>write-only</access>
              </field>
              <field>
                <name>hbn_mode</name>
                <description>Enter hibernate</description>
                <bitRange>[7:7]</bitRange>
                <access>write-only</access>
              </field>
              <field>
                <name>trap_mode</name>
                <description>Boot Strap  0: Flash,  1: UART or SDIO</description>
                <bitRange>[8:8]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>pwrdn_hbn_core</name>
                <description>Power Off HBN Core @ Enter hibernate</description>
                <bitRange>[9:9]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>pwrdn_hbn_rtc</name>
                <description>Power Off HBN RTC @ Enter hibernate</description>
                <bitRange>[11:11]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>sw_rst</name>
                <description>soft reset</description>
                <bitRange>[12:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>hbn_dis_pwr_off_ldo11</name>
                <description>Set 1 to disable power off VDDCORE at HBN mode (for debug)</description>
                <bitRange>[13:13]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>hbn_dis_pwr_off_ldo11_rt</name>
                <description>Set 1 to disable power off VDDCORE_RT at HBN mode (for low power)</description>
                <bitRange>[14:14]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>pu_ldo14_aon</name>
                <description>power up ldo14 on power on seq</description>
                <bitRange>[15:15]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>sw_force_ldo14_off</name>
                <description>should only write this bit when hbn_rsvd2[11::0]=CDC</description>
                <bitRange>[16:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>sw_force_dcdc_off</name>
                <description>should only write this bit when hbn_rsvd2[11:0]=CDC</description>
                <bitRange>[17:17]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>hbn_ldo11_aon_vout_sel</name>
