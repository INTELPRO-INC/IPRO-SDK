            <resetValue>0x033E13E8</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>dig_32k_div</name>
                <description>(PLL 32MHz or xclk) / dig_32k_div
Ex: Set 750 for 24MHz ; Set 1000 for 32MHz ; Set 1200 for 38.4MHz ; Set 1250 for 40MHz</description>
                <bitRange>[10:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>dig_32k_en</name>
                <description>Enable dig_32k_out</description>
                <bitRange>[12:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>dig_32k_comp</name>
                <description>Compensation =&gt; Duty of dig_32k_out = dig_32k_div : (dig_32k_div+1)</description>
                <bitRange>[13:13]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>dig_512k_div</name>
                <description>(PLL 32MHz or xclk) / dig_512k_div
Ex: Set 46 for 24MHz ; Set 62 for 32MHz ; Set 75 for 38.4MHz ; Set 78 for 40MHz</description>
                <bitRange>[22:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>dig_512k_en</name>
                <description>Enable dig_512k_out</description>
                <bitRange>[24:24]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>dig_512k_comp</name>
                <description>Compensation =&gt; Duty of dig_512k_out = N : N+1</description>
                <bitRange>[25:25]</bitRange>
                <access>read-write</access>
              </field>
