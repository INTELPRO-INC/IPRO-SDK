          </register>
          <register>
            <name>adpll_vctrl</name>
            <description>adpll_vctrl</description>
            <addressOffset>0x284</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0000104C</resetValue>
            <resetMask>0xFFFFFFF7</resetMask>
            <fields>
              <field>
                <name>sdmout_dly_sel</name>
                <description>select the SDM out delay, for matching the phase cancel path (DTC path) delay</description>
                <bitRange>[1:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_sdm_dith_force_en</name>
                <description>None</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_sdm_dith_force_en_hw</name>
                <description>None</description>
                <bitRange>[3:3]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>sdm_bypass</name>
                <description>bypass fractural part of the divide ratio</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_sdm_noi_dith</name>
                <description>None</description>
                <bitRange>[7:6]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>sdm_dither</name>
                <description>0,1,2,3 for 1/2^17,5/2^17,21/2^17,85/2^17</description>
                <bitRange>[9:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>sdm_order</name>
                <description>0' 1st order, '1' 2rd order</description>
                <bitRange>[12:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_capcode_bypass</name>
                <description>bypass momcap code, set the code by digital register value, software control</description>
                <bitRange>[14:14]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_dco_mash_bypass</name>
                <description>bypass the dco mash1, for debug</description>
                <bitRange>[15:15]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_force_mom_hold</name>
                <description>force momcap code hold, disable the fine tune of momcap</description>
                <bitRange>[16:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_mom_update_period</name>
                <description>00'for adaptive one, '01' 8*Tref, '10' 16*Tref,'11' 31*Tref</description>
                <bitRange>[21:20]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_vctrl_det_cons_en</name>
                <description>1'b1 detect the LF output if it is out of range with consecutive given periods</description>
                <bitRange>[24:24]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_vctrl_moni_win_sel</name>
                <description>'0' for 16~112, '1' for 32~96, decide the lock detect range</description>
                <bitRange>[25:25]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_vctrl_lock_win_sel</name>
                <description>'0' for 48~80, '1' for 32~96, decide the lock detect range</description>
                <bitRange>[26:26]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_vctrl_range_sel_ext_en</name>
                <description>enable external vctrl detector range selection</description>
                <bitRange>[27:27]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>adpll_lms</name>
            <description>adpll_lms</description>
            <addressOffset>0x288</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x140E451C</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>adpll_pha_cancel_delay</name>
                <description>choose the delay on the phase cancel data for delay matching</description>
                <bitRange>[1:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_pha_msb_err_sel</name>
                <description>None</description>
                <bitRange>[3:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_pha_cancel_en</name>
                <description>enable phase error cancellation</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_pha_msb_err_prbs_en</name>
                <description>None</description>
                <bitRange>[5:5]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_lms_q_delay</name>
                <description>choose the delay on the q path of LMS block for delay matching</description>
                <bitRange>[9:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_pha_prbs_sel</name>
                <description>None</description>
                <bitRange>[11:10]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_lms_step_enlarge</name>
                <description>Fast LMS convergence step, '0' for steady_step*2^4, and '1' for 2^5</description>
                <bitRange>[12:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_pha_dither_en</name>
                <description>None</description>
                <bitRange>[13:13]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_pha_dem_en</name>
                <description>None</description>
                <bitRange>[14:14]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_sdm_dither_prbs_en</name>
                <description>None</description>
                <bitRange>[15:15]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_lms_step</name>
                <description>LMS steady state step, '1' for 2^-11, '2' for 2^-9, '3' for 2^-7, '0' for disable LMS</description>
                <bitRange>[17:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_sdm_dither_en_ctrl_hw</name>
                <description>None</description>
                <bitRange>[18:18]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_sdm_dither_en</name>
                <description>None</description>
                <bitRange>[19:19]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_lms_ext_value</name>
                <description>digital register lms coefficient value</description>
                <bitRange>[28:20]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_lms_ext_value_en</name>
                <description>enable external lms coefficient</description>
                <bitRange>[29:29]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_fref_div2_en</name>
                <description>0: 32M, 1:16M</description>
                <bitRange>[31:31]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>adpll_spd</name>
            <description>adpll_spd</description>
            <addressOffset>0x28C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x429AFA45</resetValue>
            <resetMask>0xFFBFFFFF</resetMask>
            <fields>
              <field>
                <name>adpll_spd_in_range_delay</name>
                <description>'0' 128*Tref, '1' 256*Tref, '2' 512*Tref, '3' 1023*Tref, minimum LMS large step induce time</description>
                <bitRange>[1:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_spd_sign_det_cnt</name>
                <description>0,1,2,3 for 16,32,64,127*Tref</description>
                <bitRange>[3:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_spd_out_range_delay</name>
                <description>1'b0: 128*Tref, 1'b1: 255*Fref, gated the SPD un-within given range by N*Tref time</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_spd_outrange_gate_sel</name>
                <description>0 for lms_en = 1,disable the out of range detection. 1 select the fsm_loop_lock</description>
                <bitRange>[5:5]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_spd_sign_det_en</name>
                <description>enable the detection of the coarse and fine path sign</description>
                <bitRange>[6:6]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_spd_in_range_cons</name>
                <description>selecting the consecutive periods of the spd output within the given range, 8,16,32,63 periods</description>
                <bitRange>[9:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_coarse_path_turnoff</name>
                <description>00 for coarse_phaerr detect, 01 for spd_detect, 10 for or, 11 for and</description>
                <bitRange>[11:10]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_spd_threshold</name>
                <description>0,1,2,3 for 0.125,0.1875,0.25,0.375 respectively</description>
                <bitRange>[13:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_coarse_in_range_cons</name>
                <description>0 for 128 cycle, 1 for 256 cycle, 2 for 512, 3 for 1023</description>
                <bitRange>[15:14]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_spd_gain</name>
                <description>0,1,2,3 for 2/2^10, 3/2^10, 4/2^10, 5/2^10, match the adc_ref of 0.3,0.45,0.6,0.75 respectively</description>
                <bitRange>[17:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_coarse_gain</name>
                <description> 0,1,2,3 for gain of 0.25,0.5,0.75,0.75</description>
                <bitRange>[19:18]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_force_lf_fast_mode_ctrl_hw</name>
                <description>enable hardware control</description>
                <bitRange>[20:20]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_force_lf_fast_mode</name>
                <description>force the LF in the fast lock mode, valid when adpll_force_lf_fast_mode_ctrl_hw=0</description>
                <bitRange>[21:21]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_force_lf_fast_mode_hw</name>
                <description>PA ramping controled signal, for VCO pulling</description>
                <bitRange>[22:22]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>adpll_coarse_phaerr_en</name>
                <description>0' disable the coarse path phase error at loop capture procedure</description>
                <bitRange>[23:23]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_coarse_path_offtime_sel</name>
                <description>1'b0: turnoff coarse path at LMS enable, 1'b1: turnoff at switching LMS and LF MODE</description>
                <bitRange>[24:24]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_spd_outrange_dly_sel_ext</name>
                <description>0,1,2,3 for 64,128,192,255*Tref, gated the SPD un-within given range by N*Tref time</description>
                <bitRange>[26:25]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_spd_lms_sstp_win_sel</name>
                <description>select the small_step window, 0 for 63*Tref, 1 for 127*Tref</description>
                <bitRange>[27:27]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_force_coarse_path_on</name>
                <description>force the coarse phase detector path on</description>
                <bitRange>[28:28]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_coarsepha_dly_sel</name>
                <description>select the delay of the coarse phase error path, aviod metastability</description>
                <bitRange>[29:29]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_spd_in_range_delay_1</name>
                <description>'0' 128*Tref, '1' 256*Tref, '2' 512*Tref, '3' 1023*Tref, minimum LMS large step induce time</description>
                <bitRange>[31:30]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>fcal</name>
            <description>fcal</description>
            <addressOffset>0x290</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00801023</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>fcal_div_ratio_adj_en</name>
                <description>1'b1 enable the divide ratio adjust after FCAL or at te locking initial state</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>fcal_coarse_pha_threshold</name>
                <description>0,1,2,3 for thresold of 2 3 4 5</description>
                <bitRange>[2:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>fcal_mom_toggle_cnt</name>
                <description>'0' for 8 consecutive fcal periods, '1' for 13</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>fcal_clk_period</name>
                <description>set the mom_cap search periods, 0,1,2,3 for 7,9,11,13 Tref</description>
                <bitRange>[5:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>fcal_mode</name>
                <description>2'b00: binary search, 2'b01: sequential search, 2'b1x: external mode</description>
                <bitRange>[7:6]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>fcal_phaserr_limit</name>
                <description>1 for 31, 0 for 16, avioding fcal fail at very large frequency error</description>
                <bitRange>[12:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>fcal_mom_ini_ext</name>
                <description>valid when fcal_mom_ini_ctrl_hw=0</description>
                <bitRange>[23:16]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>adpll_polarity</name>
            <description>adpll_polarity</description>
            <addressOffset>0x294</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00101100</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>adpll_lp_mom_polarity</name>
                <description>set lp_mom polarity</description>
                <bitRange>[8:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_lms_polarity</name>
                <description>set lms polarity</description>
                <bitRange>[12:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_fcal_polarity</name>
                <description>if the Kband is negative number, means capbank code increase, the frequency decrease</description>
                <bitRange>[16:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>adpll_lp_polarity</name>
                <description>ajust the spd output sign bit. '1' for positive gain, '0' for negative gain</description>
                <bitRange>[20:20]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>adpll_output</name>
            <description>adpll_output</description>
            <addressOffset>0x298</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFC00004</resetMask>
            <fields>
              <field>
                <name>adpll_unlock_intrpt</name>
                <description>None</description>
                <bitRange>[0:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>adpll_lo_lock</name>
                <description>None</description>
                <bitRange>[1:1]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>adpll_fsm_state</name>
                <description>None</description>
                <bitRange>[6:3]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>adpll_spd_unlock_sign</name>
                <description>None</description>
                <bitRange>[7:7]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>adpll_vctrl_out_range_fsm</name>
                <description>None</description>
                <bitRange>[8:8]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>adpll_mom_update_fail_fsm</name>
                <description>None</description>
                <bitRange>[9:9]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>adpll_mom_update_ou_fsm</name>
                <description>None</description>
                <bitRange>[10:10]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>adpll_spd_unlock_fsm</name>
                <description>None</description>
