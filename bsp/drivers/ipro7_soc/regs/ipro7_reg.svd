                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>aes_mode</name>
                <description>0 : AES Bypass mode : Bypass mode
1 : AES-CTR mode : Counter mode
2 : AES-CBC-MAC mode : Cipher Block Chaining Message Authentication Code mode
3 : AES-CCM mode : Counter with CBC-MAC</description>
                <bitRange>[5:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>aes_key_size</name>
                <description>0 : AES-128
1 : AES-192
2 : AES-256</description>
                <bitRange>[7:6]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
