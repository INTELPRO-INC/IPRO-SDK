                <bitRange>[21:20]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </registers>
      </peripheral>
      <peripheral>
        <name>I2S</name>
        <version>1.0</version>
        <description>I2S</description>
        <groupName>I2S</groupName>
        <baseAddress>0x30017000</baseAddress>
        <size>32</size>
        <access>read-write</access>
        <addressBlock>
          <offset>0</offset>
          <size>0x1000</size>
          <usage>registers</usage>
        </addressBlock>
        <registers>
          <register>
            <name>i2s_config</name>
            <description>i2s_config</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00005000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_i2s_m_en</name>
                <description>Enable signal of I2S Master function, cannot enable both csr_i2s_m_en &amp; csr_i2s_s_en</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2s_s_en</name>
                <description>Enable signal of I2S Slave function, cannot enable both csr_i2s_m_en &amp; csr_i2s_s_en</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2s_txd_en</name>
                <description>Enable signal of I2S TXD signal</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2s_rxd_en</name>
                <description>Enable signal of I2S RXD signal</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_mono_mode</name>
                <description>1'b0: Stereo mode, 1'b1: Mono mode
Note: csr_mono_mode &amp; csr_fifo_lr_merge should NOT be enabled at the same time</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_mute_mode</name>
                <description>1'b0: Normal mode, 1'b1: Mute mode</description>
                <bitRange>[5:5]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_fs_1t_mode</name>
                <description>1'b0: FS high/low is even, 1'b1: FS only asserts for 1 cycle</description>
                <bitRange>[6:6]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_fs_4ch_mode</name>
                <description>1'b0: FS 2-channel mode, 1'b1: FS 4-channel mode (DSP mode only)
Note: cr_fs_3ch_mode &amp; cr_fs_4ch_mode should NOT be enabled at the same time
Note: When 4-channel mode is enabled, frame_size must equal data_size</description>
                <bitRange>[7:7]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_fs_3ch_mode</name>
                <description>1'b0: FS 2-channel mode, 1'b1: FS 3-channel mode (DSP mode only)
Note: cr_fs_3ch_mode &amp; cr_fs_4ch_mode should NOT be enabled at the same time
Note: cr_mono_mode &amp; cr_fifo_lr_merge will be invalid in 3-channel mode
Note: When 3-channel mode is enabled, frame_size must equal data_size</description>
                <bitRange>[8:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_frame_size</name>
                <description>Frame size of each channel
2'd0: 8, 2'd1: 16, 2'd2: 24, 2'd3: 32 (cycles)</description>
                <bitRange>[13:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_data_size</name>
                <description>Data bit width of each channel
2'd0: 8, 2'd1: 16, 2'd2: 24, 2'd3: 32 (bits)</description>
                <bitRange>[15:14]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2s_mode</name>
                <description>2'd0: Left-Justified, 2'd1: Right-Justified, 2'd2: DSP, 2'd3: Reserved</description>
                <bitRange>[17:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_endian</name>
                <description>Data endian (bit reverse)
1'b0: MSB goes out first, 1'b1: LSB goes out first</description>
                <bitRange>[18:18]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_mono_rx_ch</name>
                <description>RX mono mode channel select signal
1'b0: L-channel
1'b1: R-channel</description>
                <bitRange>[19:19]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_ofs_cnt</name>
                <description>Offset cycle count (unit: cycle of I2S BCLK)
5'd0: 1 cycle
5'd1: 2 cycles
&#8230;</description>
                <bitRange>[24:20]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_ofs_en</name>
                <description>Offset enable
1'b0: Disabled, 1'b1: Enabled</description>
                <bitRange>[25:25]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>i2s_int_sts</name>
            <description>i2s_int_sts</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x07000700</resetValue>
            <resetMask>0xFFFFFFF8</resetMask>
            <fields>
              <field>
                <name>i2s_txf_int</name>
                <description>I2S TX FIFO ready (tx_fifo_cnt &gt; tx_fifo_th) interrupt, auto-cleared when data is pushed</description>
                <bitRange>[0:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>i2s_rxf_int</name>
                <description>I2S RX FIFO ready (rx_fifo_cnt &gt; rx_fifo_th) interrupt, auto-cleared when data is popped</description>
                <bitRange>[1:1]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>i2s_fer_int</name>
                <description>I2S TX/RX FIFO error interrupt, auto-cleared when FIFO overflow/underflow error flag is cleared</description>
                <bitRange>[2:2]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>cr_i2s_txf_mask</name>
                <description>Interrupt mask of i2s_txf_int</description>
                <bitRange>[8:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2s_rxf_mask</name>
                <description>Interrupt mask of i2s_rxf_int</description>
                <bitRange>[9:9]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2s_fer_mask</name>
                <description>Interrupt mask of i2s_fer_int</description>
                <bitRange>[10:10]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2s_txf_en</name>
                <description>Interrupt enable of i2s_txf_int</description>
                <bitRange>[24:24]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2s_rxf_en</name>
                <description>Interrupt enable of i2s_rxf_int</description>
                <bitRange>[25:25]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2s_fer_en</name>
                <description>Interrupt enable of i2s_fer_int</description>
                <bitRange>[26:26]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>i2s_bclk_config</name>
            <description>i2s_bclk_config</description>
            <addressOffset>0x10</addressOffset>
