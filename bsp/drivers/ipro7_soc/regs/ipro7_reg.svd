      <peripheral>
        <name>I2C</name>
        <version>1.0</version>
        <description>I2C</description>
        <groupName>I2C</groupName>
        <baseAddress>0x3000E000</baseAddress>
        <size>32</size>
        <access>read-write</access>
        <addressBlock>
          <offset>0</offset>
          <size>0x1000</size>
          <usage>registers</usage>
        </addressBlock>
        <registers>
          <register>
            <name>i2c_config</name>
            <description>i2c_config</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0000000A</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_i2c_m_en</name>
                <description>Enable signal of I2C Master function
Asserting this bit will trigger the transaction, and should be de-asserted after finish</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_pkt_dir</name>
                <description>Transfer direction of the packet
1'b0: Write; 1'b1: Read</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_deg_en</name>
                <description>Enable signal of I2C input de-glitch function (for all input pins)</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_scl_sync_en</name>
                <description>Enable signal of I2C SCL synchronization, should be enabled to support Multi-Master and Clock-Stretching
(Normally should not be turned-off)</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_sub_addr_en</name>
                <description>Enable signal of I2C sub-address field</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_sub_addr_bc</name>
                <description>Sub-address field byte count
2'd0: 1-byte, 2'd1: 2-byte, 2'd2: 3-byte, 2'd3: 4-byte</description>
                <bitRange>[6:5]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_10b_addr_en</name>
                <description>Slave address 10-bit mode enable</description>
                <bitRange>[7:7]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_slv_addr</name>
                <description>Slave address for I2C transaction (target address)</description>
                <bitRange>[17:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_pkt_len</name>
                <description>Packet length (unit: byte)</description>
                <bitRange>[27:20]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_i2c_deg_cnt</name>
                <description>De-glitch function cycle count</description>
                <bitRange>[31:28]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>i2c_int_sts</name>
            <description>i2c_int_sts</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x3F003F02</resetValue>
            <resetMask>0xFFFFFFC0</resetMask>
            <fields>
              <field>
                <name>i2c_end_int</name>
                <description>I2C transfer end interrupt</description>
                <bitRange>[0:0]</bitRange>
