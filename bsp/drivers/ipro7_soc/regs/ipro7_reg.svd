              </field>
              <field>
                <name>adpll_dtc_clk_inv_en</name>
                <description>None</description>
                <bitRange>[12:12]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>lo_fc_config1</name>
