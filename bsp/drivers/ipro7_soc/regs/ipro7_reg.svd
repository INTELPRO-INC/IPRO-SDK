                <bitRange>[27:16]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>i2s_fifo_config_0</name>
            <description>i2s_fifo_config_0</description>
            <addressOffset>0x80</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFF0F</resetMask>
            <fields>
              <field>
                <name>i2s_dma_tx_en</name>
                <description>Enable signal of dma_tx_req/ack interface</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>i2s_dma_rx_en</name>
                <description>Enable signal of dma_rx_req/ack interface</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>tx_fifo_clr</name>
                <description>Clear signal of TX FIFO</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>rx_fifo_clr</name>
                <description>Clear signal of RX FIFO</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>tx_fifo_overflow</name>
                <description>Overflow flag of TX FIFO, can be cleared by tx_fifo_clr</description>
                <bitRange>[4:4]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>tx_fifo_underflow</name>
                <description>Underflow flag of TX FIFO, can be cleared by tx_fifo_clr</description>
                <bitRange>[5:5]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>rx_fifo_overflow</name>
                <description>Overflow flag of RX FIFO, can be cleared by rx_fifo_clr</description>
                <bitRange>[6:6]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>rx_fifo_underflow</name>
                <description>Underflow flag of RX FIFO, can be cleared by rx_fifo_clr</description>
                <bitRange>[7:7]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>cr_fifo_lr_merge</name>
                <description>Each FIFO entry contains both L/R channel data if this bit is enabled
Can only be enabled if data size is 8 or 16 bits
Note: cr_fifo_lr_merge &amp;cr_mono_mode should NOT be enabled at the same time
Note: cr_fifo_lr_merge &amp;cr_fifo_l_shift should NOT be enabled at the same time</description>
                <bitRange>[8:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_fifo_lr_exchg</name>
                <description>The position of L/R channel data within each entry is exchanged if this bit is enabled
Can only be enabled if data size is 8 or 16 bits and csr_fifo_lr_merge is enabled</description>
                <bitRange>[9:9]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_fifo_24b_lj</name>
                <description>FIFO 24-bit data left-justified mode
1'b0: Right-justified, {8'h0, data[23:0]}
1'b1: Left-justified, {data[23:0], 8'h0}
Note: Valid only when cr_data_size = 2'd2 (24-bit)</description>
                <bitRange>[10:10]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>i2s_fifo_config_1</name>
