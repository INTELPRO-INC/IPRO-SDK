                <access>read-only</access>
              </field>
              <field>
                <name>adpll_spd_lock_fsm</name>
                <description>None</description>
                <bitRange>[12:12]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>adpll_fcal_done_fsm</name>
                <description>None</description>
