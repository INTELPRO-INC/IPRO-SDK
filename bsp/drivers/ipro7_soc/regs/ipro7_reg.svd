            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>obnd_color_format</name>
                <description>Color format of blend data. Range:0~17
5'd0  : ARGB8888          
5'd1  : AYUV8888          
5'd2  : ARGB4444          
5'd3  : AYUV4444          
5'd4  : ARGB1555          
5'd5  : AYUV1555          
5'd6  : RGB565            
5'd7  : YUV655            
5'd8  : A8_RGB            
5'd9  : A8_YUV            
5'd10 : PALETTE_8_BIT_ARGB
5'd11 : PALETTE_8_BIT_AYUV
5'd12 : PALETTE_4_BIT_ARGB
5'd13 : PALETTE_4_BIT_AYUV
5'd14 : PALETTE_2_BIT_ARGB
5'd15 : PALETTE_2_BIT_AYUV
5'd16 : PALETTE_1_BIT_ARGB
5'd17 : PALETTE_1_BIT_AYUV</description>
                <bitRange>[4:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>obnd_order_a</name>
                <description>Order alpha of blend data. Range:0~3</description>
                <bitRange>[9:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>obnd_order_rv</name>
                <description>Order red or v of blend data. Range:0~3</description>
                <bitRange>[11:10]</bitRange>
                <access>read-write</access>
              </field>
              <field>
