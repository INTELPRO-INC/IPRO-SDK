                <access>read-write</access>
              </field>
              <field>
                <name>cr_ep0_out_done_en</name>
                <description>Interrupt enable of ep0_out_done_int</description>
                <bitRange>[9:9]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_ep1_cmd_en</name>
                <description>Interrupt enable of ep1_cmd_int</description>
                <bitRange>[10:10]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_ep1_done_en</name>
                <description>Interrupt enable of ep1_done_int</description>
                <bitRange>[11:11]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_ep2_cmd_en</name>
                <description>Interrupt enable of ep2_cmd_int</description>
                <bitRange>[12:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_ep2_done_en</name>
                <description>Interrupt enable of ep2_done_int</description>
                <bitRange>[13:13]</bitRange>
                <access>read-write</access>
              </field>
              <field>
