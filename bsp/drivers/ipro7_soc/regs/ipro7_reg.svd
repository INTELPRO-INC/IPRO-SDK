          <register>
            <name>m154_csma_0</name>
            <description>m154_csma_0</description>
            <addressOffset>0x90</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x20000221</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>csma_ca_en</name>
                <description>CSMA-CA is required before transmission</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>ble_mode</name>
                <description>Battery life extension mode</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>csma_ca_eb_mode</name>
                <description>Enhanced backoff mode</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>csma_ca_ecr_mode</name>
                <description>Enhanced collision resolution mode</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>csma_ca_slot_en</name>
                <description>Slotted enable</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>csma_ca_timeout_check_option</name>
                <description>CSMA-CA timeout check option
0: Detect PHY CCA no respond only. When csma_ca_timeout_int_raw = 1, it's CCA timeout
1: Detect PHY CCA no respond or TX cannot complete in CAP. When csma_ca_timeout_int_raw = 1, FW need to check csma_ca_fsm_curr : st_timeout_cca (CCA timeout) or st_timeout (TX cannot complete in CAP)</description>
                <bitRange>[5:5]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>csma_ca_sw_mode</name>
                <description>CSMA/CA SW mode</description>
                <bitRange>[6:6]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cw0_sel</name>
                <description>Initial CW (Contention Window) length setting. Set 1 for Japanese 950MHz band. Set 2 for others</description>
                <bitRange>[9:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>csma_ca_cca_en_offset</name>
                <description>CCA trigger 8*N us earlier than next backoff boundary</description>
                <bitRange>[15:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>csma_ca_transaction_time</name>
                <description>Transaction time (SHR+PHR+PSDU). If need ACK, include macAckWaitDuration (54 symbol periods)</description>
                <bitRange>[24:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>csma_ca_cca_timeout_sel</name>
                <description>CCA timeout selection: 20 or 40 symbol periods. If timeout, csma_ca_timeout_int_raw = 1</description>
                <bitRange>[28:28]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>backoff_rx_dis</name>
                <description>Disable packet receipt in Backoff state.</description>
                <bitRange>[29:29]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>m154_csma_1</name>
            <description>m154_csma_1</description>
            <addressOffset>0x94</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x14531103</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>manual_be</name>
                <description>BE fixed this value @manual_be_sel = 1
Used to init preBE @csma_ca_ecr_mode = 1</description>
                <bitRange>[3:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>manual_be_sel</name>
                <description>BE manual enable</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>minus_be</name>
                <description>BE is decreased by minus_be after success of CSMA-CA @csma_ca_ecr_mode = 1</description>
                <bitRange>[10:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>plus_be</name>
                <description>BE is increased by plus_be after failure of CSMA-CA @csma_ca_ecr_mode = 1</description>
                <bitRange>[14:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>min_be</name>
                <description>Min value of CSMA-CA BE (Backoff Exponent). Range=0~max_be</description>
                <bitRange>[19:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>max_be</name>
                <description>Max value of CSMA-CA BE (Backoff Exponent). Range=3~8</description>
                <bitRange>[23:20]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>max_csma_backoffs</name>
                <description>Max number of CSMA-CA backoff before declaring a channel access failure. Range=0~5</description>
                <bitRange>[26:24]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>csma_ca_avg_pkt_len</name>
                <description>Average packet length = SHR(5B) + PHR(1B) + Average pay load (5~127 bytes)</description>
                <bitRange>[31:28]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>m154_csma_2</name>
            <description>m154_csma_2</description>
            <addressOffset>0x98</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>csma_ca_cap_end</name>
                <description>Symbol time of CAP end</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>m154_csma_3</name>
            <description>m154_csma_3</description>
            <addressOffset>0x9C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>csma_ca_ble_period_end</name>
                <description>Symbol time of BLE (Battery Life Extension) period end</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>m154_csma_4</name>
            <description>m154_csma_4</description>
            <addressOffset>0xA0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFF0F0</resetMask>
            <fields>
              <field>
                <name>csma_ca_fsm_curr</name>
                <description>CSMA-CA FSM
  0: st_idle.
  1: st_load_setting1. Load random generator seed
  2: st_load_setting2. Generate random data
  3: st_timeout_check. Check sufficient time to transmit
  4: st_bp_delay. BP (Backoff Period) random delay
  5: st_cca1. Perform 1st CCA
  6: st_cca2. Perform 2nd CCA
  7: st_cca3. Perform 3rd CCA
  8: st_failure_check. Check NB value.
  9: st_timeout_cca. Interrupt timeout
  10: st_success. Interrupt success
  11: st_failure. Interrupt fail
  12: st_timeout. Interrupt timeout</description>
                <bitRange>[3:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>csma_ca_be_curr</name>
                <description>Current BE value. FW need to check after finishing CSMA-CA for ECR mode</description>
                <bitRange>[11:8]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>m154_tx_0</name>
            <description>m154_tx_0</description>
            <addressOffset>0xB0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFE00F000</resetMask>
            <fields>
              <field>
                <name>tx_sn_for_rx_ack_judge</name>
                <description>SN (Sequence Number) of data/command frame</description>
                <bitRange>[7:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>tx_mpdu_aes_ddt_phr_flag</name>
                <description>AES TX DDT tx_phr written</description>
                <bitRange>[8:8]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>tx_mpdu_aes_ddt_done_flag</name>
                <description>AES TX DDT done</description>
                <bitRange>[9:9]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>tx_doing</name>
                <description>TX transmission in-progress (wait AES TX DDT, run CSMA-CA, wait BP boundary, wait PHY on, send MAC frame)</description>
                <bitRange>[10:10]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>tx_auto_ack_doing</name>
                <description>TX auto ACK in-progress (wait SIFS, send MAC frame)</description>
                <bitRange>[11:11]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>tx_mpdu_sym_cnt_acc</name>
                <description>Symbol sent count of the current frame</description>
                <bitRange>[24:16]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>m154_tx_1</name>
            <description>m154_tx_1</description>
            <addressOffset>0xB4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00015038</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>tx_trig_cmd</name>
                <description>TX start</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>tx_mpdu_src_sel</name>
                <description>TX MPDU source.  0: FW (AHB), 1: DDT (internal)</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>tx_trig_time_sel</name>
                <description>TX trigger time @ tx_trg_cmd = 1
  If tx_mpdu_src_sel = 0
    0: immediately
    1: after sym_cnt exceeds tx_trig_time
  If tx_mpdu_src_sel = 1 &amp;&amp; tx_mpdu_aes_ddt_wait_sel = 0
    0: after AES TX DDT writes PHR
    1: after AES TX DDT writes PHR and sym_cnt exceeds tx_trig_time
  If tx_mpdu_src_sel = 1 &amp;&amp; tx_mpdu_aes_ddt_wait_sel = 1
    0: after AES TX DDT is done
    1: after AES TX DDT is done and sym_cnt exceeds tx_trig_time</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>tx_mpdu_aes_ddt_wait_sel</name>
                <description>Wait tx_mpdu_aes_ddt_done @ tx_mpdu_src_sel = 1
  0: TX trigger after AES TX DDT writes PHR
  1: TX trigger after tx_mpdu_aes_ddt_done</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>tx_auto_ack_en</name>
                <description>Auto ACK enable</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>tx_auto_ack_fp_bit</name>
                <description>Frame Pending bit when TX auto ACK is enabled. If enable, Frame Pending bit is set to 1 when Rx Frame Type == 3'b011 and Command Frame Identifier == 8'h4, set to 0 for other cases</description>
                <bitRange>[5:5]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>tx_auto_ack_fp_from_sw</name>
                <description>If this bit is set to 1, frame pending bit in TX Auto Ack frame is equal to tx_auto_ack_fp_bit. Otherwise,  frame pending bit in TX Auto Ack frame is determined by result of NBR search.</description>
                <bitRange>[6:6]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>tx_infinite_en</name>
                <description>Continuus TX with PRBS15 pattern till this bit is reset to 0 by SW. PHR field of TX packet will be 0 if this bit is set to 1.</description>
                <bitRange>[7:7]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>tx_start_offset</name>
                <description>PHY/RF warm-up time (us)</description>
                <bitRange>[15:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>tx_postpone_by_rx_doing_en</name>
                <description>Wait rx_doing = 0 before TX start</description>
                <bitRange>[16:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>tx_trig_fine_time</name>
                <description>If csma_ca_en = 0, the time preamble is transmitted. 
