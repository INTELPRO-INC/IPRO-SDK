          </register>
          <register>
            <name>HBN_IRQ_MODE</name>
            <description>HBN_IRQ_MODE</description>
            <addressOffset>0x14</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x03010005</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>hbn_pin_wakeup_mode</name>
                <description>hbn_pin_wakeup mode 
0000 : sync falling edge trigger
0001 : sync rising edge trigger
0010 : sync low level trigger
0011 : sync high level trigger
010x : sync rising or falling edge trigger
1000 : async falling edge trigger
1001 : async rising edge trigger
1010 : async low level trigger
1011 : async high level trigger</description>
                <bitRange>[3:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>hbn_pin_wakeup_mask</name>
                <description>mask hbn_pin_wakeup_event
(GPIO22/GPIO14/GPIO8/GPIO31/GPIO30/GPIO13~GPIO9)</description>
                <bitRange>[14:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>hbn_pin_wakeup_option</name>
                <description>1: Pin wakeup detect only at HBN 
0 : No limited</description>
                <bitRange>[15:15]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>reg_en_hw_pu_pd</name>
                <description>1:  Pull GPIO30 @ pwr_on and pwr_rst  : no pull</description>
                <bitRange>[16:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>irq_bod_en</name>
                <description>enable brown-out interrupt</description>
                <bitRange>[18:18]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>irq_acomp0_en</name>
                <description>enable acomp0 interrupt [20] posedge [21] negedge</description>
                <bitRange>[21:20]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>irq_acomp1_en</name>
                <description>enable acomp1 interrupt [20] posedge [21] negedge</description>
                <bitRange>[23:22]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>pin_wakeup_dly_sel</name>
                <description>the multiple number of Pin wakeup delay unit
i.e. if Pin wakeup delay_unit = 250ms
the delay range is 1~7 sec
i.e. if Pin wakeup delay_unit = 0.244ms
the delay range is 0.976ms~6.835ms
</description>
                <bitRange>[26:24]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>pin_wakeup_dly_en</name>
                <description>Pin wakeup delay enable</description>
                <bitRange>[27:27]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>pin_wakeup_dly_unit</name>
                <description>Pin wakeup delay unit
0 : in unit of 250ms
1 :in unit of 31.25ms
2 : in unit of 1.953ms
3: in unit of 0.244ms</description>
                <bitRange>[29:28]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
