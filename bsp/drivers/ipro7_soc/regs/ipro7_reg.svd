              </field>
              <field>
                <name>ep6_rx_fifo_full</name>
                <description>RX FIFO full flag</description>
                <bitRange>[31:31]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>ep6_tx_fifo_wdata</name>
            <description>ep6_tx_fifo_wdata</description>
            <addressOffset>0x168</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>ep6_tx_fifo_wdata</name>
                <description>None</description>
                <bitRange>[7:0]</bitRange>
                <access>write-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>ep6_rx_fifo_rdata</name>
            <description>ep6_rx_fifo_rdata</description>
            <addressOffset>0x16C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFF00</resetMask>
            <fields>
              <field>
                <name>ep6_rx_fifo_rdata</name>
                <description>None</description>
                <bitRange>[7:0]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>ep7_fifo_config</name>
            <description>ep7_fifo_config</description>
            <addressOffset>0x170</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFF0F</resetMask>
            <fields>
              <field>
                <name>ep7_dma_tx_en</name>
                <description>Enable signal of dma_tx_req/ack interface</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>ep7_dma_rx_en</name>
                <description>Enable signal of dma_rx_req/ack interface</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>ep7_tx_fifo_clr</name>
                <description>Clear signal of TX FIFO</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>ep7_rx_fifo_clr</name>
                <description>Clear signal of RX FIFO</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>ep7_tx_fifo_overflow</name>
                <description>Overflow flag of TX FIFO, can be cleared by tx_fifo_clr</description>
                <bitRange>[4:4]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>ep7_tx_fifo_underflow</name>
                <description>Underflow flag of TX FIFO, can be cleared by tx_fifo_clr</description>
                <bitRange>[5:5]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>ep7_rx_fifo_overflow</name>
                <description>Overflow flag of RX FIFO, can be cleared by rx_fifo_clr</description>
                <bitRange>[6:6]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>ep7_rx_fifo_underflow</name>
                <description>Underflow flag of RX FIFO, can be cleared by rx_fifo_clr</description>
                <bitRange>[7:7]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>ep7_fifo_status</name>
            <description>ep7_fifo_status</description>
            <addressOffset>0x174</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x40004040</resetValue>
            <resetMask>0x3F803F80</resetMask>
            <fields>
              <field>
                <name>ep7_tx_fifo_cnt</name>
                <description>TX FIFO available count</description>
                <bitRange>[6:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>ep7_tx_fifo_empty</name>
                <description>TX FIFO empty flag</description>
                <bitRange>[14:14]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>ep7_tx_fifo_full</name>
                <description>TX FIFO full flag</description>
                <bitRange>[15:15]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>ep7_rx_fifo_cnt</name>
                <description>RX FIFO available count</description>
                <bitRange>[22:16]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>ep7_rx_fifo_empty</name>
                <description>RX FIFO empty flag</description>
                <bitRange>[30:30]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>ep7_rx_fifo_full</name>
                <description>RX FIFO full flag</description>
                <bitRange>[31:31]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>ep7_tx_fifo_wdata</name>
            <description>ep7_tx_fifo_wdata</description>
            <addressOffset>0x178</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>ep7_tx_fifo_wdata</name>
                <description>None</description>
                <bitRange>[7:0]</bitRange>
                <access>write-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>ep7_rx_fifo_rdata</name>
            <description>ep7_rx_fifo_rdata</description>
            <addressOffset>0x17C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFF00</resetMask>
            <fields>
              <field>
                <name>ep7_rx_fifo_rdata</name>
                <description>None</description>
                <bitRange>[7:0]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>rsvd_0</name>
            <description>rsvd_0</description>
            <addressOffset>0x1F0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields />
          </register>
          <register>
            <name>rsvd_1</name>
            <description>rsvd_1</description>
            <addressOffset>0x1F4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields />
          </register>
          <register>
            <name>xcvr_if_config</name>
            <description>xcvr_if_config</description>
            <addressOffset>0x1FC</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000664</resetValue>
            <resetMask>0x7FFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_xcvr_force_tx_en</name>
                <description>Enable signal of transceiver TX signals force mode
1'b0: tx_oe/dp/dn is controlled by HW
1'b1: tx_oe/dp/dn is controlled by CR (cr_xcvr_force_tx_oe/dp/dn)</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_xcvr_force_tx_oe</name>
                <description>Transceiver TX signals force mode value</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_xcvr_force_tx_dp</name>
                <description>Transceiver TX signals force mode value</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_xcvr_force_tx_dn</name>
                <description>Transceiver TX signals force mode value</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_xcvr_force_rx_en</name>
                <description>Enable signal of transceiver RX signals force mode
1'b0: rx_d/dp/dn is from Transceiver
1'b1: tx_d/dp/dn is controlled by CR (cr_xcvr_force_rx_d/dp/dn)</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_xcvr_force_rx_d</name>
                <description>Transceiver RX signals force mode value</description>
                <bitRange>[5:5]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_xcvr_force_rx_dp</name>
                <description>Transceiver RX signals force mode value</description>
                <bitRange>[6:6]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_xcvr_force_rx_dn</name>
                <description>Transceiver RX signals force mode value</description>
                <bitRange>[7:7]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_xcvr_om_rx_sel</name>
                <description>Select signal of transceiver RX signals in output mode (tx_oe# = 0)
1'b0: rx_d/dp/dn is directly from transceiver
1'b1: rx_d/dp/dn is controlled by CR (cr_xcvr_om_rx_d/dp/dn)</description>
                <bitRange>[8:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_xcvr_om_rx_d</name>
                <description>Transceiver RX signals output mode CR value</description>
                <bitRange>[9:9]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_xcvr_om_rx_dp</name>
                <description>Transceiver RX signals output mode CR value</description>
                <bitRange>[10:10]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_xcvr_om_rx_dn</name>
                <description>Transceiver RX signals output mode CR value</description>
                <bitRange>[11:11]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>sts_vbus_det</name>
                <description>Transceiver VBUS detection status</description>
                <bitRange>[31:31]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
        </registers>
      </peripheral>
      <peripheral>
        <name>PDS</name>
        <version>1.0</version>
        <description>PDS</description>
        <groupName>PDS</groupName>
        <baseAddress>0x3008E000</baseAddress>
        <size>32</size>
        <access>read-write</access>
        <addressBlock>
          <offset>0</offset>
          <size>0x1000</size>
          <usage>registers</usage>
        </addressBlock>
        <registers>
          <register>
            <name>PDS_CTL</name>
            <description>PDS_CTL</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x78006F00</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>pds_start_ps</name>
                <description>Enter PDS</description>
                <bitRange>[0:0]</bitRange>
                <access>write-only</access>
              </field>
              <field>
                <name>cr_sleep_forever</name>
                <description>None</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_pds_wait_rc32m_rdy</name>
                <description>0 : Skip wait RC32M Ready before  PDS Interrupt
1 : wait RC32M Ready during before PDS Interrupt</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_pds_pd_avdd14</name>
                <description>0 : don&#8217;t_touch avdd14 during PDS
1 : power down avdd14 during PDS</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_pds_pd_bg_sys</name>
                <description>0 : don&#8217;t_touch bg_sys during PDS
1 : power down bg_sys during PDS</description>
                <bitRange>[5:5]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_pds_glb_reg_reset_protect</name>
                <description>1: avoid glb_reg reset by any reset</description>
                <bitRange>[6:6]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_pds_ctrl_pu_flash</name>
                <description>0 : don&#8217;'t touch Flash power during all PDS (Flash Power Always on)
1 : turn off Flash Power During PDS (same control with pds power off control)</description>
                <bitRange>[7:7]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_pds_gate_clk</name>
                <description>0 : don&#8217;t_touch clock gating during PDS (all power domain)
1 : gate clock during PDS  (each pwr domain has its own control)  </description>
                <bitRange>[8:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_pds_mem_stby</name>
                <description>0 : don&#8217;t_touch mem_stby during PDS
1 : mem_stby during PDS     (each power domain can has its own control)</description>
                <bitRange>[9:9]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_sw_pu_flash</name>
                <description>if cr_pds_ctrl_pu_flash =0 or not in PDS31 state
0 : SW Turn Off Flash
1: SW Turn on Flash</description>
                <bitRange>[10:10]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_pds_iso_en</name>
                <description>0 : don&#8217;t_touch Isolation during PDS (all power domain)
1 : Isolation during PDS      (each power domain can has its own control)</description>
                <bitRange>[11:11]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_pds_wait_xtal_rdy</name>
                <description>0 : Skip wait XTAL Ready before  PDS Interrupt
1 : wait XTAL Ready during before PDS Interrupt</description>
                <bitRange>[12:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_pds_pwr_off</name>
                <description>0 : don&#8217;t_touch Power during PDS   
1 : Power off during PDS      (each power domain can has its own control)</description>
                <bitRange>[13:13]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_pds_pd_xtal</name>
                <description>0 : don&#8217;t_touch xtal  during PDS
1 : xtal power down during PDS</description>
                <bitRange>[14:14]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_pds_ctrl_soc_enb</name>
                <description>1 :pds_soc_enb controlled by PDS
0 :pds_soc_enb always active</description>
                <bitRange>[15:15]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_pds_rst_soc_en</name>
                <description>0 : no pds_reset
1: pds_rst controlled by PDS</description>
                <bitRange>[16:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_pds_rc32m_off_dis</name>
                <description>1 : RC32M always on  @any state
0 : RC32M on/off controlled by PDS state</description>
                <bitRange>[17:17]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_pds_ldo_vsel_en</name>
                <description>PDS "SLEEP" control LDO voltage enable</description>
                <bitRange>[18:18]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_pds_xtal_cnt_rc32k_en</name>
                <description>1: HW Auto count RC32K to be XTAL Counter after PDS</description>
                <bitRange>[20:20]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_np_wfi_mask</name>
                <description>pds start condition mask np_wfi</description>
                <bitRange>[21:21]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_pds_pd_ldo11</name>
                <description>0 : power on    ldo11  during PDS
1 : power down ldo11 during PDS</description>
                <bitRange>[22:22]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_pds_ctrl_rf</name>
                <description>0 : PDS don&#8217;t control RF on/off
1 : PDS control RF on/off</description>
                <bitRange>[23:23]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cfg_xtal_deg_en</name>
                <description>1: Enable Digital Deg</description>
                <bitRange>[24:24]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cfg_ble_wakeup_req_after_pds</name>
                <description>1: PDS auto send ble_wakeup_req to sleep_timer when exit PDS</description>
                <bitRange>[25:25]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_sw_gpio_iso_mode</name>
                <description>1: SW force keep GPIO</description>
                <bitRange>[26:26]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_turn_off_pds_clk</name>
                <description>Turn off PDS Clock , Set this bit to 0 to active PDS</description>
                <bitRange>[27:27]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_pds_gpio_keep_en</name>
                <description>not supported</description>
                <bitRange>[30:28]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_pds_gpio_iso_mode</name>
                <description>1: HW Keep GPIO  @ PDS7
0 : Clear this bit after PDS7 to release GPIO</description>
                <bitRange>[31:31]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>PDS_INT</name>
            <description>PDS_INT</description>
            <addressOffset>0xC</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00FF0000</resetValue>
            <resetMask>0x00FFC78A</resetMask>
            <fields>
              <field>
                <name>ro_pds_wake_int</name>
                <description>PDS Wakeup Interrupt</description>
                <bitRange>[0:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>ro_pds_rf_done_int</name>
                <description>pu_rf_done interrupt</description>
                <bitRange>[2:2]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>pds_reset_event</name>
                <description>[2] : pds_rst_n (pds reset)
[1]: pwr_rst_n (hbn power on reset)
[0]: hreset_n (Bus Reset)</description>
                <bitRange>[6:4]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>pds_clr_reset_event</name>
                <description>clear pds reset event</description>
                <bitRange>[7:7]</bitRange>
                <access>write-only</access>
              </field>
              <field>
                <name>cr_pds_wake_int_mask</name>
                <description>Mask pds wakeup interrupt</description>
                <bitRange>[8:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>pds_pin_wakeup_option</name>
                <description>1: Pin wakeup detect only at PDS 
0 : No limited</description>
                <bitRange>[9:9]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_pds_rf_done_int_mask</name>
                <description>Mask pds rf done interrupt</description>
                <bitRange>[10:10]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>pds_timeout_event</name>
                <description>[2] : ldo11soc_timeout event
[1] : dcdc_timeout event
[0] : pds_watchdog_timeout event</description>
                <bitRange>[13:11]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>en_pds_timeout_event</name>
                <description>None</description>
                <bitRange>[14:14]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_pds_int_clr</name>
                <description>pds interrupt &amp; wakeup reason clear</description>
                <bitRange>[15:15]</bitRange>
                <access>write-only</access>
              </field>
              <field>
                <name>cr_pds_wakeup_src_en</name>
                <description>Mask PDS Wakeup Trigger
[23]: enable wakeup trigger by usb_wkup
[22] :enable wakeup trigger by pds_watchdog_timeout event
[21]: enable wakeup trigger by kys_int
[20]: enable wakeup trigger by ble_slp_irq
[19]: enable wakeup trigger by pds_gpio_int
[18]: enable wakeup trigger by gpio_irq
[17]: enable wakeup trigger by pds_kyd_wakeup
[16]: enable wakeup trigger by hbn_irq_out[1:0]</description>
                <bitRange>[23:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>ro_pds_wakeup_event</name>
                <description>Record Wakeup resason, and be clear by cr_pds_int_clr
[31]: wakeup trigger by usb_wkup
[30]: wakeup trigger by pds_watchdog_timeout event
[29]: wakeup trigger by kys_int 
[28]: wakeup trigger by ble_slp_irq
[27]: wakeup trigger by pds_gpio_int
[26]: wakeup trigger by gpio_irq
[25]: wakeup trigger by pds_kyd_wakeup
[24]: wakeup trigger by hbn_irq_out[1:0]</description>
                <bitRange>[31:24]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>PDS_CTL2</name>
            <description>PDS_CTL2</description>
            <addressOffset>0x10</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>cr_pds_force_np_pds_rst</name>
                <description>manual force NP pds reset</description>
                <bitRange>[8:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_pds_force_bz_pds_rst</name>
                <description>manual force BZ pds reset</description>
                <bitRange>[10:10]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_pds_force_np_gate_clk</name>
                <description>manual force NP clock gated</description>
                <bitRange>[16:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>cr_pds_force_bz_gate_clk</name>
