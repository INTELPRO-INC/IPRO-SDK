          <register>
            <name>gpadc_reg_cmd</name>
            <description>gpadc_reg_cmd</description>
            <addressOffset>0x50C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000F78</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>gpadc_global_en</name>
                <description>1'h0: disable ADC&#160; 1'h1: enable ADC</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_conv_start</name>
                <description>1'h0: stop converation&#160; 1'h1: start converation</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_soft_rst</name>
                <description>user reset the whole block 1'h0: not reset&#160; 1'h1: reset</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_neg_sel</name>
                <description>select adc negative input in none-scan mode
4'b0000 gpio0
4'b0001 gpio1
4'b0010 gpio2
4'b0011 gpio3
4'b0100 gpio4
4'b0101 gpio5
4'b0110 gpio6
4'b0111 gpio7
4'b1000 daca
4'b1001 dacb
4'b1010 vbat
4'b1011 tsen
4'b1100 vref
4'b1101 gnd
4'b1111 disable</description>
                <bitRange>[7:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_pos_sel</name>
                <description>select adc positive input in none-scan mode
4'b0000 gpio0
4'b0001 gpio1
4'b0010 gpio2
4'b0011 gpio3
4'b0100 gpio4
4'b0101 gpio5
4'b0110 gpio6
4'b0111 gpio7
4'b1000 daca
4'b1001 dacb
4'b1010 vbat
4'b1011 tsen
4'b1100 vref
4'b1101 gnd
4'b1111 disable</description>
                <bitRange>[12:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_neg_gnd</name>
                <description>set negative input of adc to ground
1'b0: disable
1'b1: enable</description>
                <bitRange>[13:13]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_micbias_en</name>
                <description>enable micbias 
1'b0: micbias power down
1'b1: miabias power on</description>
                <bitRange>[14:14]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_micpga_en</name>
                <description>micpga enable
1'b0: micpga disable
1'b1: miapga enable</description>
                <bitRange>[15:15]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_byp_micboost</name>
                <description>micboost amp bypass
1'b0: not bypass
1'b1: bypass</description>
                <bitRange>[16:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_rcal_en</name>
                <description>rcal enable
1'b0: rcal disable
1'b1: rcal enable</description>
                <bitRange>[17:17]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_dwa_en</name>
                <description>dwa enable
1'b0: dwa disable
1'b1: dwa enable</description>
                <bitRange>[18:18]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_mic2_diff</name>
                <description>mic2 diff enable
1'b0: single
1'b1: diff</description>
                <bitRange>[19:19]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_mic1_diff</name>
                <description>mic1 diff enable
1'b0: single
1'b1: diff</description>
                <bitRange>[20:20]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_mic_pga2_gain</name>
                <description>mic_pga2_gain
2'h0: 0dB
2'h1: 6dB
2'h2: -6dB
2'h3: 12dB</description>
                <bitRange>[22:21]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_micboost_32db_en</name>
                <description>micboost 32db enable
1'b0: 16dB
1'b1: 32dB</description>
                <bitRange>[23:23]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_chip_sen_pu</name>
                <description>enable chip sensor test
1'b0: disable
1'b1: enable</description>
                <bitRange>[27:27]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_sen_sel</name>
                <description>selected output current channel and measurement channel
2'h0: 1st channel
2'h1: 2nd channel
2'h2: 3rd channel 
2'h3: 4th channel</description>
                <bitRange>[30:28]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_sen_test_en</name>
                <description>enable sensor dc test mux</description>
                <bitRange>[31:31]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>gpadc_reg_config1</name>
            <description>gpadc_reg_config1</description>
            <addressOffset>0x510</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x000C0002</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>gpadc_cont_conv_en</name>
                <description>To enable continuous conversion
1'h0: one shot conversion&#160; 1'h1: continuous conversion</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_res_sel</name>
                <description>adc resolution/over-sample rate select 
3'b000&#160;&#160;&#160; 12bit 2MS/s, OSR=1 
3'b001&#160;&#160;&#160; 14bit 125kS/s, OSR=16
3'b010&#160;&#160;&#160; 14bit 31.25kS/s, OSR=64 
3'b011&#160;&#160;&#160; 16bit 15.625KS/s, OSR=128 (voice mode16KS/s)
3'b100&#160;&#160;&#160; 16bit 7.8125KS/s, OSR=256 (voice mode 8KS/s)</description>
                <bitRange>[4:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_vcm_sel_en</name>
                <description>None</description>
                <bitRange>[8:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_vcm_hyst_sel</name>
                <description>None</description>
                <bitRange>[9:9]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_lowv_det_en</name>
                <description>None</description>
                <bitRange>[10:10]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_pwm_trg_en</name>
                <description>Enable signal for PWM to trigger ADC sampling</description>
                <bitRange>[11:11]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_clk_ana_dly</name>
                <description>analog clock 2M delay cycle count</description>
                <bitRange>[15:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_clk_ana_dly_en</name>
                <description>analog clock 2M delay enable</description>
                <bitRange>[16:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_clk_ana_inv</name>
                <description>analog clock 2M inverted</description>
                <bitRange>[17:17]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_clk_div_ratio</name>
                <description>analog 32M clock division ratio
3'b000: div=1
3'b001: div=4
3'b010: div=8
3'b011: div=12
3'b100: div=16
3'b101: div=20
3'b110: div=24
3'b111: div=32</description>
                <bitRange>[20:18]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_scan_length</name>
                <description>select scan mode length
4'b0000 : select gpadc_scan_pos_0 and gpadc_scan_neg_0
4'b0001 : select gpadc_scan_pos_1 and gpadc_scan_neg_1
4'b0010 : select gpadc_scan_pos_2 and gpadc_scan_neg_2
4'b0011 : select gpadc_scan_pos_3 and gpadc_scan_neg_3
4'b0100 : select gpadc_scan_pos_4 and gpadc_scan_neg_4
4'b0101 : select gpadc_scan_pos_5 and gpadc_scan_neg_5
4'b0110 : select gpadc_scan_pos_6 and gpadc_scan_neg_6
4'b0111 : select gpadc_scan_pos_7 and gpadc_scan_neg_7
4'b1000 : select gpadc_scan_pos_8 and gpadc_scan_neg_8
4'b1001 : select gpadc_scan_pos_9 and gpadc_scan_neg_9
4'b1010 : select gpadc_scan_pos_10 and gpadc_scan_neg_10
4'b1011 : select gpadc_scan_pos_11 and gpadc_scan_neg_11</description>
                <bitRange>[24:21]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_scan_en</name>
                <description>select scan mode enable: 0: select&#160; gpadc_pos/neg_sel;1: select&#160; : select gpadc_scan_pos_x and gpadc_scan_neg_x</description>
                <bitRange>[25:25]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_dither_en</name>
                <description>Dither compensation enable</description>
                <bitRange>[26:26]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_v11_sel</name>
                <description>internal vdd11 select</description>
                <bitRange>[28:27]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_v18_sel</name>
                <description>internal vdd18 select</description>
                <bitRange>[30:29]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>gpadc_reg_config2</name>
            <description>gpadc_reg_config2</description>
            <addressOffset>0x514</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00019100</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>gpadc_diff_mode</name>
                <description>1'h0 single-ended 1'h1 differential</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_vref_sel</name>
                <description>ADC reference select 
1'h0 3.3V
1'h1 1.8V</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_vbat_en</name>
                <description>1'h0: disable VBAT sensor 1'h1 enable VBAT sensor</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_tsext_sel</name>
                <description>1'h0: internal diode mode&#160; 1'h1: external diode mode</description>
                <bitRange>[5:5]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_ts_en</name>
                <description>1'h0: disable temperature sensor 1'h1: enable temperature sensor</description>
                <bitRange>[6:6]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_pga_vcm</name>
                <description>Audio PGA output common mode control
2'b00: cm=1V 
2'b11: cm=1.2V 
2'b11: cm=1.4V 
2'b11: cm=1.6V</description>
                <bitRange>[8:7]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_pga_os_cal</name>
                <description>pga offset calibration</description>
                <bitRange>[12:9]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_pga_en</name>
                <description>1'h0: disable PGA 1'h1 enable PGA</description>
                <bitRange>[13:13]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_pga_vcmi_en</name>
                <description>enable pga input vcm bias</description>
                <bitRange>[14:14]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_chop_mode</name>
                <description>2'b11&#160;&#160;&#160; all&#160; off
2'b11&#160;&#160;&#160; Vref AZ on
2'b11&#160;&#160;&#160; Vref AZ and PGA chop on
2'b11&#160;&#160;&#160; Vref AZ and PGA chop+RPC on</description>
                <bitRange>[16:15]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_bias_sel</name>
                <description>adc analog portion low power mode select
1'h0: Full biasing current 
1'h1: Half biasing current</description>
                <bitRange>[17:17]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_test_en</name>
                <description>Analog test enable.</description>
                <bitRange>[18:18]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_test_sel</name>
                <description>select test point 0~7</description>
                <bitRange>[21:19]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_pga2_gain</name>
                <description>3'h0: disable
3'h1: gain=1
3'h2: gain=2
3'h3: gain=4
3'h4: gain=8
3'h5: gain=16
3'h6: gain=32
3'h7: gain=32</description>
                <bitRange>[24:22]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_pga1_gain</name>
                <description>3'h0: disable
3'h1: gain=1
3'h2: gain=2
3'h3: gain=4
3'h4: gain=8
3'h5: gain=16
3'h6: gain=32
3'h7: gain=32</description>
                <bitRange>[27:25]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_dly_sel</name>
                <description>adc conversion speed</description>
                <bitRange>[30:28]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_tsvbe_low</name>
                <description>tsen diode current</description>
                <bitRange>[31:31]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>gpadc_reg_scn_pos1</name>
            <description>adc converation sequence 1</description>
            <addressOffset>0x518</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x1EF7BDEF</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>gpadc_scan_pos_0</name>
                <description>definition is the same as adc_reg_cmd.adc_pos_sel</description>
                <bitRange>[4:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_scan_pos_1</name>
                <description>definition is the same as adc_reg_cmd.adc_pos_sel</description>
                <bitRange>[9:5]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>gpadc_scan_pos_2</name>
