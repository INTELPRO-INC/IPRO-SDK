            <fields>
              <field>
                <name>efp_en</name>
                <description>0: search NBR table when data request command packet is received.
1: search NBR table when data request/data/multi-purpose packet is received.
2: search NBR table when data request/data/multi-purpose packet or any command packet is received.
3: search NBR table when data request/data/multi-purpose packet or any command packet is received.</description>
                <bitRange>[1:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>nbr_result_fp_valid</name>
                <description>0: peer device is not in NBR table.
0: peer device is in NBR table.</description>
                <bitRange>[2:2]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>nbr_result_fp</name>
