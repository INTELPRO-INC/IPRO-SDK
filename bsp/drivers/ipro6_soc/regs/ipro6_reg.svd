              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pwm_ext_break_en</name>
              <description>PWM external break source enable 1'b0: Disabled, external break signal is masked 1'b1: Enabled, external break signal is effective</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pwm_sw_break_en</name>
