    <peripheral>
      <name>I2S</name>
      <version>1.0</version>
      <description>I2S</description>
      <groupName>I2S</groupName>
      <baseAddress>0x30013000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>i2s_config</name>
          <description>i2s_config</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00005000</resetValue>
          <resetMask>0x03FFF1FF</resetMask>
          <fields>
            <field>
              <name>cr_ofs_en</name>
              <description>Offset enable 1'b0: Disabled, 1'b1: Enabled</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_ofs_cnt</name>
              <description>Offset cycle count (unit: cycle of I2S BCLK) 5'd0: 1 cycle 5'd1: 2 cycles …</description>
              <bitRange>[24:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_mono_rx_ch</name>
              <description>RX mono mode channel select signal 1'b0: L-channel 1'b1: R-channel</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_endian</name>
              <description>Data endian (bit reverse) 1'b0: MSB goes out first, 1'b1: LSB goes out first</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_i2s_mode</name>
              <description>2'd0: Left-Justified, 2'd1: Right-Justified, 2'd2: DSP, 2'd3: Reserved</description>
              <bitRange>[17:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_data_size</name>
              <description>Data bit width of each channel 2'd0: 8, 2'd1: 16, 2'd2: 24, 2'd3: 32 (bits)</description>
              <bitRange>[15:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_frame_size</name>
              <description>Frame size of each channel 2'd0: 8, 2'd1: 16, 2'd2: 24, 2'd3: 32 (cycles)</description>
              <bitRange>[13:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_fs_ch_cnt</name>
              <description>Channel count of each frame 2'd0: FS 2-channel mode 2'd1: FS 3-channel mode (DSP mode only) 2'd2: FS 4-channel mode (DSP mode only) 2'd3: FS 6-channel mode (DSP mode only) Note: cr_mono_mode &amp; cr_fifo_lr_merge will be invalid in 3-channel mode Note: frame_size must equal data_size in 3/4/6-channel mode</description>
              <bitRange>[8:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_fs_1t_mode</name>
              <description>1'b0: FS high/low is even, 1'b1: FS only asserts for 1 cycle</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_mute_mode</name>
              <description>1'b0: Normal mode, 1'b1: Mute mode</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_mono_mode</name>
              <description>1'b0: Stereo mode, 1'b1: Mono mode Note: csr_mono_mode &amp; csr_fifo_lr_merge should NOT be enabled at the same time</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_i2s_rxd_en</name>
              <description>Enable signal of I2S RXD signal</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_i2s_txd_en</name>
              <description>Enable signal of I2S TXD signal</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_i2s_s_en</name>
              <description>Enable signal of I2S Slave function, cannot enable both csr_i2s_m_en &amp; csr_i2s_s_en</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_i2s_m_en</name>
              <description>Enable signal of I2S Master function, cannot enable both csr_i2s_m_en &amp; csr_i2s_s_en</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>i2s_int_sts</name>
          <description>i2s_int_sts</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x07000700</resetValue>
          <resetMask>0x07000700</resetMask>
          <fields>
            <field>
              <name>cr_i2s_fer_en</name>
              <description>Interrupt enable of i2s_fer_int</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_i2s_rxf_en</name>
              <description>Interrupt enable of i2s_rxf_int</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_i2s_txf_en</name>
              <description>Interrupt enable of i2s_txf_int</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_i2s_fer_mask</name>
              <description>Interrupt mask of i2s_fer_int</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_i2s_rxf_mask</name>
              <description>Interrupt mask of i2s_rxf_int</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_i2s_txf_mask</name>
              <description>Interrupt mask of i2s_txf_int</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>i2s_fer_int</name>
              <description>I2S TX/RX FIFO error interrupt, auto-cleared when FIFO overflow/underflow error flag is cleared</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>i2s_rxf_int</name>
              <description>I2S RX FIFO ready (rx_fifo_cnt &gt; rx_fifo_th) interrupt, auto-cleared when data is popped</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>i2s_txf_int</name>
              <description>I2S TX FIFO ready (tx_fifo_cnt &gt; tx_fifo_th) interrupt, auto-cleared when data is pushed</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>i2s_bclk_config</name>
          <description>i2s_bclk_config</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00010001</resetValue>
          <resetMask>0x0FFF0FFF</resetMask>
          <fields>
            <field>
              <name>cr_bclk_div_h</name>
              <description>I2S BCLK active high period (unit: cycle of i2s_clk)</description>
              <bitRange>[27:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_bclk_div_l</name>
              <description>I2S BCLK active low period (unit: cycle of i2s_clk)</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>i2s_fifo_config_0</name>
          <description>i2s_fifo_config_0</description>
          <addressOffset>0x80</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000070F</resetMask>
          <fields>
            <field>
              <name>cr_fifo_24b_lj</name>
              <description>FIFO 24-bit data left-justified mode 1'b0: Right-justified, {8'h0, data[23:0]} 1'b1: Left-justified, {data[23:0], 8'h0} Note: Valid only when cr_data_size = 2'd2 (24-bit)</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_fifo_lr_exchg</name>
              <description>The position of L/R channel data within each entry is exchanged if this bit is enabled Can only be enabled if data size is 8 or 16 bits and csr_fifo_lr_merge is enabled</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_fifo_lr_merge</name>
              <description>Each FIFO entry contains both L/R channel data if this bit is enabled Can only be enabled if data size is 8 or 16 bits Note: cr_fifo_lr_merge &amp;cr_mono_mode should NOT be enabled at the same time Note: cr_fifo_lr_merge &amp;cr_fifo_l_shift should NOT be enabled at the same time</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rx_fifo_underflow</name>
              <description>Underflow flag of RX FIFO, can be cleared by rx_fifo_clr</description>
              <bitRange>[7:7]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>rx_fifo_overflow</name>
              <description>Overflow flag of RX FIFO, can be cleared by rx_fifo_clr</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>tx_fifo_underflow</name>
              <description>Underflow flag of TX FIFO, can be cleared by tx_fifo_clr</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>tx_fifo_overflow</name>
              <description>Overflow flag of TX FIFO, can be cleared by tx_fifo_clr</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>rx_fifo_clr</name>
              <description>Clear signal of RX FIFO</description>
              <bitRange>[3:3]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>tx_fifo_clr</name>
              <description>Clear signal of TX FIFO</description>
              <bitRange>[2:2]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>i2s_dma_rx_en</name>
              <description>Enable signal of dma_rx_req/ack interface</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>i2s_dma_tx_en</name>
              <description>Enable signal of dma_tx_req/ack interface</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>i2s_fifo_config_1</name>
          <description>i2s_fifo_config_1</description>
          <addressOffset>0x84</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0F0F0000</resetMask>
          <fields>
            <field>
              <name>rx_fifo_th</name>
              <description>RX FIFO threshold, dma_rx_req will not be asserted if rx_fifo_cnt is less than this value</description>
              <bitRange>[27:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>tx_fifo_th</name>
              <description>TX FIFO threshold, dma_tx_req will not be asserted if tx_fifo_cnt is less than this value</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rx_fifo_cnt</name>
              <description>RX FIFO available count</description>
              <bitRange>[12:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>tx_fifo_cnt</name>
              <description>TX FIFO available count</description>
              <bitRange>[4:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>i2s_fifo_wdata</name>
          <description>i2s_fifo_wdata</description>
          <addressOffset>0x88</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>i2s_fifo_wdata</name>
              <description />
              <bitRange>[31:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>i2s_fifo_rdata</name>
          <description>i2s_fifo_rdata</description>
          <addressOffset>0x8C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>i2s_fifo_rdata</name>
              <description />
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>i2s_io_config</name>
          <description>i2s_io_config</description>
          <addressOffset>0xFC</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000FF</resetMask>
          <fields>
            <field>
              <name>cr_deg_en</name>
              <description>Deglitch enable (for all th input pins) 1'b0: Disabled, 1'b1: Enabled</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_deg_cnt</name>
              <description>Deglitch cycle count (unit: cycle of I2S kernel clock) 3'd0: 1 cycle 3'd1: 2 cycles …</description>
              <bitRange>[6:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_i2s_bclk_inv</name>
              <description>Inverse BCLK signal 0: No inverse, 1: Inverse</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_i2s_fs_inv</name>
              <description>Inverse FS signal 0: No inverse, 1: Inverse</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_i2s_rxd_inv</name>
              <description>Inverse RXD signal 0: No inverse, 1: Inverse</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_i2s_txd_inv</name>
              <description>Inverse TXD signal 0: No inverse, 1: Inverse</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>DBI</name>
      <version>1.0</version>
      <description>DBI</description>
      <groupName>DBI</groupName>
      <baseAddress>0x30016000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>dbi_config</name>
          <description>dbi_config</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00050070</resetValue>
          <resetMask>0x01FFFFF7</resetMask>
          <fields>
            <field>
              <name>sts_dbi_bus_busy</name>
              <description>Indicator of dbi bus busy</description>
              <bitRange>[31:31]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>cr_dbi_cs_stretch</name>
              <description>Enable signal of CS-low stretch mode 1'b0: Disabled, if FIFO is empty during a pixel data transfer, CS will de-assert before FIFO is filled again and new transfer starts 1'b1: Enabled, if FIFO is empty during a pixel data transfer, CS will stay asserted while waiting for FIFO to be filled again</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_dbi_dmy_cnt</name>
              <description>Dummy cycle count, unit: period defined by dbi_prd_d Effective only in Type C (Fixed to 1 dbi_prd_d  period in Type B)</description>
              <bitRange>[23:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_dbi_dmy_en</name>
              <description>Enable signal of dummy cycle(s) 1'b0: Disabled, no dummy cycle(s) between command phase and data phase 1'b1: Enabled, dummy cycle(s) will be inserted between command phase and data phase Note: Don't-care if QSPI mode is selected (no dummy cycle)</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_dbi_cont_en</name>
              <description>Enable signal of pixel data continuous transfer mode 1'b0: Disabled, CS_n will de-assert between each pixel 1'b1: Enabled, CS_n will stay asserted between each consecutive pixel Note: Don't-care if QSPI mode is selected (always in continuous mode)</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_dbi_scl_ph</name>
              <description>SCL clock phase inverse signal</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_dbi_scl_pol</name>
              <description>SCL clock polarity 0: SCL output LOW at IDLE state 1: SCL output HIGH at IDLE state</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_dbi_dat_bc</name>
              <description>Data byte count of normal data (pixel data count is determined by cr_dbi_pix_cnt) Note: Normal read data can only be up to 8-byte (8'd7). No limit for normal write data (can be up to 256-byte using FIFO)</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_dbi_dat_tp</name>
              <description>Data type select 1'b0: Normal data (parameter) 1'b1: Pixel data Note: Read command supports normal data only</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_dbi_dat_wr</name>
              <description>Data phase Read/Write select 1'b0: Read data 1'b1: Write data</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_dbi_dat_en</name>
              <description>Data enable signal 1'b0: Data phase disabled 1'b1: Data phase enabled</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_dbi_cmd_en</name>
              <description>Command enable signal 1'b0: No command phase 1'b1: Command will be sent Note: Don't-care if QSPI mode is selected (Command always enabled)</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_dbi_sel</name>
              <description>DBI mode select 2'd0: DBI Type B 2'd1: DBI Type C, 4-wire mode 2'd2: DBI Type C, 3-wire mode 2'd3: QSPI mode</description>
              <bitRange>[2:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_dbi_en</name>
              <description>Enable signal of DBI function Asserting this bit will trigger the transaction, and should be de-asserted after finish</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>qspi_config</name>
          <description>qspi_config</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000026</resetValue>
          <resetMask>0x00000037</resetMask>
          <fields>
            <field>
              <name>cr_qspi_adr_bc</name>
              <description>QSPI Address byte count</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_qspi_dat_4b</name>
              <description>QSPI Data 4-bit (quad) mode 1'b0: Data sent/received in 1-bit mode 1'b1: Data sent/received in 4-bit mode</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_qspi_adr_4b</name>
              <description>QSPI Address (display command) 4-bit (quad) mode 1'b0: Address sent in 1-bit mode 1'b1: Address sent in 4-bit mode</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_qspi_cmd_4b</name>
              <description>QSPI Command 4-bit (quad) mode 1'b0: Command sent in 1-bit mode 1'b1: Command sent in 4-bit mode</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>dbi_pix_cnt</name>
          <description>dbi_pix_cnt</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x80FFFFFF</resetMask>
          <fields>
            <field>
              <name>cr_dbi_pix_format</name>
              <description>Pixel format 1'b0: RGB565 1'b1: RGB888/RGB666</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_dbi_pix_cnt</name>
              <description>Pixel count Note: Should be a multiple of 2 if RGB565 is selected and a multiple of 4 if RGB888/RGB666 mode is selected</description>
              <bitRange>[23:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>dbi_prd</name>
          <description>dbi_prd</description>
          <addressOffset>0xC</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0F0F0F0F</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>cr_dbi_prd_d_ph_1</name>
              <description>Length of DATA phase 1 (please refer to "Timing" tab)</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_dbi_prd_d_ph_0</name>
              <description>Length of DATA phase 0 (please refer to "Timing" tab)</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_dbi_prd_i</name>
              <description>Length of INTERVAL between pixel data (please refer to "Timing" tab)</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_dbi_prd_s</name>
              <description>Length of START/STOP condition (please refer to "Timing" tab)</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>dbi_cmd</name>
          <description>dbi_cmd</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000002C</resetValue>
          <resetMask>0x000000FF</resetMask>
          <fields>
            <field>
              <name>cr_dbi_cmd</name>
              <description>DBI Command</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>dbi_qspi_adr</name>
          <description>dbi_qspi_adr</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00002C00</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
