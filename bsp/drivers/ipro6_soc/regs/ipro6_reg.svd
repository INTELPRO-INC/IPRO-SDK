              <bitRange>[6:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>acomp0_en</name>
              <description>ACOMP0 enable 1'h0 disable 1'h1 enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
