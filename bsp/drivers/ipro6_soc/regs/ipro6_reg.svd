            </field>
            <field>
              <name>reg_gpio_33_clr</name>
              <description>When SWGPIO @ Set/Clear Mode Set this bit will clear GPIO output value to 0,when set/clr at the same time, only set take effect</description>
              <bitRange>[26:26]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>reg_gpio_33_set</name>
              <description>When SWGPIO @ Set/Clear Mode Set this bit will set GPIO output value to 1,when set/clr at the same time, only set take effect</description>
              <bitRange>[25:25]</bitRange>
              <access>write-only</access>
            </field>
