          <resetMask>0xC75F1F7F</resetMask>
          <fields>
            <field>
              <name>reg_gpio_33_mode</name>
              <description>When GPIO Function Selected to SWGPIO  00 (Output Value Mode): GPIO Output by reg_gpio_x_o Value  01 (Set/Celar Mode     ) :GPIO Output set by reg_gpio_x_set and clear by reg_gpio_x_clr 10 : SWGPIO Source comes from  GPIO DMA (GPIO DMA Mode), GPIO Output value by gpio_dma_o 11: SWGPIO Source comes from  GPIO DMA (GPIO DMA Mode), GPIO Outout value by gpio_dma_set/gpio_dma_clr</description>
              <bitRange>[31:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
