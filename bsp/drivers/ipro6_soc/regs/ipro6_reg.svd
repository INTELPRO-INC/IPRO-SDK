              <name>rg_spi2dvp_int_en</name>
              <description>SPI2DVP interrupt enable</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rg_spi2dvp_data_order</name>
              <description>SPI2DVP data order (don't-care if data format is YUV400) 0: U/V first 1: Y first</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rg_spi2dvp_data_format</name>
              <description>SPI2DVP data format 0: YUV422 1: YUV400 (Y only)</description>
              <bitRange>[4:4]</bitRange>
