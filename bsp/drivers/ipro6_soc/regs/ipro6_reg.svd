              <access>read-write</access>
            </field>
            <field>
              <name>ldo18io_vout_sel</name>
              <description>output voltage selection,  0: 1.65V,   1: 1.70V 2: 1.75V, 3: 1.80V, 4: 1.85V, 5: 1.90V, 6: 1.95V, 7: 2.00V, 8: 2.60V, 9: 2.70V, a: 2.80V, b: 2.90V, c: 2.95V, d: 3.00V, e: 3.05V, f: 3.10V</description>
              <bitRange>[27:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ldo18io_sstart_en</name>
