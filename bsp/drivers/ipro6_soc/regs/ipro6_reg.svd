          <resetValue>0x1AF2001C</resetValue>
          <resetMask>0xFFFE0F1C</resetMask>
          <fields>
            <field>
              <name>sf_id</name>
              <description>ID</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>sf_aes_iv_endian</name>
              <description>0:little-endian 1:big-endian</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>sf_aes_key_endian</name>
              <description>0:little-endian 1:big-endian</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>sf_aes_din_endian</name>
