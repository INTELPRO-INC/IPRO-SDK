    </peripheral>
    <peripheral>
      <name>RF</name>
      <version>1.0</version>
      <description>RF</description>
      <groupName>RF</groupName>
      <baseAddress>0x30001000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>rf_rev</name>
          <description>Silicon revision</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>hw_rev</name>
              <description>mark digital HW REV ID</description>
              <bitRange>[23:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>fw_rev</name>
              <description>mark firmware REV ID</description>
              <bitRange>[15:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>rf_id</name>
              <description>mark RF IP rev ID</description>
              <bitRange>[7:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>rf_fsm_ctrl_hw</name>
          <description>Digital Control</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00100002</resetValue>
          <resetMask>0x01107F0E</resetMask>
          <fields>
            <field>
              <name>rf_rc_state_value</name>
              <description>RC FSM state value</description>
              <bitRange>[30:28]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>rf_fsm_st_int_set</name>
              <description>RF FSM state interrupt set</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rf_fsm_st_int_clr</name>
              <description>RF FSM state interrupt clear</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rf_fsm_st_int</name>
              <description>RF FSM state interrupt value</description>
              <bitRange>[16:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>rf_fsm_st_int_sel</name>
              <description>WiFi FSM ST request, When selection, IRQ for certain ST will be reported  4'h0:FSM comes to RFrdy ST (after RF power up fullcal or power up incremental cal, next ST will be SB) 4'h1:FSM comes to SB ST (should be same as BB FSM status) 4'h2:FSM comes to RX ST (should be same as BB FSM status) 4'h3:FSM comes to TX ST (should be same as BB FSM status) 4'h4:FSM comes to Inccal_ros_afcal (for RF incremental calibration between TX to RX） 4'h5:FSM comes to inccal_tos_afcal (for RF incremental calibration between TX to RX，not RX-to-TX due to limited switching time）</description>
              <bitRange>[14:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rf_rc_state_dbg_en</name>
              <description>1:enable RC state from SW</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rf_rc_state_dbg</name>
              <description>SW RC state value</description>
              <bitRange>[10:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rf_fsm_state</name>
              <description>RF FSM state value 0:ST_PD, 1:ST_SB, 2:ST_LO, 3:ST_RX, 4:ST_TX, 5:ST_T2RI, 6:ST_R2T, 7:ST_MS</description>
              <bitRange>[6:4]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>rf_fsm_t2r_cal_mode</name>
              <description>2'd0:disable incremental calibration between TX/RX/ switching 2'd1:enable incremental ROS/A/F calibration between TX/RX switching 2'd2:(Reserved) enable incremental TOS calibration between TX/RX switching 2'd3:(Reserved) enable incremental ROS/TOS calibration between TX/RX switching</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rf_fsm_ctrl_en</name>
              <description>1:enable HW RF FSM controller</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>rf_fsm_ctrl_sw</name>
          <description>rfsm status reg</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000000F</resetValue>
          <resetMask>0x0001111F</resetMask>
          <fields>
            <field>
              <name>lo_unlocked</name>
              <description>LO Unlock signal (hardware connect this signal to SoC interrupts)</description>
              <bitRange>[20:20]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>inc_cal_timeout</name>
              <description>indicate that inccal has timed out</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>full_cal_en</name>
              <description>enable full calibration during 1) power up 2) unlocked 3) sw control</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rf_fsm_sw_st_vld</name>
              <description>Calibration FSM and function FSM Status Valid Signal, this valid=1 means rf_fsm_st is right available</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rf_fsm_sw_st</name>
              <description>Calibration FSM and function FSM Status Signal: 0~7: is hardware state; 8~31: is software state</description>
              <bitRange>[4:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>rfctrl_hw_en</name>
          <description>Control logic switch</description>
          <addressOffset>0xC</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>rf_reserved3</name>
              <description />
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>temp_comp</name>
          <description>temp_comp</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000741A</resetValue>
          <resetMask>0x0001FFFF</resetMask>
          <fields>
            <field>
              <name>temp_comp_en</name>
              <description>1'b1: enable temperature compensation for LO amplitude and frequency inc_cal</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>const_fcal</name>
              <description>fcal temperature compensaton constant</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>const_acal</name>
              <description>acal temperature compensaton constant</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>rfcal_status</name>
          <description>rfcal_status</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>dpd_status</name>
              <description>dpd status :  0: not started, 1: on-going, 2: fail, 3:pass</description>
              <bitRange>[31:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>tenscal_status</name>
              <description>tenscal (Tref record) status :  0: not started, 1: on-going, 2: fail, 3:pass</description>
              <bitRange>[29:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pwdet_cal_status</name>
              <description>pwdet_cal status :  0: not started, 1: on-going, 2: fail, 3:pass</description>
              <bitRange>[27:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>riqcal_status_resv</name>
              <description>0: not started, 1: on-going, 2: fail, 3:pass</description>
              <bitRange>[25:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>tiqcal_status_resv</name>
              <description>0: not started, 1: on-going, 2: fail, 3:pass</description>
              <bitRange>[23:22]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>lo_leakcal_status</name>
              <description>0: not started, 1: on-going, 2: fail, 3:pass</description>
              <bitRange>[21:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rccal_status</name>
              <description>RC calibration status: 0: not started, 1: on-going, 2: fail, 3:pass</description>
              <bitRange>[19:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>tos_status</name>
              <description>tos status :  0: not started, 1: on-going, 2: fail, 3:pass</description>
              <bitRange>[17:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ros_status</name>
              <description>ros status :  0: not started, 1: on-going, 2: fail, 3:pass</description>
              <bitRange>[15:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>clkpll_cal_status</name>
              <description>clkpll cal status:  0: not started, 1: on-going, 2: fail, 3:pass</description>
              <bitRange>[13:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>inc_acal_status</name>
              <description>incremental acal status:  0: not started, 1: on-going, 2: fail, 3:pass</description>
              <bitRange>[11:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>inc_fcal_status</name>
              <description>incremental fcal status:  0: not started, 1: on-going, 2: fail, 3:pass</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>acal_status</name>
              <description>acal status:  0: not started, 1: on-going, 2: fail, 3:pass</description>
              <bitRange>[7:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>fcal_status</name>
              <description>fcal status:  0: not started, 1: on-going, 2: fail, 3:pass</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>adc_oscal_status</name>
              <description>GPADC and SARADC os cal status:  0: not started, 1: on-going, 2: fail, 3:pass</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rcal_status</name>
              <description>rcal status :  0: not started, 1: on-going, 2: fail, 3:pass</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>rfcal_status2</name>
          <description>rfcal_status2</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000003</resetMask>
          <fields>
            <field>
              <name>dl_rfcal_table_status</name>
              <description>no calibration, just download RFCAL table status :  0: not started, 1: on-going, 2: fail, 3:pass</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>rfcal_ctrlen</name>
          <description>Calibration mode register</description>
          <addressOffset>0x1C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x000000E0</resetValue>
          <resetMask>0x0003FFFF</resetMask>
          <fields>
            <field>
              <name>dpd_en</name>
              <description>1'b1: enable dpd mode</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>tsencal_en</name>
              <description>reserved</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pwdet_cal_en</name>
              <description>1'b1: enable power det calibration</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>riqcal_en</name>
              <description>BB IP has RX IQ already</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>tiqcal_en</name>
              <description>1'b1: enable calibration</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>lo_leakcal_en</name>
              <description>1'b1: enable calibration</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rccal_en</name>
              <description>1'b1: enable RCCAL</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>toscal_en</name>
              <description>1'b1: enable TOSCAL</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>roscal_en</name>
              <description>1'b1: enable ROSCAL</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>clkpll_cal_en</name>
              <description>1'b1: enable clkpll cal</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>roscal_inc_en</name>
              <description>1'b1: enable increamental roscal</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>acal_inc_en</name>
              <description>1'b1: enable increamental ACAL</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>fcal_inc_en</name>
              <description>1'b1: enable increamental FCAL</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>acal_en</name>
              <description>1'b1: enable ACAL</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>fcal_en</name>
              <description>1’b1:enable FCAL when pu_cal_fcal=1</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dl_rfcal_table_en</name>
              <description>1'b1: enable download RFCAL table, no calibrations</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>adc_oscal_en</name>
              <description>1'b1: enable GPADC and SARADC OS calibration</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rcal_en_resv</name>
              <description>no RCAL in this version</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>rfcal_stateen</name>
          <description>rf calibration state enabl in full cal list</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x8001DDFE</resetValue>
          <resetMask>0xC001FFFF</resetMask>
          <fields>
            <field>
              <name>rfcal_level</name>
              <description>rf calbiration level: 1:fast calibration, download previous table; 2: full cal without ATE onetime cal; 3: full cal with ATE onetime cal; during ATE, change the value from 2 to 3;</description>
              <bitRange>[31:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dpd_sten</name>
              <description>1'b1: enable dpd  state in calibration list</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>tsencal_sten</name>
              <description>1'b1: enable temperature sensor calibration  state in calibration list</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pwdet_cal_sten</name>
              <description>1'b1: enable power det calibration  state in calibration list</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>riqcal_sten</name>
              <description>Because CEVA IP has RX IQ already, reserved</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>tiqcal_sten</name>
              <description>1'b1: enable calibration state in calibration list</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>lo_leakcal_sten</name>
              <description>1'b1: enable calibration state in calibration list</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rccal_sten</name>
              <description>1'b1: enable RCCAL state in calibration list</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>toscal_sten_resv</name>
              <description>1'b1: enable tOSCAL state in calibration list</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>roscal_sten</name>
              <description>1'b1: enable ROSCAL state in calibration list</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>clkpll_cal_sten</name>
              <description>1'b1: enable clkpll calibration  state in calibration list</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>inc_acal_sten</name>
              <description>1'b1: enable increamental ACAL  state in calibration list</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>inc_fcal_sten</name>
              <description>1'b1: enable increamental FCAL  state in calibration list</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>acal_sten</name>
              <description>1'b1: enable ACAL  state in calibration list</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>fcal_sten</name>
              <description>1’b1:enable FCAL  state in calibration list</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dl_rfcal_table_sten</name>
              <description>1'b1: enable download RFCAL table state, no other calibrations</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>adc_oscal_sten</name>
              <description>1'b1: enable GPADC and SARADC OS calibration</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rcal_sten_resv</name>
              <description>1'b1: enable RCAL  state in calibration list</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>saradc_resv</name>
          <description>SARADC Control Registers</description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields />
        </register>
        <register>
          <name>rf_base_ctrl1</name>
          <description>ZRF Control register 0</description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x1005550F</resetValue>
          <resetMask>0x180FFF0F</resetMask>
          <fields>
            <field>
              <name>mbg_trim</name>
              <description>(added)bandgap curve trimming</description>
              <bitRange>[28:27]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pud_vbuf_lodist_dly</name>
              <description>PUD_VBUF_LODIST delay, PUD delay to bypass resistor to charge the capacitor fast  2'b00: 2 us 2'b01: 4 us 2'b10: 6 us 2'b11: 8 us</description>
              <bitRange>[19:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pud_vbuf_fbdv_dly</name>
              <description>PUD_VBUF_FBDV delay, PUD delay to bypass resistor to charge the capacitor fast  2'b00: 2 us 2'b01: 4 us 2'b10: 6 us 2'b11: 8 us</description>
              <bitRange>[17:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pud_pa_dly</name>
              <description>PUD_PA delay, to bypass R in RC filtering for fast settling at REF_CLK rate 2'b00: 1.5 us 2'b01: 3 us 2'b10: 4.5 us 2'b11: 6 us</description>
              <bitRange>[15:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pud_iref_dly</name>
              <description>PUD_IREF delay, to bypass R in RC filtering for fast settling at REF_CLK rate 2'b00: 2 us 2'b01: 4 us 2'b10: 6 us 2'b11: 8 us</description>
              <bitRange>[13:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pud_vco_dly</name>
              <description>PUD_VCO delay, PUD delay to bypass resistor to charge the capacitor fast  2'b00: 2 us 2'b01: 4 us 2'b10: 6 us 2'b11: 8 us</description>
              <bitRange>[11:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ppu_lead</name>
              <description>pre PD signal lead to PU signal, to define lead time between PPU_xxxx and PU_xxx, ex: PPU_VCO and PU_VCO 2'b00: 0.2 us 2'b01: 0.4 us 2'b10: 0.6 us 2'b11: 0.8 us</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>lo_sdm_rst_dly</name>
              <description>programable ref_clk delay, from falling edge of ana_sdm_rst to falling edge of ctrl_txdp_clr</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>aupll_sdm_rst_dly</name>
              <description>programable ref_clk delay, from falling edge of ana_sdm_rst to falling edge of ctrl_txdp_clr</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>rf_base_ctrl2</name>
          <description>ZRF Control register 0</description>
          <addressOffset>0x2C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00005FFF</resetValue>
          <resetMask>0x00005FFF</resetMask>
          <fields>
            <field>
              <name>txcal_ctrl_hw</name>
              <description>1: tx calibration related control bits are controlled by dsp 0: tx calibration related control bits are controlled by this register map  Related Signals: tbb_tosdac_i/tbb_tosdac_q/tx_iqc_gain/tx_iqc_phase</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>adda_ctrl_hw</name>
              <description>1: adda_lo_dvddsel is controlled by dsp 0: adda_lo_dvddse is controlled by this register map</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rbb_pkdet_out_rstn_ctrl_hw</name>
              <description>1: rbb_pkdet_out_rstn is controlled by dsp 0: rbb_pkdet_out_rstn is controlled by this register map</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rbb_pkdet_en_ctrl_hw</name>
              <description>1: rbb_pkdet_en is controlled by dsp 0: rbb_pkdet_en is controlled by this register map</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>sdm_ctrl_hw</name>
              <description>1: lo sdm dither related control bits are controlled by dsp 0: lo sdm dither related control bits are controlled by this register map Related Signals: lo_sdm_bypass</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>inc_fcal_ctrl_en_hw</name>
              <description>1: fcal_inc_en is controlled by dsp 0: fcal_inc_en are controlled by this register map</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>inc_acal_ctrl_en_hw</name>
              <description>1: acal_inc_en is controlled by dsp 0: acal_inc_en is controlled by this register map</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>lo_ctrl_hw</name>
              <description>1: lo bandwidth/idac/fcw control bits are controlled by hardware logic input 0: lo bandwidth/idac/fcw control bits are controlled by this register map Related Singals: fsm_lo_sdm, fsm_lo_sdm_rstb, fsm_lo_fbdv_rst, fsm_lo_pfd_rst_csd, lo_fbdv_halfstep_en, lo_cp_sel, lo_lf_cz, lo_lf_rz, lo_lf_r4</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rxcal_ctrl_hw</name>
              <description>1: rx calibration related control bits are controlled by dsp 0: rx calibration related control bits are controlled by this register map value Related Signals: rosdac_i_hw/rosdac_q_hw</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rbb_bw_ctrl_hw</name>
              <description>1: rbb_bt_mode is controlled by dsp 0: rbb_bt_mode is controlled by this register map value</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>lna_ctrl_hw</name>
              <description>1: lna bm and csw are controlled by hardware logic input 0: lna bm and csw are controlled by this register map</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>tx_gain_ctrl_hw</name>
              <description>1: TX gain control are controlled by hardware logic input, ex gx_xxx_hw 0: TX gain control bits are controlled by this register map gc_xxx  value</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rx_gain_ctrl_hw</name>
              <description>1: RX gain control are controlled by hardware logic input, ex gx_xxx_hw 0: RX gain control bits are controlled by this register map gc_xxx  value</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pu_ctrl_hw</name>
              <description>1: pu control bits are controlled by hardware logic input, ex: pu_xxx_hw  0: pu regs are controlled by this register map pu_xxx  value</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>pucr1</name>
          <description>pucr1</description>
          <addressOffset>0x30</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0C000000</resetValue>
          <resetMask>0xFFFFFF03</resetMask>
          <fields>
            <field>
              <name>pu_tosdac</name>
