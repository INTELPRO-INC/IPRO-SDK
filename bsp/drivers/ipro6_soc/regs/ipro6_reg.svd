          <resetMask>0x077FFA9F</resetMask>
          <fields>
            <field>
              <name>hbn_state</name>
              <description>SW polling until 0 (default 4'h3 @pwron)</description>
              <bitRange>[31:28]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>sram_slp</name>
              <description>SW polling until 0 (default 1'b1 @pwron)</description>
              <bitRange>[27:27]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>sram_slp_option</name>
              <description />
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pwr_on_option</name>
              <description />
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pu_dcdc18_aon</name>
              <description>Power On DCDC18 during Power On Sequence (require 400~800us)</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>hbn_ldo11_aon_vout_sel</name>
              <description>VDD11_AON Voltage Out Select @ Enter hibernate</description>
              <bitRange>[22:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
