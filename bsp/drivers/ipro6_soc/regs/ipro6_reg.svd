    <peripheral>
      <name>ETHMAC</name>
      <version>1.0</version>
      <description>ETHMAC</description>
      <groupName>ETHMAC</groupName>
      <baseAddress>0x30083000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>MODE</name>
          <description>MODE</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0002A008</resetValue>
          <resetMask>0x00FFFFFF</resetMask>
          <fields>
            <field>
              <name>MACSPEED</name>
              <description>MAC Speed 0: 10Mbps 1: 100Mbps</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RECSMALL</name>
              <description>Receive small frame enable 0: Frames smaller than MINFL are ignored. 1: Frames smaller than MINFL are accepted.</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PAD</name>
              <description>Padding enable 0: Do not add pads to frames shorter than MINFL. 1: Add pads to short frames, until the length equals MINFL.</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>HUGEN</name>
              <description>Huge frames enable 0: The maximum frame length is MAXFL. All additional bytes are dropped. 1: Frame size is not limited by MAXFL and can be up to 64K bytes.</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CRCEN</name>
              <description>CRC Enable 0: TX MAC does not append CRC field. 1: TX MAC will append CRC field to every frame.</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>FULLD</name>
              <description>Full duplex 0: Half duplex mode. 1: Full duplex mode.</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>IFG</name>
              <description>Inter frame gap check 0: IFG is verified before each frame be received. 1: All frames are received regardless to IFG requirement.</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PRO</name>
              <description>Promiscuous mode enable 0: The destination address is checked before receiving. 1: All frames received regardless of the address.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BRO</name>
              <description>Broadcast address enable 0: Reject all frames containing the broadcast address unless the PRO bit is asserted. 1: Receive all frames containing broadcast address.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>NOPRE</name>
              <description>No preamble mode 0: 7-byte preamble will be sent. 1: No preamble will be sent.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TXEN</name>
              <description>Transmit enable 0: Transmitter is disabled. 1: Transmitter is enabled. If TX_BD_NUM equals 0x0 (zero buffer descriptors are used), then the transmitter is disabled regardless of TXEN.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RXEN</name>
              <description>Receiver enable 0: Receiver is disabled. 1: Receiver is enabled. If TX_BD_NUM equals 0x80 (all buffer descriptors are used for TX), then the receiver is disabled regardless of RXEN.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INT_SOURCE</name>
          <description>INT_SOURCE</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000007F</resetMask>
          <fields>
            <field>
              <name>RXC</name>
              <description>Receive control frame This bit indicates that the control frame was received. It is cleared by writing 1 to it. Bit RXFLOW in the CTRLMODE register must be set to 1 in order to get the RXC bit set.</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TXC</name>
              <description>Transmit control frame This bit indicates that a control frame was transmitted. It is cleared by writing 1 to it. Bit TXFLOW in the CTRLMODE register must be set to 1 in order to get the TXC bit set.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BUSY</name>
              <description>Busy This bit indicates that RX packet is being received and there is no empty buffer descriptor to use. It iscleared by writing 1 to it. This bit appears regardless to the IRQ bits in the Receive Buffer Descriptor.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RXE</name>
              <description>Receive error This bit indicates that an error occurred while receiving data (overrun, receiver error, dribble nibble, too long, &gt;64K, CRC error, bus error or late collision. It is cleared by writing 1 to it. This bit appears only when IRQ bit is set in the Receive Buffer Descriptor.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RXB</name>
              <description>Receive frame This bit indicates that a frame was received. It is cleared by writing 1 to it. This bit appears only when IRQ bit is set in the Receive Buffer Descriptor.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TXE</name>
              <description>Transmit error This bit indicates that a buffer was not transmitted due to a transmit error (underrun, retransmission limit, late collision, bus error or defer timeout). It is cleared by writing 1 to it. This bit appears only when IRQ bit is set in the Transmit Buffer Descriptor.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TXB</name>
              <description>Transmit buffer This bit indicates that a buffer has been transmitted. It is cleared by writing 1 to it. This bit appears only when IRQ bit is set in the Transmit Buffer Descriptor.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INT_MASK</name>
          <description>INT_MASK</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000007F</resetValue>
          <resetMask>0x0000007F</resetMask>
          <fields>
            <field>
              <name>RXC_M</name>
              <description>Receive control frame mask ENABLE 0: Interrupt is un-masked 1: Interrupt is masked</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TXC_M</name>
              <description>Transmit control frame mask ENABLE 0: Interrupt is un-masked 1: Interrupt is masked</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BUSY_M</name>
              <description>Busy mask ENABLE 0: Interrupt is un-masked 1: Interrupt is masked</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RXE_M</name>
              <description>Receive error mask ENABLE 0: Interrupt is un-masked 1: Interrupt is masked</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RXB_M</name>
              <description>Receive frame mask ENABLE 0: Interrupt is un-masked 1: Interrupt is masked</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TXE_M</name>
              <description>Transmit error mask ENABLE 0: Interrupt is un-masked 1: Interrupt is masked</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TXB_M</name>
              <description>Transmit buffer mask ENABLE 0: Interrupt is un-masked 1: Interrupt is masked</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>IPGT</name>
          <description>IPGT</description>
          <addressOffset>0xC</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000018</resetValue>
          <resetMask>0x0000007F</resetMask>
          <fields>
            <field>
              <name>IPGT</name>
              <description>Inter packet gap The recommended value is 0x18 (24 clock cycles), which equals 9.6 us for 10 Mbps and 0.96 us for 100 Mbps mode</description>
              <bitRange>[6:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PACKETLEN</name>
          <description>PACKETLEN</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00400600</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MINFL</name>
              <description>Minimum frame length The minimum Ethernet packet is 64 bytes long (0x40). To receive small packets, assert the RECSMALL bit or change the MINFL value. To transmit small packets, assert the PAD bit or change the MINFL value.</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MAXFL</name>
              <description>Maximum frame length The maximum Ethernet packet is 1518 bytes long. To support this and to have some additional space for tags, a default maximum packet length equals to 1536 bytes (0x600). For bigger packets, you can assert the HUGEN bit or increase the value of MAXFL field.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>COLLCONFIG</name>
          <description>COLLCONFIG</description>
          <addressOffset>0x1C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x000F003F</resetValue>
          <resetMask>0x000F003F</resetMask>
          <fields>
            <field>
              <name>MAXRET</name>
              <description>Maximum retry This field specifies the maximum number of consequential retransmission attempts after the collision is detected. When the maximum number has been reached, the TX MAC reports an error and stops transmitting the current packet. According to the Ethernet standard, the MAXRET default value is set to 0xf (15).</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>COLLVALID</name>
              <description>Collision valid This field specifies a collision time window. A collision that occurs later than the time window is reported as a "Late Collisions" and transmission of the current packet is aborted.</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TX_BD_NUM</name>
          <description>TX_BD_NUM</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000040</resetValue>
          <resetMask>0x000000FF</resetMask>
          <fields>
            <field>
              <name>RXBDPTR</name>
              <description>RX buffer descriptors (BD) pointer, pointing at the RXBD currently being used</description>
              <bitRange>[30:24]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>TXBDPTR</name>
              <description>TX buffer descriptors (BD) pointer, pointing at the TXBD currently being used</description>
              <bitRange>[22:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>TXBDNUM</name>
              <description>TX buffer descriptors (BD) number Number of TX BD. TX and RX share 128 (0x80) descriptors, so the number of RX BD equals 0x80 - TXBDNUM. The maximum number of TXBDNUM is 0x80. Values greater then 0x80 cannot be written into this register.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MIIMODE</name>
          <description>MIIMODE</description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000064</resetValue>
          <resetMask>0x000001FF</resetMask>
          <fields>
            <field>
              <name>MIINOPRE</name>
              <description>No preamble for Management Data (MD) 0: 32-bit preamble will be sent. 1: No preamble will be sent.</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CLKDIV</name>
              <description>Clock divider for Management Data Clock (MDC) The source clock is bus clock and can be divided by any even number.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MIICOMMAND</name>
          <description>MIICOMMAND</description>
          <addressOffset>0x2C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000007</resetMask>
          <fields>
            <field>
              <name>WCTRLDATA</name>
              <description>Write control data, setting this bit to 1 will trigger the command (auto cleared) Note: [2]/[1]/[0] cannot be asserted at the same time, execute one command at a time</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RSTAT</name>
              <description>Read status, setting this bit to 1 will trigger the command (auto cleared) Note: [2]/[1]/[0] cannot be asserted at the same time, execute one command at a time</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SCANSTAT</name>
              <description>Scan status, setting this bit to 1 will trigger the command (auto cleared) Note: [2]/[1]/[0] cannot be asserted at the same time, execute one command at a time</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MIIADDRESS</name>
          <description>MIIADDRESS</description>
          <addressOffset>0x30</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00001F1F</resetMask>
          <fields>
            <field>
              <name>RGAD</name>
              <description>Register Address</description>
              <bitRange>[12:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>FIAD</name>
              <description>PHY Address</description>
              <bitRange>[4:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MIITX_DATA</name>
          <description>MIITX_DATA</description>
          <addressOffset>0x34</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FFFF</resetMask>
          <fields>
            <field>
              <name>CTRLDATA</name>
              <description>Control Data to be written to PHY</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MIIRX_DATA</name>
          <description>MIIRX_DATA</description>
          <addressOffset>0x38</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>PRSD</name>
              <description>Received Data from PHY</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MIISTATUS</name>
          <description>MIISTATUS</description>
          <addressOffset>0x3C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>MIIM_BUSY</name>
              <description>MIIM I/F busy signal 0: The MIIM I/F is ready. 1: The MIIM I/F is busy.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>MIIM_LINKFAIL</name>
              <description>MIIM I/F link fail signal</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MAC_ADDR0</name>
          <description>MAC_ADDR0</description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MAC_B2</name>
              <description>Ethernet MAC address byte 2</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MAC_B3</name>
              <description>Ethernet MAC address byte 3</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MAC_B4</name>
              <description>Ethernet MAC address byte 4</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MAC_B5</name>
              <description>Ethernet MAC address byte 5</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MAC_ADDR1</name>
          <description>MAC_ADDR1</description>
          <addressOffset>0x44</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FFFF</resetMask>
          <fields>
            <field>
              <name>MAC_B0</name>
              <description>Ethernet MAC address byte 0</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MAC_B1</name>
              <description>Ethernet MAC address byte 1</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>HASH0_ADDR</name>
          <description>HASH0_ADDR</description>
          <addressOffset>0x48</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>HASH0</name>
              <description>Lower 32-bit of HASH register</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>HASH1_ADDR</name>
          <description>HASH1_ADDR</description>
          <addressOffset>0x4C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>HASH1</name>
              <description>Upper 32-bit of HASH register</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TXCTRL</name>
          <description>TXCTRL</description>
          <addressOffset>0x50</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0001FFFF</resetMask>
          <fields>
            <field>
              <name>TXPAUSERQ</name>
              <description>TX Pause Request Writing 1 to this bit starts sending control frame and is automatically cleared to zero.</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TXPAUSETV</name>
              <description>TX Pause Timer Value The value that is sent in the pause control frame.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>PDS</name>
      <version>1.0</version>
      <description>PDS</description>
      <groupName>PDS</groupName>
      <baseAddress>0x3008E000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>PDS_CTL</name>
          <description>PDS_CTL</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x14006B00</resetValue>
          <resetMask>0xFFDFFFFF</resetMask>
          <fields>
            <field>
              <name>cr_pds_gpio_iso_mode</name>
              <description>1: HW Keep GPIO  @ PDS7 0 : Clear this bit after PDS7 to release GPIO</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_start_use_tbtt_sleep</name>
              <description>1 : PDS Auto Sleep When wifi_tbtt_sleep_irq detect to 1  0 : don’t touch sleep</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_ctrl_rf</name>
              <description>00 : PDS don’t control RF on/off 01 : PDS control RF on/off depend on misc_pwr_off 10 : PDS control RF on/off depend on  any power off 11 : PDS control RF on/off whe  pds at idle state</description>
              <bitRange>[29:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_ldo11_vol</name>
              <description>LDO11 voltage value in PDS mode output voltage sel: 0: 0.9V, 4: 1.0V, 8: 1.1V, 12: 1.2V, 25mV/step</description>
              <bitRange>[27:23]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_ctrl_wifipll_pd</name>
              <description>PDS Control WIFI PLL off When pds_pwr_off</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_ctrl_aupll_pd</name>
              <description>PDS Control Audio PLL off When pds_pwr_off</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_ctrl_usbpll_pd</name>
              <description>PDS Control USB PLL off When pds_pwr_off</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_ldo11_vsel_en</name>
              <description>PDS "SLEEP" control LDO11 voltage enable</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_rc32m_off_dis</name>
              <description>1 : RC32M always on  @any state 0 : RC32M on/off controlled by PDS state</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_rst_soc</name>
              <description>0 : no pds_reset 1: pds_rst controlled by PDS</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_ctrl_soc_enb</name>
              <description>1 :pds_soc_enb controlled by PDS 0 :pds_soc_enb always active</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_pd_xtal</name>
              <description>0 : don’t_touch xtal  during PDS 1 : xtal power down during PDS</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_pwr_off</name>
              <description>0 : don’t_touch Power during PDS    1 : Power off during PDS      (each power domain can has its own control)</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_wait_xtal_rdy</name>
              <description>0 : Skip wait XTAL Ready before  PDS Interrupt 1 : wait XTAL Ready during before PDS Interrupt</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_iso_en</name>
              <description>0 : don’t_touch Isolation during PDS (all power domain) 1 : Isolation during PDS      (each power domain can has its own control)</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_glb_reg_reset_protect</name>
              <description>1: avoid glb_reg reset by any reset</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_mem_stby</name>
              <description>0 : don’t_touch mem_stby during PDS 1 : mem_stby during PDS     (each power domain can has its own control)</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_gate_clk</name>
              <description>0 : don’t_touch clock gating during PDS (all power domain) 1 : gate clock during PDS  (each pwr domain has its own control)</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_pd_dcdc18</name>
              <description>0 : don’t_touch dcdc18 during PDS 1 : power down dcdc18 during PDS</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_ctrl_gpio_ie_pu_pd</name>
              <description>1: allow PDS Control the GPIO IE/PU/PD at Sleep Mode</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_pd_bg_sys</name>
              <description>0 : don’t_touch bg_sys during PDS 1 : power down bg_sys during PDS</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_pd_ldo11</name>
              <description>0 : don’t_touch ldo11 during PDS 1 : power down ldo11 during PDS</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_wifi_save_state</name>
              <description>Save WIFI State Before Enter PDS</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_xtal_force_off</name>
              <description />
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_sleep_forever</name>
              <description />
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pds_start_ps</name>
              <description>Enter PDS</description>
              <bitRange>[0:0]</bitRange>
