        <register>
          <name>uart_int_sts</name>
          <description>UART interrupt status</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>urx_ad5_int</name>
              <description>UART RX ABR Detection finish interrupt using codeword 0x55</description>
              <bitRange>[11:11]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>urx_ads_int</name>
              <description>UART RX ABR Detection finish interrupt using START bit</description>
              <bitRange>[10:10]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>urx_bcr_int</name>
              <description>UART RX byte count reached interrupt</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>urx_lse_int</name>
              <description>UART RX LIN mode sync field error interrupt</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>urx_fer_int</name>
              <description>UART RX FIFO error interrupt, auto-cleared when FIFO overflow/underflow error flag is cleared</description>
              <bitRange>[7:7]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>utx_fer_int</name>
              <description>UART TX FIFO error interrupt, auto-cleared when FIFO overflow/underflow error flag is cleared</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>urx_pce_int</name>
              <description>UART RX parity check error interrupt</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>urx_rto_int</name>
              <description>UART RX Time-out interrupt</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>urx_frdy_int</name>
              <description>UART RX FIFO ready (rx_fifo_cnt &gt; rx_fifo_th) interrupt, auto-cleared when data is popped</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>utx_frdy_int</name>
              <description>UART TX FIFO ready (tx_fifo_cnt &gt; tx_fifo_th) interrupt, auto-cleared when data is pushed</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>urx_end_int</name>
              <description>UART RX transfer end interrupt (set according to cr_urx_len)</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>utx_end_int</name>
              <description>UART TX transfer end interrupt (set according to cr_utx_len)</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
