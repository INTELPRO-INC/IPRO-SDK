          <resetValue>0xC8C8C800</resetValue>
          <resetMask>0xFFFFFF87</resetMask>
          <fields>
            <field>
              <name>cr_code1_high_time</name>
              <description>Used to generate Code 1  Duty Cycle Waveform (in units of xclk (XTAL or RC32M) clock cycle) waveform keep high during cr_code1_high_time  waveform keep low  during cr_code1_low_time (cr_code_total_time - cr_code1_high_time )</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_code0_high_time</name>
              <description>Used to generate Code 0  Duty Cycle Waveform (in units of xclk (XTAL or RC32M) clock cycle) waveform keep high during cr_code0_high_time  waveform keep low  during cr_code0_low_time (cr_code_total_time - cr_code0_high_time)</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_code_total_time</name>
              <description>Used to define Code0/Code1 total waveform time</description>
              <bitRange>[15:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_invert_code1_high</name>
              <description>1: cr_code1_high_time -&gt; cr_code1_low_time</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_invert_code0_high</name>
              <description>1: cr_code0_high_time -&gt; cr_code0_low_time</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_gpio_tx_en</name>
              <description>Enable GPIO DMA OUT/GPIO DMA Latch</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>gpio_cfg143</name>
          <description>gpio_cfg143</description>
          <addressOffset>0xB00</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xE3800000</resetValue>
          <resetMask>0xE3FF008F</resetMask>
          <fields>
            <field>
              <name>cr_gpio_tx_fer_en</name>
              <description>Interrupt enable of gpio_tx_fer_int (GPIO DMA FIFO Underflow or Overflow)</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_gpio_tx_fifo_en</name>
              <description>Interrupt enable of gpio_tx_fifo_int</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_gpio_tx_end_en</name>
              <description>Interrupt enable of gpio_tx_end_int</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>r_gpio_tx_fer_int</name>
              <description>GPIO TX FIFO error interrupt, auto-cleared when FIFO overflow/underflow error flag is cleared</description>
              <bitRange>[28:28]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>r_gpio_tx_fifo_int</name>
              <description>GPIO TX FIFO ready (tx_fifo_cnt &gt; tx_fifo_th) interrupt, auto-cleared when data is pushed</description>
              <bitRange>[27:27]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>r_gpio_tx_end_int</name>
              <description>GPIO TX END Interrupt (GPIO DMA FIFO Empty)</description>
              <bitRange>[26:26]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>cr_gpio_tx_fer_mask</name>
              <description>Interrupt mask of gpio_tx_fer_int</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_gpio_tx_fifo_mask</name>
              <description>Interrupt mask of gpio_tx_fifo_int</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_gpio_tx_end_mask</name>
              <description>Interrupt mask of gpio_tx_end_int</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_gpio_tx_fifo_th</name>
              <description>TX FIFO threshold, dma_tx_req will not be asserted if tx_fifo_cnt is less than this value</description>
              <bitRange>[22:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>gpio_tx_fifo_cnt</name>
              <description>TX FIFO available count</description>
              <bitRange>[15:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>cr_gpio_dma_park_value</name>
              <description>1: park at high level when TX FIFO empty 0: park at low level when TX FIFO empty</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>gpio_tx_fifo_underflow</name>
              <description>Underflow flag of TX FIFO, can be cleared by tx_fifo_clr</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>gpio_tx_fifo_overflow</name>
              <description>Overflow flag of TX FIFO, can be cleared by tx_fifo_clr</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>gpio_tx_end_clr</name>
              <description>Interrupt clear of gpio_tx_end_int</description>
              <bitRange>[3:3]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>gpio_tx_fifo_clr</name>
              <description>Clear signal of TX FIFO</description>
              <bitRange>[2:2]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>cr_gpio_dma_out_sel_latch</name>
              <description>1 : select latch format (8bit set/8bit clr) , 0 : select 16bit output value</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_gpio_dma_tx_en</name>
              <description>Enable signal of dma_tx_req/ack interface</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>gpio_cfg144</name>
