            <field>
              <name>rx_fifo_clr</name>
              <description>Clear signal of RX FIFO</description>
              <bitRange>[3:3]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>tx_fifo_clr</name>
              <description>Clear signal of TX FIFO</description>
              <bitRange>[2:2]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>uart_dma_rx_en</name>
              <description>Enable signal of dma_rx_req/ack interface</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>uart_dma_tx_en</name>
              <description>Enable signal of dma_tx_req/ack interface</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>uart_fifo_config_1</name>
          <description>uart_fifo_config_1</description>
          <addressOffset>0x84</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x1F1F0000</resetMask>
          <fields>
            <field>
              <name>rx_fifo_th</name>
              <description>RX FIFO threshold, dma_rx_req will not be asserted if rx_fifo_cnt is less than this value</description>
              <bitRange>[28:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>tx_fifo_th</name>
              <description>TX FIFO threshold, dma_tx_req will not be asserted if tx_fifo_cnt is less than this value</description>
              <bitRange>[20:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rx_fifo_cnt</name>
              <description>RX FIFO available count</description>
              <bitRange>[13:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>tx_fifo_cnt</name>
              <description>TX FIFO available count</description>
              <bitRange>[5:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>uart_fifo_wdata</name>
          <description>uart_fifo_wdata</description>
          <addressOffset>0x88</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000FF</resetMask>
          <fields>
            <field>
              <name>uart_fifo_wdata</name>
              <description />
              <bitRange>[7:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>uart_fifo_rdata</name>
          <description>uart_fifo_rdata</description>
          <addressOffset>0x8C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>uart_fifo_rdata</name>
              <description />
              <bitRange>[7:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>UART1</name>
      <version>1.0</version>
      <description>UART1</description>
      <groupName>UART1</groupName>
      <baseAddress>0x3000B000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>utx_config</name>
          <description>utx_config</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00008F00</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>cr_utx_len</name>
              <description>Length of UART TX data transfer (Unit: character/byte) (Don't-care if cr_utx_frm_en is enabled)</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_utx_bit_cnt_b</name>
              <description>UART TX BREAK bit count (for LIN protocol) Note: Additional 8 bit times will be added since LIN Break field requires at least 13 bit times</description>
              <bitRange>[15:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_utx_bit_cnt_p</name>
              <description>UART TX STOP bit count (unit: 0.5 bit)</description>
              <bitRange>[12:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_utx_bit_cnt_d</name>
              <description>UART TX DATA bit count for each character</description>
              <bitRange>[10:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_utx_ir_inv</name>
              <description>Inverse signal of UART TX output in IR mode</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_utx_ir_en</name>
              <description>Enable signal of UART TX IR mode</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_utx_prt_sel</name>
              <description>Select signal of UART TX parity bit 1: Odd parity 0: Even parity</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_utx_prt_en</name>
              <description>Enable signal of UART TX parity bit</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_utx_lin_en</name>
              <description>Enable signal of UART TX LIN mode (LIN header will be sent before sending data)</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_utx_frm_en</name>
              <description>Enable signal of UART TX freerun mode (utx_end_int will be disabled)</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_utx_cts_en</name>
              <description>Enable signal of UART TX CTS flow control function</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_utx_en</name>
              <description>Enable signal of UART TX function Asserting this bit will trigger the transaction, and should be de-asserted after finish</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>urx_config</name>
          <description>urx_config</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000700</resetValue>
          <resetMask>0xFFFFFFFB</resetMask>
          <fields>
            <field>
              <name>cr_urx_len</name>
              <description>Length of UART RX data transfer (Unit: character/byte) urx_end_int will assert when this length is reached</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_urx_deg_cnt</name>
              <description>De-glitch function cycle count</description>
              <bitRange>[15:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_urx_deg_en</name>
              <description>Enable signal of RXD input de-glitch function</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_urx_bit_cnt_d</name>
              <description>UART RX DATA bit count for each character</description>
              <bitRange>[10:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_urx_ir_inv</name>
              <description>Inverse signal of UART RX input in IR mode</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_urx_ir_en</name>
              <description>Enable signal of UART RX IR mode</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_urx_prt_sel</name>
              <description>Select signal of UART RX parity bit 1: Odd parity 0: Even parity</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_urx_prt_en</name>
              <description>Enable signal of UART RX parity bit</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_urx_lin_en</name>
              <description>Enable signal of UART RX LIN mode (LIN header will be required and checked before receiving data)</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_urx_abr_en</name>
              <description>Enable signal of UART RX Auto Baud Rate detection function</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_urx_en</name>
              <description>Enable signal of UART RX function</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>uart_bit_prd</name>
          <description>uart_bit_prd</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00FF00FF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>cr_urx_bit_prd</name>
              <description>Period of each UART RX bit, related to baud rate</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_utx_bit_prd</name>
              <description>Period of each UART TX bit, related to baud rate</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>data_config</name>
          <description>data_config</description>
          <addressOffset>0xC</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>
          <fields>
            <field>
              <name>cr_uart_bit_inv</name>
              <description>Bit-inverse signal for each data byte 0: Each byte is sent out LSB-first 1: Each byte is sent out MSB-first</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>utx_ir_position</name>
          <description>utx_ir_position</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x009F0070</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>cr_utx_ir_pos_p</name>
              <description>STOP position of UART TX IR pulse</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_utx_ir_pos_s</name>
              <description>START position of UART TX IR pulse</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>urx_ir_position</name>
          <description>urx_ir_position</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000006F</resetValue>
          <resetMask>0x0000FFFF</resetMask>
          <fields>
            <field>
              <name>cr_urx_ir_pos_s</name>
              <description>START position of UART RXD pulse recovered from IR signal</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>urx_rto_timer</name>
          <description>urx_rto_timer</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000000F</resetValue>
          <resetMask>0x000000FF</resetMask>
          <fields>
            <field>
              <name>cr_urx_rto_value</name>
              <description>Time-out value for triggering RTO interrupt (unit: bit time)</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>uart_sw_mode</name>
          <description>uart_sw_mode</description>
          <addressOffset>0x1C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000000F</resetMask>
          <fields>
            <field>
              <name>cr_urx_rts_sw_val</name>
              <description>UART RX RTS output SW control value</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_urx_rts_sw_mode</name>
              <description>UART RX RTS output SW control mode</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_utx_txd_sw_val</name>
              <description>UART TX TXD output SW control value</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_utx_txd_sw_mode</name>
              <description>UART TX TXD output SW control mode</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>uart_int_sts</name>
          <description>UART interrupt status</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>urx_ad5_int</name>
              <description>UART RX ABR Detection finish interrupt using codeword 0x55</description>
              <bitRange>[11:11]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>urx_ads_int</name>
              <description>UART RX ABR Detection finish interrupt using START bit</description>
              <bitRange>[10:10]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>urx_bcr_int</name>
              <description>UART RX byte count reached interrupt</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>urx_lse_int</name>
              <description>UART RX LIN mode sync field error interrupt</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>urx_fer_int</name>
              <description>UART RX FIFO error interrupt, auto-cleared when FIFO overflow/underflow error flag is cleared</description>
              <bitRange>[7:7]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>utx_fer_int</name>
              <description>UART TX FIFO error interrupt, auto-cleared when FIFO overflow/underflow error flag is cleared</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>urx_pce_int</name>
              <description>UART RX parity check error interrupt</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>urx_rto_int</name>
              <description>UART RX Time-out interrupt</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>urx_frdy_int</name>
              <description>UART RX FIFO ready (rx_fifo_cnt &gt; rx_fifo_th) interrupt, auto-cleared when data is popped</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>utx_frdy_int</name>
              <description>UART TX FIFO ready (tx_fifo_cnt &gt; tx_fifo_th) interrupt, auto-cleared when data is pushed</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>urx_end_int</name>
              <description>UART RX transfer end interrupt (set according to cr_urx_len)</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>utx_end_int</name>
              <description>UART TX transfer end interrupt (set according to cr_utx_len)</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>uart_int_mask</name>
          <description>UART interrupt mask</description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
