              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_utx_fer_mask</name>
              <description>Interrupt mask of utx_fer_int</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_urx_pce_mask</name>
