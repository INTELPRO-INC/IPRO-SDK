              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>acomp0_pos_sel</name>
              <description>ACOMP0 positive input select bits. 1'h0 acomp_ch&lt;0&gt; 1'h1 acomp_ch&lt;1&gt; 0x2 acomp_ch&lt;2&gt; 0x3 acomp_ch&lt;3&gt; 0x4 acomp_ch&lt;4&gt; 0x5 acomp_ch&lt;5&gt; 0x6 acomp_ch&lt;6&gt; 0x7 acomp_ch&lt;7&gt; 0x8 daca 0x9 dacb 0xA vref_bg_1p25 0xB Vbat*vref_sel 0xC Vbat*vref_sel 0xD Vbat*vref_sel 0xE Vbat*vref_sel 0xF vssa</description>
              <bitRange>[25:22]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>acomp0_neg_sel</name>
              <description>ACOMP0 negative input select bits. 1'h0 acomp_ch&lt;0&gt; 1'h1 acomp_ch&lt;1&gt; 0x2 acomp_ch&lt;2&gt; 0x3 acomp_ch&lt;3&gt; 0x4 acomp_ch&lt;4&gt; 0x5 acomp_ch&lt;5&gt; 0x6 acomp_ch&lt;6&gt; 0x7 acomp_ch&lt;7&gt; 0x8 daca 0x9 dacb 0xA vref_bg_1p25 0xB Vbat*vref_sel 0xC Vbat*vref_sel 0xD Vbat*vref_sel 0xE Vbat*vref_sel 0xF vssa</description>
              <bitRange>[21:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>acomp0_level_sel</name>
              <description>Scaling factor select bits for VIO reference level. 1'h0X Scaling factor=0.25 1'h1X Scaling factor= 0.5 0x2X Scaling factor= 0.75 0x3X Scaling factor= 1 others reserved.</description>
              <bitRange>[17:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>acomp0_bias_prog</name>
              <description>ACOMP0 bias current control bits or response time control bits. 1'h0 power mode1 (slow response mode) 1'h1 power mode2 (medium response mode) 0x2 power mode3 (fast response mode) 0x3 Reserved</description>
              <bitRange>[11:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>acomp0_hyst_selp</name>
              <description>Select ACOMP0 positive hysteresis voltage level. 1'h0 No hysteresis 1'h1 +10 mV hysteresis 0x2 +20 mV hysteresis 0x3 +30 mV hysteresis 0x4 +40 mV hysteresis 0x5 +50 mV hysteresis 0x6 +60 mV hysteresis 0x7 +70 mV hysteresis</description>
              <bitRange>[9:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>acomp0_hyst_seln</name>
