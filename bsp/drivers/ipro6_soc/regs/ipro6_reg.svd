              <name>adpll_fsm_en</name>
              <description>1'b1 Enable the ADPLL FSM</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>adpll_lo_fsm_ext</name>
              <description>1'b1 enable the external FSM control</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
