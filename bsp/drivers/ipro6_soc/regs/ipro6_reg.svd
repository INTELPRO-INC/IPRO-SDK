              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>reg_gpio_33_int_mode_set</name>
              <description>0000 : sync falling edge trigger 0001 : sync rising edge trigger 0010 : sync low level trigger 0011 : sync high level trigger 01xx : sync rising &amp; falling edge trigger 1000 : async falling edge trigger 1001 : async rising edge trigger 1010 : async low level trigger 1011 : async high level trigger</description>
