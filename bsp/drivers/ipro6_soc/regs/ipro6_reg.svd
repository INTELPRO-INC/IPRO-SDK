          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xF0000005</resetMask>
          <fields>
            <field>
              <name>fifo_format</name>
              <description>FIFO pixel data format (see Tab 'FIFO Format' for details) 3'd0: {8'h0, B[7:0], G[7:0], R[7:0]} 3'd1: {8'h0, R[7:0], G[7:0], B[7:0]} 3'd2: {B[7:0], G[7:0], R[7:0], 8'h0} 3'd3: {R[7:0], G[7:0], B[7:0], 8'h0} 3'd4: {R_n[7:0], B[7:0], G[7:0], R[7:0]} 3'd5: {B_n[7:0], R[7:0], G[7:0], B[7:0]} 3'd6: {2{B[7:3], G[7:2], R[7:3]}} 3'd7: {2{R[7:3], G[7:2], B[7:3]}} Note: FIFO data format does not affect normal data, which is fixed to LSB sent first {Byte3[7:0], Byte2[7:0], Byte1[7:0], Byte0[7:0]}</description>
              <bitRange>[31:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>fifo_yuv_mode</name>
              <description>FIFO data YUV mode R &lt;-&gt; Y G &lt;-&gt; U/Cb B &lt;-&gt; V/Cr</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
