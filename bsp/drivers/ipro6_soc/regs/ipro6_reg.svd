              <access>read-write</access>
            </field>
            <field>
              <name>ef_wifi_dis</name>
              <description>1:disable wifi</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ef_btdm_dis</name>
              <description>1:disable btdm</description>
              <bitRange>[15:15]</bitRange>
