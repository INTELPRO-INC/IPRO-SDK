        <register>
          <name>NEW_RTC_TIME_L</name>
          <description>NEW_RTC_TIME_L</description>
          <addressOffset>0xB90</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>rtc_timer_latch_l</name>
              <description>RTC time latched value bit 31:0</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>NEW_RTC_TIME_H</name>
