      <baseAddress>0x30082000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>sf_ctrl_0</name>
          <description>sf_ctrl_0</description>
          <addressOffset>0x0</addressOffset>
