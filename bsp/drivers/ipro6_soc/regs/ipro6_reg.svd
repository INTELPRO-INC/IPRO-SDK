              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pwm_ch0_dtg</name>
              <description>PWM Channel 0 dead time generator (DTG) DTG[7:5]=0xx =&gt; DT = DTG[7:0]*1 (unit: divided PWM clock) DTG[7:5]=10x =&gt; DT = (64+DTG[5:0])*2 (unit: divided PWM clock) DTG[7:5]=110 =&gt; DT = (32+DTG[4:0])*8 (unit: divided PWM clock) DTG[7:5]=111 =&gt; DT = (32+DTG[4:0])*16 (unit: divided PWM clock)</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
