            </field>
            <field>
              <name>irq_bor_en</name>
              <description>enable brown-out interrupt</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>reg_en_hw_pu_pd</name>
              <description>1:  Pull GPIO17 @ pwr_on and pwr_rst 0 : no pull</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>hbn_pin_wakeup_mask</name>
              <description>mask hbn_pin_wakeup_event</description>
              <bitRange>[7:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>hbn_pin_wakeup_mode</name>
              <description>hbn_pin_wakeup mode  0000 : sync falling edge trigger 0001 : sync rising edge trigger 0010 : sync low level trigger 0011 : sync high level trigger 01xx : sync rising &amp; falling edge trigger 1000 : async falling edge trigger 1001 : async rising edge trigger 1010 : async low level trigger 1011 : async high level trigger</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>HBN_IRQ_STAT</name>
