        <register>
          <name>adpll_vctrl</name>
          <description>adpll_vctrl</description>
          <addressOffset>0x27C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00001000</resetValue>
          <resetMask>0x0F31D313</resetMask>
          <fields>
            <field>
              <name>adpll_vctrl_range_sel_ext_en</name>
              <description>enable external vctrl detector range selection</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>adpll_vctrl_lock_win_sel</name>
              <description>'0' for 48~80, '1' for 32~96, decide the lock detect range</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>adpll_vctrl_moni_win_sel</name>
              <description>'0' for 16~112, '1' for 32~96, decide the lock detect range</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>adpll_vctrl_det_cons_en</name>
              <description>1'b1 detect the LF output if it is out of range with consecutive given periods</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>adpll_mom_update_period</name>
              <description>00'for adaptive one, '01' 8*Tref, '10' 16*Tref,'11' 31*Tref</description>
              <bitRange>[21:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>adpll_force_mom_hold</name>
              <description>force momcap code hold, disable the fine tune of momcap</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>adpll_dco_mash_bypass</name>
              <description>bypass the dco mash1, for debug</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>adpll_capcode_bypass</name>
              <description>bypass momcap code, set the code by digital register value, software control</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>sdm_order</name>
              <description>0' 1st order, '1' 2rd order</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>sdm_dither</name>
              <description>0,1,2,3 for 1/2^17,5/2^17,21/2^17,85/2^17</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>sdm_bypass</name>
              <description>bypass fractural part of the divide ratio</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>sdmout_dly_sel</name>
              <description>select the SDM out delay, for matching the phase cancel path (DTC path) delay</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>adpll_lms</name>
