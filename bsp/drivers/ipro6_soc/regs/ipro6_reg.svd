              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_utx_frdy_mask</name>
              <description>Interrupt mask of utx_frdy_int</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_urx_end_mask</name>
