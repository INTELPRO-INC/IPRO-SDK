    <peripheral>
      <name>RF2</name>
      <version>1.0</version>
      <description>RF2</description>
      <groupName>RF2</groupName>
      <baseAddress>0x30054000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>rf_rev</name>
          <description>Silicon revision</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>hw_rev</name>
              <description>mark digital HW REV ID</description>
              <bitRange>[23:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>fw_rev</name>
              <description>mark firmware REV ID</description>
              <bitRange>[15:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>rf_rev</name>
              <description>mark RF IP rev ID</description>
              <bitRange>[7:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>dsp_readback</name>
          <description>dsp_readback</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xA0800000</resetValue>
          <resetMask>0xFFFF0000</resetMask>
          <fields>
            <field>
              <name>rbb_bw_ind_ctrl_hw</name>
              <description />
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rbb_bw_ind</name>
              <description>0: 1M mode, 1: 2M mode</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rbb_ind_ctrl_hw</name>
              <description />
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rbb_ind</name>
              <description>0: -12dB, 15: 18dB</description>
              <bitRange>[28:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ch_ind_ctrl_hw</name>
              <description />
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ch_ind</name>
              <description>0: 2400MHz, 80: 2480MHz</description>
              <bitRange>[22:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rbb_bw_ind_hw</name>
              <description>0: 1M mode, 1: 2M mode</description>
              <bitRange>[14:14]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>rbb_ind_hw</name>
              <description>0: -12dB, 15: 18dB</description>
              <bitRange>[13:9]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ch_ind_hw</name>
              <description>0: 2400MHz, 80: 2480MHz</description>
              <bitRange>[8:2]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>rf_ctrl_source</name>
          <description>Control logic switch</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x11111119</resetValue>
          <resetMask>0x11111319</resetMask>
          <fields>
            <field>
              <name>vco_idac_ctrl_hw</name>
              <description>1: vco_idac input is controlled by dsp 0: vco_idac input is controlled by register</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>inc_fcal_en_ctrl_hw</name>
              <description>1: inc_fcal_en input is controlled by dsp 0: inc_fcal_en input is controlled by register</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>lo_fcw_ctrl_hw</name>
              <description>1: lo_fcw input is controlled by dsp 0: lo_fcw input is controlled by register</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rbb_bw_ctrl_hw</name>
              <description>1: rbb_bw input is controlled by dsp 0: rbb_bw input is controlled by register</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>kcal_ratio_ctrl_hw</name>
              <description>1: kcal_ratio input is controlled by dsp 0: kcal_ratio input is controlled by register</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rosdac_ctrl_rccal</name>
              <description>1: dsp control of rosdac  from singen 0: dsp control of rosdac  from gain table</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rosdac_ctrl_hw</name>
              <description>1: rosdac input is controlled by dsp 0: rosdac input is controlled by register</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>gain_ctrl_rx_hw</name>
              <description>1: RX gain control are controlled by hardware logic input, ex gx_xxx_hw  0: RX gain control bits are controlled by this register map gc_xxx  value</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>gain_ctrl_tx_hw</name>
              <description>1: TX gain control are controlled by hardware logic input, ex gx_xxx_hw  0: TX gain control bits are controlled by this register map gc_xxx  value</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pu_ctrl_hw</name>
              <description>1: pu control bits are controlled by hardware logic input ex: pu_xxx_hw  0: pu control bits are controlled by pu_xxx  in this registermap</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>rf_cal_state_ctrl</name>
          <description>rf calibration state enable in full cal list</description>
          <addressOffset>0xC</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x000000FF</resetValue>
          <resetMask>0x000000FF</resetMask>
          <fields>
            <field>
              <name>inc_roscal_state_en</name>
              <description>1'b1: perform inc_roscal</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>inc_acal_state_en</name>
              <description>1'b1: perform inc_acal</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>inc_fcal_state_en</name>
              <description>1'b1: perform inc_fcal</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rccal_state_en</name>
              <description>1'b1: perform rccal</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>roscal_state_en</name>
              <description>1'b1: perform roscal</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>kcal_state_en</name>
              <description>1'b1: perform kal</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>acal_state_en</name>
              <description>1'b1: perform acal</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>fcal_state_en</name>
              <description>1'b1: perform fcal</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>rf_cal_switch_ctrl</name>
          <description>Calibration mode register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00011111</resetMask>
          <fields>
            <field>
              <name>inc_fcal_en_hw</name>
              <description />
              <bitRange>[17:17]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>inc_fcal_en</name>
              <description>valid when inc_fcal_en_ctrl_hw=0</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>inc_acal_en</name>
              <description />
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rccal_en</name>
              <description />
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>kcal_en</name>
              <description />
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>acal_en</name>
              <description />
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>rf_cal_status</name>
          <description>rf_cal_status</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xC00003FC</resetMask>
          <fields>
            <field>
              <name>dl_rfcal_table_status</name>
              <description>no calibration, just download RFCAL table status :  0: not started, 1: on-going, 2: fail, 3:pass</description>
              <bitRange>[31:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rccal_status</name>
              <description>0: not started, 1: on-going, 2: fail, 3:pass</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>roscal_status</name>
              <description>0: not started, 1: on-going, 2: fail, 3:pass</description>
              <bitRange>[7:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>kcal_status</name>
              <description>0: not started, 1: on-going, 2: fail, 3:pass</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>acal_status</name>
              <description>0: not started, 1: on-going, 2: fail, 3:pass</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>pu_delay_confg</name>
          <description>pu_delay_confg</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00111011</resetValue>
          <resetMask>0x00333033</resetMask>
          <fields>
            <field>
              <name>adpll_reset_width</name>
              <description>pulse width of rst_adpll 0: 0.4us, 1: 0.8us, 2: 1.2us, 3: 1.6us</description>
              <bitRange>[21:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>lo_reset_width</name>
              <description>pulse width of rst_fbdv/rst_lotpm_hfp/rst_lotpm_lfp 0: 0.1us, 1: 0.2us, 2: 0.3us, 3: 0.4us</description>
              <bitRange>[17:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>lo_reset_delay</name>
              <description>lo reset delay WRT ppu_vco 0: 0.4us 1: 0.8us 2: 1.2us 3 1.6us</description>
              <bitRange>[13:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pud_delay</name>
              <description>PUD signal delay with respect to PU 2'b00: 2 us 2'b01: 4 us 2'b10: 6 us 2'b11: 8 us</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ppu_lead</name>
              <description>PPU signal lead to PU signal 2'b00: 0.2 us 2'b01: 0.4 us 2'b10: 0.6 us 2'b11: 0.8 us</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>pucr_reg</name>
          <description>Register control of power up signals</description>
          <addressOffset>0x100</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x01800180</resetValue>
          <resetMask>0x0FFFFFFF</resetMask>
          <fields>
            <field>
