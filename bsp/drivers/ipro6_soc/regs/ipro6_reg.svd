          <fields>
            <field>
              <name>sel_rf_audio_test</name>
              <description>(Used with Bit[17]/[18]/[20]/[21] 00: No GPIO Scenario on RF1/RF2/Audio ADC/DAC Test 01: GPIO Scenario Bit [17]/[18]/[20]/[21] used for RF1  10: GPIO Scenario Bit [17]/[18]/[20]/[21] used for RF2 11: GPIO Scenario Bit [17]/[18]/[20]/[21] used for Audio</description>
              <bitRange>[31:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>audio_test_mode</name>
              <description>0 : select audio_test_in, 1: select audio_test_out</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rf1_test_mode</name>
              <description>00: no rf_test signal mux to rf_test_x 01: select rf1 adc signal mux to rf_test_x 10/11:select rf1 dac signal mux to rf_test_x</description>
              <bitRange>[26:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>p3_cci_use_io_10_13</name>
              <description>GPIO Scenario, set this bit will force GPIO10~13 to CCI Function</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ant_switch_sel</name>
              <description>0 : Select  btdm antenna switch output, 1: Select ble2 antenna switch output</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>spi2dvp_en</name>
              <description>SPI2DVP function enable</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>reg_spi_0_swap</name>
              <description>1: SWAP SPI0 MOSI with MISO ; 0 No SWAP</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>reg_spi_0_master_mode</name>
              <description>1 : SPI_0 Pad Act as Master, 0: SPI_0 Pad Act as Slave</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>swap_sflash2_io_3_io_0</name>
              <description>1 : SWAP SFLASH2 IO 3 with IO  0 : No SWAP SFLASH2 IO 3 With IO0</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>swap_sflash_io_2_cs</name>
              <description>0 : Origianl IO2 and CS 1 :  SWAP IO2 and CS</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>sel_embedded_sflash</name>
              <description>0 : Select External Sflash 1: Select Embedded Sflash (Default)</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>swap_sflash_io_3_io_0</name>
              <description>1 : SWAP SFLASH IO 3 with IO  0 : No SWAP SFLASH IO 3 With IO0</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>uart_swap_set</name>
              <description>[0] SWAP UART GPIO SET0 (GPIO0~GPIO11) (1: uart_sig[0:11] -&gt; uart_sig[6:11], uart_sig[0:5]  [0] SWAP UART GPIO SET0 (GPIO0~GPIO11) (1: uart_sig[0:11] -&gt; uart_sig[6:11], uart_sig[0:5] [0] SWAP UART GPIO SET0 (GPIO0~GPIO11) (1: uart_sig[0:11] -&gt; uart_sig[6:11], uart_sig[0:5]</description>
              <bitRange>[5:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>reg_spi_1_swap</name>
              <description>1: SWAP SPI_1 MOSI with MISO ; 0 No SWAP</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>reg_spi_1_master_mode</name>
              <description>1 : SPI_1 Pad Act as Master, 0: SPI_1 Pad Act as Slave</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
