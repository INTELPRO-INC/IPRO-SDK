              <name>pu_pkdet</name>
              <description>1'b1: power up TIA PKDET</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>trsw_en</name>
              <description>2'b3: TX mode 2'b0: RX mode</description>
              <bitRange>[27:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pu_txbuf</name>
              <description>1'b1: power up TX BUF</description>
