              <name>pds_clr_reset_event</name>
              <description>clear pds reset event</description>
              <bitRange>[31:31]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>pds_reset_event</name>
              <description>[2] : pds_rst_n (pds reset) [1]: pwr_rst_n (hbn power on reset) [0]: hreset_n (Bus Reset)</description>
              <bitRange>[26:24]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ro_pds_rf_state</name>
              <description>ST_PDS_RF_OFF         = 5'b0000 ; ST_PDS_PU_MBG         = 5'b0001 ; ST_PDS_PU_LDO15RF = 5'b0011 ; ST_PDS_PU_SFREG     = 5'b0111 ; ST_PDS_PUD_XTAL18 = 5'b01111; ST_PDS_WB_EN_AON  = 5'b11111 ;</description>
              <bitRange>[12:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ro_pds_state</name>
              <description>ST_IDLE           = 5'b00000;  ST_MEM_STBY = 5'b10000;  ST_ECG            = 5'b01000;  ST_ERST          = 5'b01100;  ST_EISO           = 5'b01111;  ST_POFF           = 5'b00111;  ST_PRE_BGON  = 5'b00011;  ST_PRE_BGON1 = 5'b00001;  ST_BGON           = 5'b00101;  ST_CLK_SW_32M= 5'b00100;  ST_PON_DCDC    = 5'b00110;  ST_PON_LDO11_MISC = 5'b01110;  ST_PON             = 5'b01010;  ST_DISO           = 5'b00010;  ST_DCG            = 5'b01101;  ST_MEM_IDLE   = 5'b11000;  ST_DRST           = 5'b01011;  ST_WAIT_EFUSE= 5'b01001;</description>
              <bitRange>[4:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>pds_ram1</name>
          <description>pds_ram1</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00180800</resetValue>
          <resetMask>0xDD3F3F00</resetMask>
          <fields>
            <field>
              <name>cr_pds_ctrl_ram_clk</name>
              <description>1 : Enable PDS Control PD_CORE SRAM Clock @ PDS Sequence</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_ctrl_ram_clk2</name>
              <description>HW Option  To assert extra clock during PDS on sequence</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_ctrl_misc_ram_clk</name>
              <description>This bit is Enable by bit [31] : cr_pds_ctrl_ram_clk 1 : PDS Control PD_CORE_MISC SRAM Clock @ PDS Sequence 0 : PDS do nothing on SRAM Clock</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_ctrl_usb_ram_clk</name>
              <description>This bit is Enable by bit [31] : cr_pds_ctrl_ram_clk 1 : PDS Control PD_usb SRAM Clock @ PDS Sequence 0 : PDS do nothing on PD_usb SRAM Clock</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_ctrl_wb_ram_clk</name>
              <description>This bit is Enable by bit [31] : cr_pds_ctrl_ram_clk 1 : PDS Control PD_WB SRAM Clock @ PDS Sequence 0 : PDS do nothing on PD_WB SRAM Clock</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_ctrl_np_ram_clk</name>
              <description>This bit is Enable by bit [31] : cr_pds_ctrl_ram_clk 1 : PDS Control PD_CORE_CPU SRAM Clock @ PDS Sequence 0 : PDS do nothing on PD_CORE_CPU SRAM Clock</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_ram_clk2_cnt</name>
              <description>HW Option : Assert Extra Clock Counter in MEM_IDLE</description>
              <bitRange>[21:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_ram_clk_cnt</name>
              <description>HW Option : Assert Extra Clock Counter in  MEM_STBY</description>
              <bitRange>[13:8]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PDS_CTL5</name>
          <description>PDS_CTL5</description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00070000</resetValue>
          <resetMask>0x00070303</resetMask>
          <fields>
            <field>
              <name>cr_pds_gpio_keep_en</name>
              <description>if cr_pds_gpio_iso_mode=1, can use bit to enable or disable keep function [0] : GPIO0~15 [1] : GPIO20~36 (not include GPIO21/22/28/29) [2] : GPIO16~19</description>
              <bitRange>[18:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_pd_ldo18io</name>
              <description>0 : don’t_touch ldo18io during PDS 1 : power down ldo18io during PDS</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_ctrl_usb33</name>
              <description>Set this bit to enable HW control turn on/off USB 3.3V @USB1.1V Power On/OFF (Replace the function of reg_pu_usb20_psw)</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_pad_od_en</name>
              <description>GPIO21/22/28/29 5V Tolerant PAD Open Drain Enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_np_wfi_mask</name>
              <description>pds start condition mask np_wfi</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
