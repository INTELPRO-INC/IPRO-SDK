              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_dvp_s2p_hs_inv</name>
              <description>Input H-Sync inverse signal 1'b0: Input is already active-high (no inverse) 1'b1: Input is active-low (inversed)</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_dvp_s2p_vs_inv</name>
