            <field>
              <name>pir_interval</name>
              <description>pir_lpf_sel = 0: 32768 / (pir_interval+1) Hz,  default 12.5Hz (~80ms) pir_lpf_sel = 1: 32768 / (pir_interval*2+1) Hz,  default 6.25Hz (~160ms)</description>
              <bitRange>[11:0]</bitRange>
