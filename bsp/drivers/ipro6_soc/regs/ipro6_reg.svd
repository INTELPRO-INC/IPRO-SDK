              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ldo18io_sstart_delay</name>
              <description>soft start circuit delay time controlling 0: 200us, 3: 500us, 7: 900us</description>
              <bitRange>[22:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ldo18io_pulldown_sel</name>
              <description>0: pull down by pu_ldo18io; 1: pull down by ldo18io_pulldown</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ldo18io_pulldown</name>
              <description>(worked when ldo18io_pulldown_sel=1) 0: ldo18io output floating, 1: ldo18io output pull down</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ldo18io_ocp_en</name>
              <description>Over Current Protect circuit enable</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ldo18io_ocp_th</name>
