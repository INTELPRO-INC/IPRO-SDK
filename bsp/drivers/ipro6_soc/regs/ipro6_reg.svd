            </field>
          </fields>
        </register>
        <register>
          <name>PDS_INT</name>
          <description>PDS_INT</description>
          <addressOffset>0xC</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x000FFC00</resetValue>
          <resetMask>0x000FFDF0</resetMask>
          <fields>
            <field>
              <name>ro_pds_wakeup_event</name>
              <description>Record Wakeup resason, and be clear by cr_pds_int_clr [30]: wakeup trigger by  wifi_tbtt_wakeup_irq [29] :wakeup trigger by usbh_conn_det_n [28]: wakeup trigger by usbh_wkp_det_n [27]: wakeup trigger by dm_slp_irq  [26]: wakeup trigger by WIFI wakeup event [25]: wakeup trigger by irrx_int [24]: wakeup trigger by pds_gpio_int [23]: wakeup trigger by gpio_irq [22]: wakeup trigger by hbn_irq_out[1:0] [21]: wakeup trigger by pds_sleep_cnt=0</description>
              <bitRange>[30:21]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>cr_pds_wakeup_src_en</name>
              <description>PDS Wakeup Trigger [19]: enable wakeup trigger by  wifi_tbtt_wakeup_irq [18] : enable wakeup trigger by usbh_conn_det_n [17]: enable wakeup trigger by usbh_wkp_det_n [16]: enable wakeup trigger by dm_slp_irq  [15]: enable wakeup trigger by WIFI wakeup event [14]: enable wakeup trigger by irrx_int [13]: enable wakeup trigger by pds_gpio_int [12]: enable wakeup trigger by gpio_irq [11]: enable wakeup trigger by |hbn_irq_out[1:0]  [10]: enable wakeup trigger by pds_sleep_cnt=0</description>
              <bitRange>[19:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_int_clr</name>
              <description>pds interrupt clear</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_wifi_tbtt_wakeup_irq_mask</name>
              <description>Mask wifi_tbtt_wakeup_irq interrupt</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_wifi_tbtt_sleep_irq_mask</name>
              <description>Mask wifi_tbtt_sleep_irq interrupt</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_rf_done_int_mask</name>
              <description>Mask pds rf done interrupt</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_wake_int_mask</name>
              <description>Mask pds wakeup interrupt</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ro_pds_wifi_tbtt_wakeup_irq</name>
              <description>wifi_tbtt_wakeup_irq</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ro_pds_wifi_tbtt_sleep_irq</name>
              <description>wifi_tbtt_sleep_irq</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ro_pds_rf_done_int</name>
              <description>pu_rf_done interrupt</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ro_pds_wake_int</name>
              <description>PDS Wakeup Interrupt</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
