            </field>
            <field>
              <name>ef_sdu_dis</name>
              <description>1:disable sdu</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ef_sf_key_re_sel</name>
              <description>when ef_sf_aes_mode=1 (AES-128) 2'b00:sf_aes_key_0 select key slot 2, sf_aes_key_1 select key slot 3 2'b01:sf_aes_key_0 select key slot 4, sf_aes_key_1 select key slot 5 2'b10:sf_aes_key_0 select key slot 2, sf_aes_key_1 select key slot 2 2'b11:sf_aes_key_0 select key slot 2, sf_aes_key_1 select key slot 3 when ef_sf_aes_mode=2/3 (AES-192/AES-256) 2'b10:sf_aes_key_0 select {ef_key_slot_3,ef_key_slot_2}, sf_aes_key_1 select {ef_key_slot_3,ef_key_slot_2}</description>
              <bitRange>[13:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ef_bus_rmp_dis</name>
              <description>1:disable</description>
              <bitRange>[11:11]</bitRange>
