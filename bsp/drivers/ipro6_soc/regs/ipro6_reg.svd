              <access>read-write</access>
            </field>
            <field>
              <name>fix_cnt</name>
              <description>Only effect when dst_min_mode = 1 Destination transfer cnt = (total src byte cnt - (fix_cnt&lt;&lt;DWidth))&lt;&lt;DWidth</description>
              <bitRange>[25:23]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DWidth</name>
              <description>Destination transfer width:  2'b00 : byte 2'b01 : half-word 2'b10 : word 2'b11 : double-word</description>
              <bitRange>[22:21]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SWidth</name>
