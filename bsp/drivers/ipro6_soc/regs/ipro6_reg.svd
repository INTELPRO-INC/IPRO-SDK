              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pu_rosdac</name>
              <description>1'b1: power up TIA ROSDAC</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
