        <register>
          <name>PDS_RAM2</name>
          <description>PDS_RAM2</description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x000FFC00</resetValue>
          <resetMask>0x3FFFFFFF</resetMask>
          <fields>
            <field>
              <name>cr_pds_wram_pgen</name>
              <description>[9]    : 144~160KB WRAM PGEN [8]    : 128~144KB   WRAM PGEN [7]    : 112~128KB WRAM PGEN [6]    : 96~112KB WRAM PGEN [5]    : 80~96KB WRAM PGEN [4]    : 64~80KB   WRAM PGEN [3]    : 48~64KB WRAM PGEN [2]    : 32~48KB WRAM PGEN [1]    : 16~32KB WRAM PGEN [0]    : 0~16KB   WRAM PGEN</description>
              <bitRange>[29:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cr_pds_wram_ret2</name>
              <description>[9]    : 144~160KB WRAM RET2 [8]    : 128~144KB   WRAM RET2 [7]    : 112~128KB WRAM RET2 [6]    : 96~112KB WRAM RET2 [5]    : 80~96KB WRAM RET2 [4]    : 64~80KB   WRAM RET2 [3]    : 48~64KB WRAM RET2 [2]    : 32~48KB WRAM RET2 [1]    : 16~32KB WRAM RET2 [0]    : 0~16KB   WRAM RET2</description>
              <bitRange>[19:10]</bitRange>
              <access>read-write</access>
            </field>
