          <access>read-write</access>
          <resetValue>0x01000000</resetValue>
          <resetMask>0x01000000</resetMask>
          <fields>
            <field>
              <name>reg_rtc_timer_latch_en</name>
              <description>Enable RTC Timer Latch, need to wait about 15us for 1st timer read, and no need to wait for next read</description>
