              <bitRange>[12:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>gpadc_neg_sel</name>
              <description>select adc negative input in none-scan mode 5‘h0 gpio0 5'h1 gpio1 5'h2 gpio2 5‘h3 gpio3 5'h4 gpio4 5'h5 gpio5 5‘h6 gpio6 5'h7 gpio7 5'h8 gpio8 5‘h9 gpio9 5'h10 gpio10 5'h11 gpio11 5‘h12 daca 5'h13 dacb 5'h14 temp_p 5‘h15 temp_n 5'h16 vref 5'h17 atest 5‘h18 vbat/2 5'h19 vn3_diode 5'h20 vn2_diode 5‘h21 vn1_diode 5'h22 vn0_diode 5'h23~31 avss</description>
              <bitRange>[7:3]</bitRange>
              <access>read-write</access>
            </field>
