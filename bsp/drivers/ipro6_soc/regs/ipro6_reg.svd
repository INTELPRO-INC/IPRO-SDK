          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0001003F</resetMask>
          <fields>
            <field>
              <name>st_spi2dvp_bus_busy</name>
              <description>SPI interface busy indicator</description>
              <bitRange>[31:31]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>st_spi2dvp_fifo_int</name>
              <description>FIFO overrun interrupt, considered ERROR and can be cleared by deasserting rg_spi2dvp_int_en</description>
              <bitRange>[21:21]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>st_spi2dvp_ls_int</name>
              <description>Interrupt asserted when Line Start packet is received, can be cleared by deasserting rg_spi2dvp_int_en</description>
              <bitRange>[20:20]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>st_spi2dvp_fe_int</name>
