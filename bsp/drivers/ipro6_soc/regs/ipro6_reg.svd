            <field>
              <name>adpll_sdm_dither_en_ctrl_hw</name>
              <description />
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>adpll_lms_step</name>
              <description>LMS steady state step, '1' for 2^-11, '2' for 2^-9, '3' for 2^-7, '0' for disable LMS</description>
              <bitRange>[17:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>adpll_sdm_dither_prbs_en</name>
              <description />
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>adpll_pha_dem_en</name>
              <description />
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>adpll_pha_dither_en</name>
              <description />
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>adpll_lms_step_enlarge</name>
              <description>Fast LMS convergence step, '0' for steady_step*2^4, and '1' for 2^5</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>adpll_pha_prbs_sel</name>
              <description />
              <bitRange>[11:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>adpll_lms_q_delay</name>
              <description>choose the delay on the q path of LMS block for delay matching</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>adpll_pha_cancel_en</name>
              <description>enable phase error cancellation</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>adpll_pha_cancel_delay</name>
              <description>choose the delay on the phase cancel data for delay matching</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>adpll_spd</name>
          <description>adpll_spd</description>
          <addressOffset>0x284</addressOffset>
