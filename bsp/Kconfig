# BSP (Board Support Package) Configuration
#
# Hardware platform configuration including SoC selection, board type,
# and RF frontend modules.

menu "Hardware Platform Configuration"

#
# Select Target SoC
#
choice
    prompt "Target SoC"
    default IPRO7
    help
      Select the target System-on-Chip (SoC) for your hardware platform.

config IPRO7
    bool "IPRO7"
    help
      Select this option if your target hardware uses the IPRO7 SoC.

config IPRO6
    bool "IPRO6"
    help
      Select this option if your target hardware uses the IPRO6 SoC.
      IPRO6 uses IPRO7's CPU with IPRO6LE's memory layout.

config IPRO6LE
    bool "IPRO6LE"
    help
      Select this option if your target hardware uses the IPRO6LE SoC.

config IPRO7AI_EVK
    bool "IPRO7AI EVK sub-board (QFN49, PSRAM + AI)"
    select USE_PSRAM
    help
      IPRO7AI EVK sub-board, schematic IPRO7AI_MODULE_SUB_0805.

      Carries a 2.4" 240x320 ST7789P3 SPI display, an SC101IOT DVP camera,
      a TPA2037D1 speaker amplifier off the on-chip DAC, an IM69D129 PDM
      microphone, a micro-SD slot on the SDH controller, and a Li-ion
      charger (RT9527GQW) with the cell on CN4.

      Console UART0 on GPIO20/21. Display on GPIO10/12/14-17. Camera DVP on
      GPIO0-7 with SCCB on GPIO36/37 and MCLK on GPIO41. Speaker DAC on
      GPIO23 with an ACTIVE-HIGH enable on GPIO22. PDM mic on GPIO18/19.
      SD card on GPIO27-34.

      Note: the camera bank (VDDIO1) must be jumpered to 1.8 V on J6
      (PIN1/PIN3), and GPIO41 doubles as the BOOT strap. Firmware cannot
      read battery voltage or charge status on this board - see the header
      for why. Selects USE_PSRAM.

endchoice

config CHIP
    string
    default "IPRO7" if IPRO7
    default "IPRO6" if IPRO6
    default "IPRO6LE" if IPRO6LE

config WIFI_LP_APP_SUPPORT
    bool "Reserve OCRAM slot for the standalone lp_fw (WiFi low-power)"
    depends on IPRO6
    default n
    help
      Reserve the top 32K of OCRAM (0x11048000-0x11050000) for the standalone
      lp_fw Stage-1 image used by the WiFi low-power (DTIM) app flow. When set,
      ram_tcm shrinks from the full 320K to 288K so the lp_fw image has a fixed,
      PDS-retained run slot. Leave disabled for apps that do not stage lp_fw —
      they keep the full 320K of TCM.

config IPRO_WIFI_PS
    bool "WiFi datapath resume across PDS (macsw key RAM / MAC HW re-program)"
    depends on WIFI_LP_APP_SUPPORT
    default n
    help
      Enable the full-firmware WiFi datapath resume path (gates
      -DCFG_IPRO_WIFI_PS_ENABLE in macsw). After a lp_fw WIFI-wake, the full FW
      re-programs the MAC HW (STA context, CCMP keys via the on-chip key RAM,
      MAC/BSSID filters, PHY/channel) from the SW state that survived PDS, so the
      encrypted data path (e.g. ping) recovers. lp_demo snapshots the key RAM +
      channel before PDS (rwnxl_pds_store / rwnxl_configs_restore) and calls
      rwnxl_resume_wifi() after the wake. Requires the WiFi6 STA stack.

