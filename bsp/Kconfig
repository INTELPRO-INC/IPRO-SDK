config CPU_ID
    string "CPU ID"
    default "intelpro_ipro7" if IPRO7
    default "intelpro_ipro7" if IPRO6
    default "m0" if IPRO6LE
    help
      CPU identifier used for toolchain selection.
      - IPRO7: intelpro_ipro7
      - IPRO6: intelpro_ipro7 (uses IPRO7's CPU)
      - IPRO6LE: m0 (RISC-V E906 with Thead extensions)

config CROSS_COMPILE
    string "Cross-compiler prefix"
    default "/opt/toolchain/riscv_ipro7/bin/riscv64-unknown-elf-" if IPRO7
    default "/opt/toolchain/riscv_ipro7/bin/riscv64-unknown-elf-" if IPRO6
    default "/opt/toolchain/toolchain_riscv_thead_linux64/bin/riscv64-unknown-elf-" if IPRO6LE
    help
      Path to the cross-compiler toolchain prefix.

      IPRO7 toolchain:
        - Default: /opt/toolchain/riscv_ipro7/bin/riscv64-unknown-elf-
        - Architecture: RISC-V 64-bit
        - Features: Standard RISC-V extensions

      IPRO6 toolchain (same as IPRO7):
        - Default: /opt/toolchain/riscv_ipro7/bin/riscv64-unknown-elf-
        - Architecture: RISC-V 64-bit (uses IPRO7's CPU)

      IPRO6LE toolchain:
        - Default: /opt/toolchain/toolchain_riscv_thead_linux64/bin/riscv64-unknown-elf-
        - Architecture: RISC-V E906 (RV32IMAFC)
        - Features: Thead custom extensions (P, zpsfoperand, xtheade)

